<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>atos-agent</AssemblyName>
    <RootNamespace>atos.AIFarm.Agent</RootNamespace>
    <!-- O restore da solução precisa trazer os assets win-x64 para o publish
         self-contained com "no-restore" do Dockerfile (NETSDK1047). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\atos.AIFarm.Core\atos.AIFarm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel serve o painel local (modo ui) em 127.0.0.1 com porta
         aleatória; HttpListener exigiria ACL de URL do Windows. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="atos.AIFarm.UnitTests" />
  </ItemGroup>

</Project>
