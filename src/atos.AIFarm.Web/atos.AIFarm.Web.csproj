<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\atos.AIFarm.Core\atos.AIFarm.Core.csproj" />
    <ProjectReference Include="..\atos.AIFarm.Infrastructure\atos.AIFarm.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <Target Name="VerifyBlazorRuntimeAsset" AfterTargets="Publish">
    <Error
      Condition="!Exists('$(PublishDir)wwwroot/_framework/blazor.web.js')"
      Text="The published application is missing wwwroot/_framework/blazor.web.js; interactive server components would not work." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="atos.AIFarm.IntegrationTests" />
  </ItemGroup>

</Project>
