@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWalletService Wallet
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<AuthorizeView Context="auth">
    <Authorized>
        <div class="shell">
            <aside class="sidebar">
                <a class="brand" href="/" aria-label="atos AI Farm - início">atos<span>::AI_FARM</span></a>
                <span class="sidebar-section-label">NAVEGAÇÃO</span>
                <nav class="sidebar-nav" aria-label="Navegação principal">
                    <NavLink href="/" Match="NavLinkMatch.All"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg><span>INÍCIO</span></NavLink>
                    <NavLink href="/chat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z" /></svg><span>CHAT</span></NavLink>
                    <NavLink href="/wallet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h16a2 2 0 0 1 2 2v11H3zM3 6l3-3h12v3m-2 7h5" /></svg><span>WALLET</span></NavLink>
                    <NavLink href="/operations"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9m8 10V4m8 15v-7M2 19h20" /></svg><span>OPS</span></NavLink>
                    <NavLink href="/iris/analytics"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18M5 17l4-5 4 3 6-9M17 6h2v2" /></svg><span>ANÁLISE</span></NavLink>
                    <NavLink href="/iris/budget"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M17 7.5c0-2-2-3-5-3s-5 1.2-5 3 1.7 2.7 5 3.5 5 1.7 5 3.8-2 3.7-5 3.7-5-1.3-5-3.5" /></svg><span>LIMITES</span></NavLink>
                    <NavLink href="/account/api-tokens"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 7a5 5 0 1 0-4 4l2 2h3v3h3v3h3v-4l-7-7m-7-1h.01" /></svg><span>API</span></NavLink>
                    <NavLink href="/audit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 2.8 8 7 10 4.2-2 7-5.5 7-10V6zM9 12l2 2 4-5" /></svg><span>AUDIT</span></NavLink>
                    <NavLink href="/incidents"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20zm0 6v5m0 3v1" /></svg><span>ALERTAS</span></NavLink>
                    <NavLink href="/farm"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM8 3v4m8-4v4M8 12h8m-8 4h5" /></svg><span>FARM</span></NavLink>
                </nav>
                <nav class="sidebar-subnav" aria-label="Recursos da Farm">
                    <NavLink href="/farm/jobs">CENTRO DE JOBS</NavLink>
                    <NavLink href="/farm/demands">DEMANDAS ÚTEIS</NavLink>
                    <NavLink href="/farm/capacity">CAPACIDADE</NavLink>
                    <NavLink href="/farm/schedules">AGENDAMENTOS</NavLink>
                    <NavLink href="/farm/analytics">ANÁLISE FARM</NavLink>
                    <NavLink href="/farm/economy">ECONOMIA</NavLink>
                    <NavLink href="/farm/rewards">RECOMPENSAS</NavLink>
                    <NavLink href="/saldo-farm">SALDO FARM</NavLink>
                </nav>
                <div class="sidebar-spacer"></div>
                <section class="sidebar-balance" aria-label="Saldo disponível">
                    <span>SALDO DISPONÍVEL</span>
                    <strong>@(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableMinor))</strong>
                    <small>CONTA OPERACIONAL</small>
                </section>
                <section class="sidebar-account">
                    <span class="account-dot" aria-hidden="true"></span>
                    <div><strong>@auth.User.Identity?.Name</strong><span>CONTA ATIVA</span></div>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button class="nav-button" type="submit" title="Sair" aria-label="Sair">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5m4-4 4-3-4-3m4 3H9" /></svg>
                        </button>
                    </form>
                </section>
            </aside>
            <section class="workspace">
                <header class="statusbar">
                    <span class="status-path">atos:/@CurrentPath</span>
                    <div class="status-items">
                        <span><i class="online-dot" aria-hidden="true"></i>ONLINE</span>
                        <span>PROVIDER_@(Configuration["AIFarm:AI:Provider"]?.ToUpperInvariant() ?? "FAKE")</span>
                        <UtcClock />
                    </div>
                </header>
                <main class="content">@Body</main>
            </section>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="auth-shell">
            <section class="auth-hero">
                <a class="brand" href="/">atos<span>::AI_FARM</span></a>
                <div>
                    <p class="eyebrow">atos:/ACCESS_GATEWAY</p>
                    <h1>COMPUTE.<br /><span>INTELIGÊNCIA.</span><br />AUTONOMIA.</h1>
                    <p>Infraestrutura técnica para transformar capacidade computacional em acesso auditável à Iris.</p>
                </div>
                <small>SECURE SESSION // TLS ACTIVE</small>
            </section>
            <main class="auth-content">@Body</main>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">RECARREGAR</a>
    <span class="dismiss">×</span>
</div>

@code {
    private WalletSnapshot? _snapshot;

    private string CurrentPath
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            var path = relative.Split('?', '#')[0].Trim('/');
            return string.IsNullOrWhiteSpace(path) ? "HOME" : path.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated is true)
        {
            await Wallet.GrantPromotionalAsync(Aic.FromAic(1_000), "account:promotional-grant:v1");
            await Wallet.ExpireReservationsAsync(TimeProvider.System.GetUtcNow());
            _snapshot = await Wallet.GetSnapshotAsync();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
