@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWalletService Wallet
@inject IConfiguration Configuration

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="atos AI Farm - início">atos<span>::AI_FARM</span></a>
        <nav aria-label="Navegação principal">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/chat">[ CHAT ]</NavLink>
                    <NavLink href="/wallet">[ WALLET ]</NavLink>
                    <NavLink href="/operations">[ OPS ]</NavLink>
                    <NavLink href="/farm">[ FARM ]</NavLink>
                    <NavLink href="/farm/economy">[ ECON ]</NavLink>
                    <NavLink href="/saldo-farm">[ SALDO FARM ]</NavLink>
                    <span class="account-name">@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button class="nav-button" type="submit">[ SAIR ]</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/account/login">[ ENTRAR ]</NavLink>
                    <NavLink href="/account/register">[ CRIAR CONTA ]</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>
    <main>@Body</main>
    <footer>atos:/SYSTEM // PROVIDER_@(Configuration["AIFarm:AI:Provider"]?.ToUpperInvariant() ?? "FAKE")</footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated is true)
        {
            await Wallet.GrantPromotionalAsync(
                Aic.FromAic(1_000),
                "account:promotional-grant:v1");
            await Wallet.ExpireReservationsAsync(TimeProvider.System.GetUtcNow());
        }
    }
}

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">RECARREGAR</a>
    <span class="dismiss">×</span>
</div>
