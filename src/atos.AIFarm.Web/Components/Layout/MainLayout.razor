@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWalletService Wallet
@inject IInterfaceModeService InterfaceMode
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<AuthorizeView Context="auth">
    <Authorized>
        <div class="desk">
            <header class="menubar">
                <a class="brand" href="/" aria-label="AI Farm - início">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16c0-7 4-11 12-12-1 8-5 12-12 12z" /><path d="M4 16l7-7" /></svg>
                    <span>AI Farm</span>
                </a>
                <nav class="menubar-nav" aria-label="Navegação principal">
                    @if (IsLite)
                    {
                        <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
                        <NavLink href="/chat">Conversar</NavLink>
                        <NavLink href="/wallet">Créditos</NavLink>
                        <NavLink href="/biblioteca">Biblioteca</NavLink>
                        <NavLink href="/meu-computador">Meu computador</NavLink>
                        <details class="@(IsSection("account") ? "active" : null)">
                            <summary>Conta ▾</summary>
                            <div>
                                <form method="post" action="/account/interface-mode">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="mode" value="Pro" />
                                    <button class="nav-button" type="submit">Ver modo completo</button>
                                </form>
                                <form method="post" action="/account/logout">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="" />
                                    <button class="nav-button" type="submit">Sair</button>
                                </form>
                            </div>
                        </details>
                    }
                    else
                    {
                        <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
                        <NavLink href="/chat">Chat</NavLink>
                        <NavLink href="/wallet">Créditos</NavLink>
                        <NavLink href="/operations">Uso da IA</NavLink>
                        <details class="@(IsSection("iris") ? "active" : null)">
                            <summary>Iris ▾</summary>
                            <div>
                                <NavLink href="/iris/analytics">Resumo de uso</NavLink>
                                <NavLink href="/iris/budget">Limites de uso</NavLink>
                            </div>
                        </details>
                        <details class="@(IsSection("farm", "saldo-farm", "meu-computador") ? "active" : null)">
                            <summary>Farm ▾</summary>
                            <div>
                                <NavLink href="/farm" Match="NavLinkMatch.All">Compute Lab</NavLink>
                                <NavLink href="/meu-computador">Meu computador</NavLink>
                                <NavLink href="/farm/jobs">Histórico de tarefas</NavLink>
                                <NavLink href="/farm/demands">Enviar trabalho</NavLink>
                                <NavLink href="/biblioteca">Biblioteca</NavLink>
                                <NavLink href="/farm/capacity">Capacidade</NavLink>
                                <NavLink href="/farm/schedules">Agendamentos</NavLink>
                                <hr />
                                <NavLink href="/farm/analytics">Resumo da Farm</NavLink>
                                <NavLink href="/farm/economy">Simulador de ganhos</NavLink>
                                <NavLink href="/farm/rewards">Recompensas</NavLink>
                                <NavLink href="/saldo-farm">Saldo da Farm</NavLink>
                            </div>
                        </details>
                        <details class="@(IsSection("audit", "incidents", "account") ? "active" : null)">
                            <summary>Conta ▾</summary>
                            <div>
                                <NavLink href="/audit">Registro de tudo</NavLink>
                                <NavLink href="/incidents">Alertas</NavLink>
                                <NavLink href="/account/api-tokens">Chaves de acesso</NavLink>
                                <hr />
                                <form method="post" action="/account/interface-mode">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="mode" value="Lite" />
                                    <button class="nav-button" type="submit">Ver modo simples</button>
                                </form>
                                <form method="post" action="/account/logout">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="" />
                                    <button class="nav-button" type="submit">Sair</button>
                                </form>
                            </div>
                        </details>
                    }
                </nav>
                <div class="menubar-right">
                    <span class="status"><span class="status-dot" aria-hidden="true"></span>Online</span>
                    <span class="muted" aria-hidden="true" style="font-size: 11px">//</span>
                    <UtcClock />
                    <span class="muted" aria-hidden="true" style="font-size: 11px">//</span>
                    <span class="menubar-balance" title="Créditos disponíveis"><strong>@(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableMinor))</strong></span>
                    <span class="muted" aria-hidden="true" style="font-size: 11px">//</span>
                    <span class="menubar-account">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="7" r="3.5" /><path d="M3.5 17c1-3.5 3.5-5 6.5-5s5.5 1.5 6.5 5" /></svg>
                        <span title="@auth.User.Identity?.Name">@AccountLabel(auth.User.Identity?.Name)</span>
                    </span>
                </div>
            </header>
            <main class="content">@Body</main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="desk">
            <header class="menubar">
                <a class="brand" href="/" aria-label="AI Farm">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16c0-7 4-11 12-12-1 8-5 12-12 12z" /><path d="M4 16l7-7" /></svg>
                    <span>AI Farm</span>
                </a>
                <div class="menubar-right"><UtcClock /></div>
            </header>
            <div class="auth-shell">
                <section class="win inactive auth-hero-window">
                    <div class="win-title"><span>Sobre a AI Farm</span></div>
                    <div class="auth-hero">
                        <div class="brand">
                            <i><svg viewBox="0 0 20 20" fill="none" stroke="#111111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16c0-7 4-11 12-12-1 8-5 12-12 12z" /><path d="M4 16l7-7" /></svg></i>
                            <span>AI Farm<small>atos</small></span>
                        </div>
                        <h2>Seu computador.<br /><span>Sua inteligência.</span></h2>
                        <p class="thesis">Eu farmo créditos com o computador que já tenho e gasto esses créditos nas ferramentas de IA que realmente quero usar.</p>
                        <div class="auth-facts">
                            <div><span class="label">Créditos (AIC)</span><span>Extrato permanente, nada muda sozinho</span></div>
                            <div><span class="label">Pontos (CP)</span><span>Trabalho do computador, conferido um a um</span></div>
                            <div><span class="label">Comprovantes</span><span>Cada tarefa deixa prova assinada</span></div>
                        </div>
                    </div>
                </section>
                <main class="auth-content">@Body</main>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>

@code {
    private WalletSnapshot? _snapshot;
    private AIFarmInterfaceMode _mode = AIFarmInterfaceMode.Pro;

    private bool IsLite => _mode == AIFarmInterfaceMode.Lite;

    private string ProviderName =>
        Configuration["AIFarm:AI:Provider"] is { Length: > 0 } provider
            ? provider.Equals("OpenAICompatible", StringComparison.OrdinalIgnoreCase)
                ? Configuration["AIFarm:AI:Compatible:ProviderLabel"] ?? "OpenRouter"
                : char.ToUpperInvariant(provider[0]) + provider[1..].ToLowerInvariant()
            : "Fake";

    private string CurrentPath =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    private bool IsSection(params string[] prefixes)
    {
        var path = CurrentPath;
        foreach (var prefix in prefixes)
        {
            if (path.Equals(prefix, StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string AccountLabel(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "conta";
        var at = name.IndexOf('@');
        return at > 0 ? name[..at] : name;
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated is true)
        {
            await Wallet.GrantPromotionalAsync(Aic.FromAic(1_000), "account:promotional-grant:v1");
            await Wallet.ExpireReservationsAsync(TimeProvider.System.GetUtcNow());
            _snapshot = await Wallet.GetSnapshotAsync();
            _mode = await InterfaceMode.GetAsync();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
