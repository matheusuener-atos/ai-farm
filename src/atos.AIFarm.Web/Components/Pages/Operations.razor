@page "/operations"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAiUsageQuery Usage

<PageTitle>Uso da IA // atos AI Farm</PageTitle>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_dashboard is null)
{
    <p class="muted">Carregando…</p>
}
else
{
    <div class="kpi-grid cols-5">
        <section class="kpi kpi-purple">
            <span>Respostas</span>
            <strong>@_dashboard.Totals.ExecutionCount</strong>
            <small>em @_dashboard.Totals.ConversationCount conversa(s)</small>
        </section>
        <section class="kpi">
            <span>Texto processado</span>
            <strong>@((_dashboard.Totals.InputUnits + _dashboard.Totals.OutputUnits).ToString("N0"))</strong>
            <small>@_dashboard.Totals.InputUnits.ToString("N0") enviado · @_dashboard.Totals.OutputUnits.ToString("N0") recebido</small>
        </section>
        <section class="kpi kpi-amber">
            <span>Custo real</span>
            <strong>@Aic.Format(_dashboard.Totals.ActualCostMinor)</strong>
            <small>estimado antes: @Aic.Format(_dashboard.Totals.EstimatedCostMinor)</small>
        </section>
        <section class="kpi kpi-green">
            <span>Devolvido ao saldo</span>
            <strong>@Aic.Format(_dashboard.Totals.ReleasedCostMinor)</strong>
            <small>estimativa que não foi usada</small>
        </section>
        <section class="kpi kpi-purple">
            <span>Satisfação</span>
            <strong>@(_dashboard.Totals.SatisfactionPercent is decimal satisfaction ? $"{satisfaction:0.0}%" : "---")</strong>
            <small>@_dashboard.Totals.PositiveFeedbackCount úteis · @_dashboard.Totals.NegativeFeedbackCount não úteis</small>
        </section>
    </div>

    <section class="panel ledger operations-ledger">
        <div class="panel-head">
            <h2>Respostas recentes</h2>
        </div>

        <div class="filters operations-filters">
            <label>
                Buscar
                <input type="search" @bind="_search" @bind:event="oninput" placeholder="conversa, modelo ou código" />
            </label>
            <label>
                Serviço de IA
                <select @bind="_provider">
                    <option value="">Todos</option>
                    @foreach (var provider in Providers)
                    {
                        <option value="@provider">@provider</option>
                    }
                </select>
            </label>
        </div>

        @if (FilteredExecutions.Count == 0)
        {
            <div class="terminal empty-operations">
                <p>Nenhuma resposta encontrada.</p>
                <a class="text-link" href="/chat">Iniciar conversa</a>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="operations-table">
                    <thead>
                        <tr>
                            <th>Quando (UTC)</th>
                            <th>Conversa</th>
                            <th>Serviço / modelo</th>
                            <th>Texto</th>
                            <th>Estimado</th>
                            <th>Real</th>
                            <th>Tempo</th>
                            <th>Código</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var execution in FilteredExecutions)
                        {
                            <tr>
                                <td>@execution.StartedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <a href="@($"/chat/{execution.ConversationId}")">
                                        @(execution.ConversationTitle ?? "Conversa sem título")
                                    </a>
                                </td>
                                <td><span class="purple">@execution.Provider</span><br /><small>@execution.Model · catálogo @execution.PriceCatalogVersion</small></td>
                                <td>@execution.InputUnits.ToString("N0") enviado<br />@execution.OutputUnits.ToString("N0") recebido</td>
                                <td>@Aic.Format(execution.EstimatedCostMinor)</td>
                                <td class="amber">@Aic.Format(execution.ActualCostMinor)</td>
                                <td>@FormatDuration(execution)</td>
                                <td><code>@execution.OperationId.ToString()[..8]</code><br /><small class="@StatusClass(execution.Status)">@StatusLabel(execution.Status)</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <footer class="home-ledger-foot" style="border-top: 1.5px solid #111111">
            <span class="muted">Até 50 respostas · os textos das conversas não aparecem aqui.</span>
            <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Atualizando..." : "Atualizar")
            </button>
        </footer>
    </section>
}

@code {
    private AiUsageDashboard? _dashboard;
    private string? _error;
    private string _search = string.Empty;
    private string _provider = string.Empty;
    private bool _loading;

    private IReadOnlyList<string> Providers => _dashboard?.RecentExecutions
        .Select(x => x.Provider)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToArray() ?? [];

    private IReadOnlyList<AiExecutionSummary> FilteredExecutions =>
        _dashboard?.RecentExecutions
            .Where(x => string.IsNullOrWhiteSpace(_provider) ||
                x.Provider.Equals(_provider, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrWhiteSpace(_search) || Matches(x, _search.Trim()))
            .ToArray() ?? [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _dashboard = await Usage.GetDashboardAsync();
        }
        catch (Exception)
        {
            _error = "Não foi possível carregar o uso da IA.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool Matches(AiExecutionSummary execution, string search) =>
        (execution.ConversationTitle?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
        execution.Provider.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        execution.Model.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        execution.OperationId.ToString().Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string FormatDuration(AiExecutionSummary execution)
    {
        if (execution.FinishedAtUtc is null)
        {
            return "EM CURSO";
        }

        var elapsed = execution.FinishedAtUtc.Value - execution.StartedAtUtc;
        return elapsed.TotalSeconds < 1
            ? $"{elapsed.TotalMilliseconds:N0} ms"
            : $"{elapsed.TotalSeconds:N2} s";
    }

    private static string StatusClass(string status) =>
        status == "Completed" ? "green" : "amber";

    private static string StatusLabel(string status) => status switch
    {
        "Completed" => "CONCLUÍDA",
        "Running" => "EM CURSO",
        "Failed" => "FALHOU",
        "Cancelled" => "CANCELADA",
        "TimedOut" => "TEMPO ESGOTADO",
        _ => status.ToUpperInvariant()
    };
}
