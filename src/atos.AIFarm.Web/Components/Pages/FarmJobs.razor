@page "/farm/jobs"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmJobHistoryService History

<PageTitle>Histórico de tarefas // atos AI Farm</PageTitle>

<section class="panel jobs-filters">
    <div class="panel-head"><h2>Filtros</h2></div>
    <div class="jobs-filter-grid">
        <label>Buscar
            <input @bind="_search" maxlength="120" placeholder="tipo de tarefa, versão ou código" />
        </label>
        <label>Tipo de tarefa
            <select @bind="_workloadId">
                <option value="">Todos</option>
                @foreach (var workload in FarmWorkloadCatalog.Definitions)
                {
                    <option value="@workload.Id">@workload.DisplayName</option>
                }
            </select>
        </label>
        <label>Situação
            <select @bind="_status">
                <option value="">Todas</option>
                @foreach (var status in Enum.GetValues<FarmJobStatus>())
                {
                    <option value="@status">@StatusLabel(status)</option>
                }
            </select>
        </label>
        <label>Origem
            <select @bind="_origin">
                <option value="">Todas</option>
                <option value="Interactive">Painel</option>
                <option value="PersonalApi">Chave de acesso (API)</option>
                <option value="Scheduled">Agendamento</option>
                <option value="Demand">Fila de trabalho</option>
            </select>
        </label>
        <label>De (UTC)<input type="date" @bind="_fromDate" /></label>
        <label>Até (UTC)<input type="date" @bind="_toDate" /></label>
        <div style="display: flex; gap: 8px; align-items: center; grid-column: 1 / -1">
            <label class="jobs-check" style="margin-right: auto"><input type="checkbox" @bind="_integrityFailuresOnly" /> Só comprovantes com problema</label>
            <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="ResetAsync" disabled="@_loading">Limpar</button>
            <button type="button" @onclick="ApplyAsync" disabled="@_loading">@(_loading ? "Consultando..." : "Aplicar filtros")</button>
        </div>
    </div>
</section>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_result is null)
{
    <p class="muted">Consultando tarefas…</p>
}
else
{
    <div class="jobs-kpis">
        <section class="kpi"><span>Resultados</span><strong>@_result.Totals.Total</strong><small>@_result.Totals.Active em andamento</small></section>
        <section class="kpi kpi-green"><span>Conferidas</span><strong>@_result.Totals.Completed</strong><small>@FormatCp(_result.Totals.VerifiedProcessingPointsMilli) no total</small></section>
        <section class="kpi kpi-amber"><span>Falhas</span><strong>@_result.Totals.Failed</strong><small>não valeram pontos</small></section>
        <section class="kpi @(_result.Totals.IntegrityFailures == 0 ? "kpi-green" : "kpi-amber")"><span>Comprovantes com problema</span><strong>@_result.Totals.IntegrityFailures</strong><small>@(_result.Totals.IntegrityFailures == 0 ? "nenhuma divergência" : "verifique os detalhes")</small></section>
    </div>

    <section class="panel jobs-results">
        <div class="panel-head"><h2>Tarefas · página @_result.Page de @_result.TotalPages</h2></div>
        @if (_result.IsScanTruncated)
        {
            <p class="jobs-warning">Resultado cortado — refine os filtros.</p>
        }
        @if (_result.Items.Count == 0)
        {
            <p class="jobs-empty muted">Nenhuma tarefa corresponde aos filtros.</p>
        }
        @foreach (var item in _result.Items)
        {
            var job = item.Job;
            <article class="job-row">
                <header>
                    <div><strong>@job.Workload</strong><small>@job.WorkloadVersion · @Short(job.Id)</small></div>
                    <div class="job-badges">
                        <span>@OriginLabel(item.Origin)</span>
                        <span class="@StatusClass(job.Status)">@StatusLabel(job.Status)</span>
                    </div>
                </header>
                <dl>
                    <div><dt>Criada (UTC)</dt><dd>@job.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</dd></div>
                    <div><dt>Pontos</dt><dd>@FormatCp(job.Evidence?.IsValid == true ? job.ComputeUnitsMilli : 0)</dd></div>
                    <div><dt>Duração</dt><dd>@(job.DurationMilliseconds is null ? "—" : $"{job.DurationMilliseconds:N0} MS")</dd></div>
                    <div><dt>Comprovante</dt><dd class="@EvidenceClass(job)">@EvidenceLabel(job)</dd></div>
                </dl>
                <details>
                    <summary>Ver detalhes e etapas</summary>
                    <div class="job-detail">
                        <dl>
                            <div><dt>Código da tarefa</dt><dd>@job.Id</dd></div>
                            <div><dt>Máquina</dt><dd>@job.NodeId</dd></div>
                            <div><dt>Conferência</dt><dd>@job.VerificationPolicy</dd></div>
                            <div><dt>Resultado</dt><dd>@(job.ResultDigest ?? "—")</dd></div>
                        </dl>
                        @if (job.Evidence is not null)
                        {
                            <div class="job-verification">
                                <span class="@CheckClass(job.Evidence.Verification.SignatureValid)">ASSINATURA @CheckLabel(job.Evidence.Verification.SignatureValid)</span>
                                <span class="@CheckClass(job.Evidence.Verification.ManifestValid)">CONTRATO @CheckLabel(job.Evidence.Verification.ManifestValid)</span>
                                <span class="@CheckClass(job.Evidence.Verification.JobBindingValid)">TAREFA @CheckLabel(job.Evidence.Verification.JobBindingValid)</span>
                                <span class="@CheckClass(job.Evidence.Verification.LifecycleValid)">ETAPAS @CheckLabel(job.Evidence.Verification.LifecycleValid)</span>
                                @if (job.Evidence.IsValid)
                                {
                                    <a href="@EvidenceUrl(job.Id)" download="@EvidenceFile(job.Id)">Baixar comprovante</a>
                                }
                            </div>
                        }
                        <ol>
                            @foreach (var entry in job.Events)
                            {
                                <li><time>@entry.OccurredAtUtc.ToString("HH:mm:ss")</time><strong>@StatusLabel(entry.Status)</strong><span>@entry.Detail</span></li>
                            }
                        </ol>
                    </div>
                </details>
            </article>
        }
        <footer class="jobs-pagination">
            <button type="button" class="button-secondary" @onclick="PreviousAsync" disabled="@(_loading || !_result.HasPreviousPage)">← Anterior</button>
            <span>Página @_result.Page de @_result.TotalPages</span>
            <button type="button" class="button-secondary" @onclick="NextAsync" disabled="@(_loading || !_result.HasNextPage)">Próxima →</button>
            <a class="button-secondary jobs-export" href="@ExportUrl" style="margin-left: auto; box-shadow: 2px 2px 0 #111111">Exportar JSON</a>
        </footer>
    </section>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }

    private FarmJobHistoryPage? _result;
    private string _search = string.Empty;
    private string _workloadId = string.Empty;
    private string _status = string.Empty;
    private string _origin = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _integrityFailuresOnly;
    private bool _loading;
    private int _page = 1;
    private string? _error;

    protected override Task OnInitializedAsync()
    {
        if (JobId is Guid jobId) _search = jobId.ToString();
        return LoadAsync();
    }
    private async Task ApplyAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { if (_result?.HasNextPage == true) { _page++; await LoadAsync(); } }
    private async Task ResetAsync()
    {
        _search = _workloadId = _status = _origin = string.Empty;
        _fromDate = _toDate = null;
        _integrityFailuresOnly = false;
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _result = await History.SearchAsync(Query()); }
        catch (ArgumentException exception) { _error = exception.Message; }
        catch (Exception) { _error = "Não foi possível consultar o histórico da Farm."; }
        finally { _loading = false; }
    }

    private FarmJobHistoryQuery Query() => new(
        _search,
        _workloadId,
        ParseEnum<FarmJobStatus>(_status),
        ParseEnum<FarmJobOrigin>(_origin),
        _integrityFailuresOnly,
        ParseDate(_fromDate, false),
        ParseDate(_toDate, true),
        _page,
        20);

    private string ExportUrl
    {
        get
        {
            var values = new List<string>();
            Add(values, "search", _search);
            Add(values, "workloadId", _workloadId);
            Add(values, "status", _status);
            Add(values, "origin", _origin);
            Add(values, "fromUtc", ParseDate(_fromDate, false)?.ToString("O"));
            Add(values, "toUtc", ParseDate(_toDate, true)?.ToString("O"));
            if (_integrityFailuresOnly) values.Add("integrityFailuresOnly=true");
            return values.Count == 0 ? "/api/farm/jobs/export" : $"/api/farm/jobs/export?{string.Join('&', values)}";
        }
    }

    private static void Add(List<string> values, string name, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            values.Add($"{name}={Uri.EscapeDataString(value)}");
    }
    private static T? ParseEnum<T>(string value) where T : struct, Enum =>
        Enum.TryParse<T>(value, out var parsed) ? parsed : null;
    private static DateTimeOffset? ParseDate(DateTime? value, bool endOfDay) =>
        value is null
            ? null
            : new DateTimeOffset(DateTime.SpecifyKind(value.Value.Date, DateTimeKind.Utc))
                .AddDays(endOfDay ? 1 : 0).AddTicks(endOfDay ? -1 : 0);
    private static string FormatCp(long milli) => $"{milli / 1_000m:N3} CP";
    private static string Short(Guid id) => id.ToString("N")[..8];
    private static string OriginLabel(FarmJobOrigin origin) => origin switch
    {
        FarmJobOrigin.PersonalApi => "CHAVE DE ACESSO",
        FarmJobOrigin.Scheduled => "AGENDAMENTO",
        FarmJobOrigin.Demand => "FILA DE TRABALHO",
        _ => "PAINEL"
    };
    private static string StatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Queued => "NA FILA",
        FarmJobStatus.Offered => "OFERECIDA",
        FarmJobStatus.Accepted => "ACEITA",
        FarmJobStatus.Running => "EXECUTANDO",
        FarmJobStatus.Uploading => "ENVIANDO",
        FarmJobStatus.Verifying => "VERIFICANDO",
        FarmJobStatus.Completed => "CONCLUÍDA",
        FarmJobStatus.Failed => "FALHOU",
        FarmJobStatus.Cancelled => "CANCELADA",
        FarmJobStatus.TimedOut => "TEMPO ESGOTADO",
        FarmJobStatus.Rejected => "REJEITADA",
        _ => status.ToString().ToUpperInvariant()
    };
    private static string StatusClass(FarmJobStatus status) => status == FarmJobStatus.Completed ? "green" : status is FarmJobStatus.Failed or FarmJobStatus.Cancelled or FarmJobStatus.TimedOut or FarmJobStatus.Rejected ? "error-text" : "amber";
    private static string EvidenceLabel(FarmJobSnapshot job) => job.Evidence is null ? "SEM COMPROVANTE" : job.Evidence.IsValid ? "CONFERE" : "COM PROBLEMA";
    private static string EvidenceClass(FarmJobSnapshot job) => job.Evidence?.IsValid == true ? "green" : job.Evidence is null ? "muted" : "error-text";
    private static string CheckLabel(bool valid) => valid ? "OK" : "FALHA";
    private static string CheckClass(bool valid) => valid ? "green" : "error-text";
    private static string EvidenceUrl(Guid id) => $"/api/farm/jobs/{id}/evidence";
    private static string EvidenceFile(Guid id) => $"atos-farm-evidence-{id:N}.json";
}
