@page "/chat"
@page "/chat/{ConversationId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ChatWorkflow Workflow
@inject IChatStore ChatStore
@inject IWalletService Wallet
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Chat // atos AI Farm</PageTitle>

<div class="page-heading">
    <p class="eyebrow">atos:/USAR/CHAT</p>
    <h1>CONVERSAR</h1>
    <p>ROTA // MELHOR DISPONÍVEL</p>
</div>

<div class="chat-workspace">
    <aside class="conversation-panel" aria-label="Histórico de conversas">
        <div class="conversation-panel-header">
            <span>CONVERSAS</span>
            <button type="button" @onclick="CreateConversationAsync" disabled="@_working">[ NOVA ]</button>
        </div>
        <div class="conversation-list">
            @foreach (var conversation in _conversations)
            {
                <button type="button"
                        class="@ConversationClass(conversation.Id)"
                        @onclick="() => SelectConversation(conversation.Id)"
                        disabled="@_working">
                    <strong>@ConversationLabel(conversation)</strong>
                    <span>@ConversationPreview(conversation)</span>
                    <small>@conversation.UpdatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm") // @conversation.MessageCount MSG</small>
                </button>
            }
        </div>
        <button type="button"
                class="archive-toggle"
                @onclick="ToggleArchivedAsync"
                disabled="@_working">
            @(_showArchived ? "[ OCULTAR ARQUIVADAS ]" : "[ VER ARQUIVADAS ]")
        </button>
        @if (_showArchived)
        {
            <div class="archived-list" aria-label="Conversas arquivadas">
                @if (_archivedConversations.Count == 0)
                {
                    <p class="muted">NENHUMA CONVERSA ARQUIVADA</p>
                }
                @foreach (var conversation in _archivedConversations)
                {
                    <article class="archived-item">
                        <strong>@ConversationLabel(conversation)</strong>
                        <span>@ConversationPreview(conversation)</span>
                        <small>@conversation.MessageCount MSG</small>
                        <button type="button"
                                @onclick="() => RestoreConversationAsync(conversation.Id)"
                                disabled="@_working">
                            [ RESTAURAR ]
                        </button>
                    </article>
                }
            </div>
        }
    </aside>

    <section class="terminal chat-terminal" aria-label="Conversa com IA">
    <div class="terminal-title">
        @if (_renaming)
        {
            <div class="title-editor">
                <input aria-label="Título da conversa"
                       maxlength="@ConversationTitle.MaximumLength"
                       @bind="_titleDraft" />
                <button type="button" @onclick="SaveTitleAsync" disabled="@_working">
                    [ SALVAR ]
                </button>
                <button type="button" class="button-secondary" @onclick="CancelRename" disabled="@_working">
                    [ CANCELAR ]
                </button>
            </div>
        }
        else
        {
            <span>[ @CurrentConversationLabel ]</span>
        }
        <div class="terminal-actions">
            <span class="@(_streaming ? "status streaming-status" : "status")">
                ● @(_streaming ? _executionStatus : "ONLINE")
            </span>
            @if (!_renaming)
            {
                <button type="button"
                        class="rename-button"
                        @onclick="StartRename"
                        disabled="@(_working || _conversationId == Guid.Empty)">
                    [ RENOMEAR ]
                </button>
            }
            <button type="button"
                    class="archive-button"
                    @onclick="ArchiveCurrentConversationAsync"
                    disabled="@(_working || _conversationId == Guid.Empty)">
                [ ARQUIVAR ]
            </button>
        </div>
    </div>

    @if (_messages.Count == 0)
    {
        <div class="empty-state">
            <span class="purple">atos_AI&gt;</span>
            <p>Envie uma mensagem para executar o ciclo completo de reserva e liquidação.</p>
            <p class="muted">ESTIMATIVA: 20 AIC // CUSTO FAKE: 12 AIC // DIFERENÇA LIBERADA: 8 AIC</p>
        </div>
    }

    @foreach (var message in _messages)
    {
        <article class="message">
            <span class="@(message.Role == ChatMessageRole.User ? "amber" : "purple")">@RoleLabel(message.Role)&gt;</span>
            <p>@message.Content</p>
            @if (MessageMeta(message) is string meta)
            {
                <small>@meta</small>
            }
        </article>
    }

    @if (_streaming)
    {
        <article class="message streaming-message" aria-live="polite" aria-label="Resposta em geração">
            <span class="purple">atos_AI&gt;</span>
            <p>@(_streamingResponse.Length == 0 ? "AGUARDANDO PRIMEIRO TOKEN" : _streamingResponse.ToString())<span class="stream-cursor" aria-hidden="true"></span></p>
            <small>@_executionStatus // @_pendingPlan?.Route.Provider // @_pendingPlan?.Route.Model</small>
        </article>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="error" role="alert">[ ERRO ] @_error</p>
    }

    <div class="composer">
        <label for="prompt">MENSAGEM</label>
        <textarea id="prompt" @bind="_prompt" disabled="@(_working || _pendingPlan is not null)" placeholder="Digite sua tarefa..." rows="3"></textarea>

        @if (_pendingPlan is not null)
        {
            <section class="execution-plan" aria-live="polite" aria-label="Confirmação da execução">
                <div class="execution-plan-header">
                    <span class="amber">[ PRÉVIA DA EXECUÇÃO ]</span>
                    <span>CATÁLOGO // @_pendingPlan.Route.PriceCatalogVersion</span>
                </div>
                <dl>
                    <div>
                        <dt>ROTA</dt>
                        <dd>@_pendingPlan.Route.Provider / @_pendingPlan.Route.Model</dd>
                    </div>
                    <div>
                        <dt>LIMITE DESTA TAREFA</dt>
                        <dd>@Aic.Format(_pendingPlan.MaximumCostMinor)</dd>
                    </div>
                    <div>
                        <dt>SALDO APÓS RESERVA</dt>
                        <dd>@ProjectedBalance</dd>
                    </div>
                </dl>
                @if (!CanAffordPendingPlan)
                {
                    <p class="plan-warning">[ SALDO INSUFICIENTE ] A execução não pode ser confirmada.</p>
                }
            </section>
        }

        <div class="composer-footer">
            <span>DISPONÍVEL // @(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableMinor))</span>
            <div class="composer-actions">
                @if (_streaming)
                {
                    <button type="button"
                            class="cancel-generation"
                            @onclick="CancelExecution"
                            disabled="@(_executionCancellation?.IsCancellationRequested ?? true)">
                        @((_executionCancellation?.IsCancellationRequested ?? false)
                            ? "[ INTERROMPENDO... ]"
                            : "[ INTERROMPER ]")
                    </button>
                }
                else if (_pendingPlan is null)
                {
                    <button type="button" @onclick="PrepareAsync" disabled="@_working">
                        @(_working ? "[ CALCULANDO... ]" : "[ CALCULAR CUSTO ]")
                    </button>
                }
                else
                {
                    <button type="button" class="button-secondary" @onclick="CancelPlan" disabled="@_working">
                        [ ALTERAR ]
                    </button>
                    <button type="button" @onclick="ConfirmAsync" disabled="@(_working || !CanAffordPendingPlan)">
                        @(_working ? "[ EXECUTANDO... ]" : $"[ CONFIRMAR {Aic.Format(_pendingPlan.MaximumCostMinor)} ]")
                    </button>
                }
            </div>
        </div>
    </div>
    </section>
</div>

@code {
    [Parameter]
    public Guid? ConversationId { get; set; }

    private readonly List<ChatMessageSnapshot> _messages = [];
    private readonly List<ConversationSummary> _conversations = [];
    private readonly List<ConversationSummary> _archivedConversations = [];
    private Guid _conversationId;
    private string _prompt = string.Empty;
    private string _titleDraft = string.Empty;
    private string? _error;
    private bool _working;
    private bool _showArchived;
    private bool _renaming;
    private bool _streaming;
    private string _executionStatus = "CONECTANDO";
    private readonly System.Text.StringBuilder _streamingResponse = new();
    private CancellationTokenSource? _executionCancellation;
    private WalletSnapshot? _snapshot;
    private ChatExecutionPlan? _pendingPlan;

    private string SessionCode => _conversationId == Guid.Empty
        ? "----"
        : _conversationId.ToString("N")[..4].ToUpperInvariant();

    private string CurrentConversationLabel
    {
        get
        {
            var conversation = _conversations.FirstOrDefault(
                x => x.Id == _conversationId);
            return conversation is null
                ? $"SESSÃO_{SessionCode}"
                : ConversationLabel(conversation);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshConversationAsync();
        await RefreshWalletAsync();
    }

    private bool CanAffordPendingPlan =>
        _pendingPlan is not null &&
        _snapshot is not null &&
        _snapshot.Balance.AvailableMinor >= _pendingPlan.MaximumCostMinor;

    private string ProjectedBalance => _pendingPlan is null || _snapshot is null
        ? "---"
        : Aic.Format(Math.Max(
            0,
            _snapshot.Balance.AvailableMinor - _pendingPlan.MaximumCostMinor));

    private async Task PrepareAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || _working)
        {
            return;
        }

        _working = true;
        _error = null;

        try
        {
            await RefreshWalletAsync();
            _pendingPlan = await Workflow.PrepareAsync(_prompt);
            _prompt = _pendingPlan.Prompt;
        }
        catch (Exception)
        {
            _pendingPlan = null;
            _error = "Não foi possível calcular rota e custo. Tente novamente.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_pendingPlan is not { } plan || _working || !CanAffordPendingPlan)
        {
            return;
        }

        _working = true;
        _streaming = true;
        _executionStatus = "CONECTANDO";
        _streamingResponse.Clear();
        var executionCancellation = new CancellationTokenSource();
        _executionCancellation = executionCancellation;
        _error = null;
        _messages.Add(new ChatMessageSnapshot(
            Guid.NewGuid(),
            ChatMessageRole.User,
            plan.Prompt,
            ChatMessageStatus.Completed,
            Guid.Empty,
            DateTimeOffset.UtcNow));

        try
        {
            await Workflow.SendStreamingAsync(
                _conversationId,
                plan,
                Guid.NewGuid().ToString("N"),
                AppendDeltaAsync,
                executionCancellation.Token);
            await RefreshConversationAsync();
            _prompt = string.Empty;
            _pendingPlan = null;
        }
        catch (InsufficientBalanceException exception)
        {
            _error = exception.Message;
            await RefreshConversationAsync();
        }
        catch (OperationCanceledException) when (
            executionCancellation.IsCancellationRequested)
        {
            _error = "Geração interrompida. A reserva foi liberada e nenhum custo foi capturado.";
            await RefreshConversationAsync();
        }
        catch (Exception)
        {
            _error = "A execução falhou. A reserva foi liberada e nenhum custo foi capturado.";
            await RefreshConversationAsync();
        }
        finally
        {
            await RefreshWalletAsync();
            executionCancellation.Dispose();
            _executionCancellation = null;
            _streaming = false;
            _streamingResponse.Clear();
            _executionStatus = "CONECTANDO";
            _working = false;
        }
    }

    private async ValueTask AppendDeltaAsync(
        string delta,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        _streamingResponse.Append(delta);
        _executionStatus = "GERANDO";
        await InvokeAsync(StateHasChanged);
    }

    private void CancelExecution()
    {
        if (!_streaming || _executionCancellation is null)
        {
            return;
        }

        _executionStatus = "INTERROMPENDO";
        _executionCancellation.Cancel();
    }

    private void CancelPlan()
    {
        if (_working)
        {
            return;
        }

        _pendingPlan = null;
        _error = null;
    }

    private async Task RefreshWalletAsync() =>
        _snapshot = await Wallet.GetSnapshotAsync();

    private async Task RefreshConversationAsync()
    {
        ConversationSnapshot? conversation;
        if (ConversationId is Guid requestedId)
        {
            conversation = await ChatStore.GetConversationAsync(requestedId);
            if (conversation is null)
            {
                _error = "A conversa solicitada não foi encontrada.";
                Navigation.NavigateTo("/chat", replace: true);
                return;
            }
        }
        else
        {
            conversation = await ChatStore.GetOrCreateCurrentConversationAsync();
        }

        _conversationId = conversation.Id;
        _renaming = false;
        _messages.Clear();
        _messages.AddRange(conversation.Messages);
        await RefreshConversationsAsync();

        if (ConversationId is null)
        {
            Navigation.NavigateTo($"/chat/{conversation.Id}", replace: true);
        }
    }

    private async Task RefreshConversationsAsync()
    {
        _conversations.Clear();
        _conversations.AddRange(await ChatStore.ListConversationsAsync());
        if (_showArchived)
        {
            _archivedConversations.Clear();
            _archivedConversations.AddRange(
                await ChatStore.ListArchivedConversationsAsync());
        }
    }

    private async Task ToggleArchivedAsync()
    {
        if (_working)
        {
            return;
        }

        _showArchived = !_showArchived;
        _archivedConversations.Clear();
        if (_showArchived)
        {
            _archivedConversations.AddRange(
                await ChatStore.ListArchivedConversationsAsync());
        }
    }

    private async Task CreateConversationAsync()
    {
        if (_working)
        {
            return;
        }

        _working = true;
        _error = null;
        _pendingPlan = null;
        try
        {
            var conversation = await ChatStore.CreateConversationAsync();
            Navigation.NavigateTo($"/chat/{conversation.Id}");
        }
        catch (Exception)
        {
            _error = "Não foi possível criar uma nova conversa.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ArchiveCurrentConversationAsync()
    {
        if (_working || _conversationId == Guid.Empty)
        {
            return;
        }

        _working = true;
        _renaming = false;
        _error = null;
        _pendingPlan = null;
        try
        {
            if (!await ChatStore.ArchiveConversationAsync(_conversationId))
            {
                _error = "Não foi possível arquivar esta conversa.";
                return;
            }

            var nextConversation = await ChatStore.GetOrCreateCurrentConversationAsync();
            Navigation.NavigateTo($"/chat/{nextConversation.Id}", replace: true);
        }
        catch (Exception)
        {
            _error = "Não foi possível arquivar esta conversa.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task RestoreConversationAsync(Guid conversationId)
    {
        if (_working)
        {
            return;
        }

        _working = true;
        _error = null;
        try
        {
            if (!await ChatStore.RestoreConversationAsync(conversationId))
            {
                _error = "Não foi possível restaurar esta conversa.";
                return;
            }

            Navigation.NavigateTo($"/chat/{conversationId}");
        }
        catch (Exception)
        {
            _error = "Não foi possível restaurar esta conversa.";
        }
        finally
        {
            _working = false;
        }
    }

    private void StartRename()
    {
        if (_working || _conversationId == Guid.Empty)
        {
            return;
        }

        var conversation = _conversations.FirstOrDefault(
            x => x.Id == _conversationId);
        _titleDraft = conversation?.Title ?? string.Empty;
        _renaming = true;
        _error = null;
    }

    private void CancelRename()
    {
        _renaming = false;
        _titleDraft = string.Empty;
        _error = null;
    }

    private async Task SaveTitleAsync()
    {
        if (_working || !_renaming)
        {
            return;
        }

        _working = true;
        _error = null;
        try
        {
            if (!await ChatStore.RenameConversationAsync(
                    _conversationId,
                    _titleDraft))
            {
                _error = "Não foi possível renomear esta conversa.";
                return;
            }

            await RefreshConversationsAsync();
            _renaming = false;
            _titleDraft = string.Empty;
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Não foi possível renomear esta conversa.";
        }
        finally
        {
            _working = false;
        }
    }

    private void SelectConversation(Guid conversationId)
    {
        if (!_working && conversationId != _conversationId)
        {
            _pendingPlan = null;
            _error = null;
            Navigation.NavigateTo($"/chat/{conversationId}");
        }
    }

    private string ConversationClass(Guid conversationId) =>
        conversationId == _conversationId ? "conversation-item active" : "conversation-item";

    private static string ConversationLabel(ConversationSummary conversation) =>
        string.IsNullOrWhiteSpace(conversation.Title)
            ? $"SESSÃO_{conversation.Id.ToString("N")[..4].ToUpperInvariant()}"
            : conversation.Title;

    private static string ConversationPreview(ConversationSummary conversation)
    {
        const int maximumLength = 54;
        var preview = string.IsNullOrWhiteSpace(conversation.Preview)
            ? "Nova conversa"
            : conversation.Preview.Trim();
        return preview.Length <= maximumLength
            ? preview
            : $"{preview[..maximumLength]}…";
    }

    private static string RoleLabel(ChatMessageRole role) =>
        role == ChatMessageRole.User ? "VOCÊ" : "atos_AI";

    private static string? MessageMeta(ChatMessageSnapshot message) =>
        message.Route is null ||
        message.EstimatedCostMinor is null ||
        message.ActualCostMinor is null
            ? null
            : $"{message.Route.Provider} // {message.Route.Model} // RESERVADO {Aic.Format(message.EstimatedCostMinor.Value)} // LIQUIDADO {Aic.Format(message.ActualCostMinor.Value)}";

    public void Dispose()
    {
        _executionCancellation?.Cancel();
        _executionCancellation?.Dispose();
    }
}
