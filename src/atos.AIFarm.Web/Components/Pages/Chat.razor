    private async Task RefreshPresetsAsync()
    {
        _presets.Clear();
        _presets.AddRange(await ChatStore.ListChatPresetsAsync());
    }

    private static string PresetDescription(ChatPresetSnapshot preset) =>
        $"{preset.Settings.ModelPreference} // T {preset.Settings.Temperature:0.00} // {preset.Settings.MaximumOutputTokens:N0} TOKENS";

    private async Task PrepareAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || _working)
        {
            return;
        }

        _working = true;
        _error = null;

        try
        {
            await RefreshWalletAsync();
            _pendingPlan = await Workflow.PrepareAsync(
                _conversationId,
                _prompt,
                _contextMessageLimit,
                _branchMessageId,
                _attachments.Select(x => x.Id).ToArray(),
                _dataClassification,
                useFarmKnowledge: _useFarmKnowledge,
                authorizeFarmKnowledgeExternally: _useFarmKnowledge && _authorizeFarmExternal);
            _prompt = _pendingPlan.Prompt;
            _attemptIdempotencyKey = Guid.NewGuid().ToString("N");
            _lastFailure = null;
        }
        catch (Exception exception) when (
            exception is ArgumentException or InvalidOperationException)
        {
            _pendingPlan = null;
            _error = exception.Message;
        }
        catch (Exception)
        {
            _pendingPlan = null;
            _error = "Não foi possível calcular rota e custo. Tente novamente.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_pendingPlan is not { } plan || _working || !CanAffordPendingPlan)
        {
            return;
        }

        _working = true;
        var executionConversationId = _conversationId;
        if (_branchSourceConversationId is Guid sourceConversationId &&
            _branchMessageId is Guid branchMessageId)
        {
            try
            {
                if (_branchConversationId is null)
                {
                    var branch = await ChatStore.BranchConversationAsync(
                        sourceConversationId,
                        branchMessageId);
                    _branchConversationId = branch.Id;
                }

                executionConversationId = _branchConversationId!.Value;
            }
            catch (Exception)
            {
                _error = "Não foi possível criar a ramificação da conversa.";
                _working = false;
                return;
            }
        }

        _streaming = true;
        _executionStatus = "CONECTANDO";
        _streamingResponse.Clear();
        var executionCancellation = new CancellationTokenSource();
        _executionCancellation = executionCancellation;
        var idempotencyKey = _attemptIdempotencyKey ??= Guid.NewGuid().ToString("N");
        _error = null;
        _messages.Add(new ChatMessageSnapshot(
            Guid.NewGuid(),
            ChatMessageRole.User,
            plan.Prompt,
            ChatMessageStatus.Completed,
            Guid.Empty,
            DateTimeOffset.UtcNow));

        try
        {
            await Workflow.SendStreamingAsync(
                executionConversationId,
                plan,
                idempotencyKey,
                AppendDeltaAsync,
                executionCancellation.Token);
            if (executionConversationId == _conversationId)
            {
                await RefreshConversationAsync();
            }
            _prompt = string.Empty;
            _pendingPlan = null;
            _attemptIdempotencyKey = null;
            _lastFailure = null;
            _regenerating = false;
            _editingBranch = false;
            _branchSourceConversationId = null;
            _branchMessageId = null;
            _branchConversationId = null;
            if (executionConversationId != _conversationId)
            {
                Navigation.NavigateTo($"/chat/{executionConversationId}");
            }
        }
        catch (InsufficientBalanceException exception)
        {
            _lastFailure = new ExecutionFailureState(
                "InsufficientBalance",
                exception.Message,
                false,
                null);
            await RefreshConversationAsync();
        }
        catch (OperationCanceledException) when (
            executionCancellation.IsCancellationRequested)
        {
            _lastFailure = new ExecutionFailureState(
                "Cancelled",
                "Geração interrompida. A reserva foi liberada e nenhum custo foi capturado.",
                true,
                null);
            await RefreshConversationAsync();
        }
        catch (Exception exception)
        {
            _lastFailure = FailureState(exception);
            await RefreshConversationAsync();
        }
        finally
        {
            await RefreshWalletAsync();
            executionCancellation.Dispose();
            _executionCancellation = null;
            _streaming = false;
            _streamingResponse.Clear();
            _executionStatus = "CONECTANDO";
            _working = false;
        }
    }

    private async ValueTask AppendDeltaAsync(
        string delta,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        _streamingResponse.Append(delta);
        _executionStatus = "GERANDO";
        await InvokeAsync(StateHasChanged);
    }

    private void CancelExecution()
    {
        if (!_streaming || _executionCancellation is null)
        {
            return;
