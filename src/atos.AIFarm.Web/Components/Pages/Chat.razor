    protected override async Task OnParametersSetAsync()
    {
        if (!_contextMessageLimitInitialized)
        {
            Mode = await InterfaceMode.GetAsync();
            _contextMessageLimit = ContextLimits.DefaultMessageCount;
            _contextMessageLimitInitialized = true;
        }
        if (ConversationId is Guid requestedId &&
            requestedId != _conversationId)
        {
            ClearExecutionDraft();
        }
        await RefreshConversationAsync();
        await RefreshWalletAsync();
    }

    private bool CanAffordPendingPlan =>
        _pendingPlan is not null &&
        _snapshot is not null &&
        _snapshot.Balance.AvailableMinor >= _pendingPlan.MaximumCostMinor;

    private string ProjectedBalance => _pendingPlan is null || _snapshot is null
        ? "---"
        : Aic.Format(Math.Max(
            0,
            _snapshot.Balance.AvailableMinor - _pendingPlan.MaximumCostMinor));

    private void ToggleConfiguration()
    {
        _showConfiguration = !_showConfiguration;
        _configurationNotice = null;
        if (_showConfiguration)
        {
            ResetSettingsDraft();
        }
    }

    private ConversationAiSettings SettingsDraft() => new ConversationAiSettings(
        _modelPreference,
        _systemInstruction,
        _temperature,
        _maximumOutputTokens).Normalize();

    private void LoadSettings(ConversationAiSettings settings)
    {
        _savedAiSettings = settings.Normalize();
        ResetSettingsDraft();
    }

    private void ResetSettingsDraft()
    {
        _modelPreference = _savedAiSettings.ModelPreference;
        _systemInstruction = _savedAiSettings.SystemInstruction;
        _temperature = _savedAiSettings.Temperature;
        _maximumOutputTokens = _savedAiSettings.MaximumOutputTokens;
        _configurationNotice = null;
    }

    private void ValidateAvailableSettings(ConversationAiSettings settings)
    {
        var option = ModelOptions.FirstOrDefault(x => x.Value == settings.ModelPreference)
            ?? throw new InvalidOperationException("O modelo escolhido não está disponível neste ambiente.");
        if (settings.MaximumOutputTokens > option.MaximumOutputTokens)
        {
            throw new InvalidOperationException(
                $"Este modelo aceita no máximo {option.MaximumOutputTokens:N0} tokens nesta instalação.");
        }
    }

    private async Task SaveConversationSettingsAsync()
    {
        if (_working || _conversationId == Guid.Empty)
        {
            return;
        }

        _working = true;
        _error = null;
        try
        {
            var settings = SettingsDraft();
            ValidateAvailableSettings(settings);
            if (!await ChatStore.UpdateConversationAiSettingsAsync(_conversationId, settings))
            {
                throw new InvalidOperationException("A conversa não está disponível para configuração.");
            }
            _savedAiSettings = settings;
            _pendingPlan = null;
            _configurationNotice = "[ CONFIGURAÇÃO SALVA ]";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task SavePresetAsync()
    {
        if (_working)
        {
            return;
        }

        _working = true;
        _error = null;
        try
        {
            var settings = SettingsDraft();
            ValidateAvailableSettings(settings);
            await ChatStore.SaveChatPresetAsync(_presetName, settings);
            _presetName = string.Empty;
            await RefreshPresetsAsync();
            _configurationNotice = "[ PRESET SALVO ]";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ApplyPresetAsync(ChatPresetSnapshot preset)
    {
        if (_working)
        {
            return;
        }

        _working = true;
        _error = null;
        try
        {
            var settings = preset.Settings.Normalize();
            ValidateAvailableSettings(settings);
            if (!await ChatStore.UpdateConversationAiSettingsAsync(_conversationId, settings))
            {
                throw new InvalidOperationException("A conversa não está disponível para configuração.");
            }
            LoadSettings(settings);
            _pendingPlan = null;
            _configurationNotice = $"[ PRESET {preset.Name} APLICADO ]";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task DeletePresetAsync(Guid presetId)
    {
