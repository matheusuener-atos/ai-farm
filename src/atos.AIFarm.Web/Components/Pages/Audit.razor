@page "/audit"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAuditTrail AuditTrail

<PageTitle>Registro de tudo // atos AI Farm</PageTitle>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

<section class="panel audit-filter-panel">
    <header class="panel-head"><h2>Consulta</h2></header>
    <form class="audit-filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>Buscar<input type="search" maxlength="120" placeholder="ação, situação, referência ou código" @bind="_searchDraft" /></label>
        <label>Categoria
            <select @bind="_categoryDraft">
                <option value="">Todas</option>
                @foreach (var category in Enum.GetValues<AuditCategory>())
                {
                    <option value="@category">@CategoryLabel(category)</option>
                }
            </select>
        </label>
        <label>De (UTC)<input type="datetime-local" @bind="_fromDraft" /></label>
        <label>Até (UTC)<input type="datetime-local" @bind="_toDraft" /></label>
        <div class="audit-filter-actions">
            <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="ClearAsync" disabled="@_loading">Limpar</button>
            <button type="submit" style="box-shadow: 2px 2px 0 #111111" disabled="@_loading">Aplicar</button>
        </div>
    </form>
</section>

@if (_loading && _page is null)
{
    <section class="terminal placeholder"><div class="terminal-title"><span>Juntando os registros</span></div></section>
}
else if (_page is not null)
{
    <section class="kpi-grid cols-5 audit-kpis" aria-live="polite">
        <article class="kpi kpi-purple"><span>Eventos</span><strong>@_page.Totals.Total</strong><small>no filtro atual</small></article>
        <article class="kpi"><span>Créditos + segurança</span><strong>@(_page.Totals.Ledger + _page.Totals.Iris + _page.Totals.Security)</strong><small>@_page.Totals.Ledger extrato · @_page.Totals.Iris Iris · @_page.Totals.Security segurança</small></article>
        <article class="kpi kpi-amber"><span>Farm</span><strong>@_page.Totals.Farm</strong><small>tarefas e comprovantes</small></article>
        <article class="kpi"><span>Economia + recompensas</span><strong>@(_page.Totals.Economics + _page.Totals.Reward)</strong><small>@_page.Totals.Economics cenários · @_page.Totals.Reward propostas</small></article>
        <article class="kpi @(_page.Totals.IntegrityFailures == 0 ? "kpi-green" : "kpi-red")"><span>Integridade</span><strong>@(_page.Totals.IntegrityFailures == 0 ? "OK" : $"{_page.Totals.IntegrityFailures} falha(s)")</strong><small>conferência automática</small></article>
    </section>

    @if (_page.IsScanTruncated)
    {
        <div class="audit-warning" role="status">A consulta atingiu o limite de 5.000 eventos. Reduza o período para uma exportação completa.</div>
    }

    <section class="panel audit-timeline">
        <header class="panel-head">
            <h2>Linha do tempo</h2>
        </header>
        @if (_page.Events.Count == 0)
        {
            <div class="audit-empty"><strong>Nenhum evento encontrado</strong><span>Ajuste os filtros ou amplie o período.</span></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="audit-table">
                    <thead><tr><th>Quando (UTC)</th><th>Origem</th><th>O que aconteceu</th><th>Referência</th><th>Valor</th><th>Integridade</th></tr></thead>
                    <tbody>
                        @foreach (var item in _page.Events)
                        {
                            <tr>
                                <td><time datetime="@item.OccurredAtUtc.ToString("O")">@item.OccurredAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</time></td>
                                <td><span class="audit-category audit-@item.Category.ToString().ToLowerInvariant()">@CategoryLabel(item.Category)</span></td>
                                <td><strong>@item.Action</strong><small>@item.Status · @item.Description</small></td>
                                <td><code>@item.Reference</code>@if (item.Correlation is not null){<small>ligação @item.Correlation</small>}@if (item.Digest is not null){<small title="@item.Digest">resumo @ShortHash(item.Digest)</small>}</td>
                                <td>@FormatAmount(item)</td>
                                <td><span class="audit-integrity @IntegrityClass(item.Integrity)">@IntegrityLabel(item.Integrity)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <footer class="audit-pagination">
            <button type="button" @onclick="PreviousAsync" disabled="@(_loading || !_page.HasPreviousPage)">← Anterior</button>
            <span>Página @_page.Page de @_page.TotalPages · @_page.Totals.Total evento(s)</span>
            <button type="button" @onclick="NextAsync" disabled="@(_loading || !_page.HasNextPage)">Próxima →</button>
            <a class="audit-export" href="@ExportUrl" style="margin-left: auto; box-shadow: 2px 2px 0 #111111">Exportar JSON</a>
        </footer>
    </section>
}

@code {
    private AuditPage? _page;
    private string _searchDraft = string.Empty;
    private string _categoryDraft = string.Empty;
    private DateTime? _fromDraft;
    private DateTime? _toDraft;
    private AuditQuery _query = new();
    private bool _loading;
    private string? _error;

    private string ExportUrl
    {
        get
        {
            var values = new List<string>();
            if (_query.Search is not null) values.Add($"search={Uri.EscapeDataString(_query.Search)}");
            if (_query.Category is not null) values.Add($"category={_query.Category}");
            if (_query.FromUtc is not null) values.Add($"fromUtc={Uri.EscapeDataString(_query.FromUtc.Value.ToString("O"))}");
            if (_query.ToUtc is not null) values.Add($"toUtc={Uri.EscapeDataString(_query.ToUtc.Value.ToString("O"))}");
            return values.Count == 0 ? "/api/audit/export" : $"/api/audit/export?{string.Join('&', values)}";
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ApplyAsync()
    {
        _error = null;
        try
        {
            _query = new AuditQuery(
                _searchDraft,
                Enum.TryParse<AuditCategory>(_categoryDraft, out var category) ? category : null,
                ParseUtc(_fromDraft), ParseUtc(_toDraft), 1, 25).Normalize();
            await LoadAsync();
        }
        catch (ArgumentException exception) { _error = exception.Message; }
    }

    private async Task ClearAsync()
    {
        _searchDraft = _categoryDraft = string.Empty;
        _fromDraft = _toDraft = null;
        _query = new AuditQuery();
        await LoadAsync();
    }

    private Task PreviousAsync() => ChangePageAsync(_query.Page - 1);
    private Task NextAsync() => ChangePageAsync(_query.Page + 1);
    private async Task ChangePageAsync(int page) { _query = _query with { Page = page }; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _page = await AuditTrail.SearchAsync(_query); }
        catch (Exception) { _error = "Não foi possível montar o registro de tudo."; }
        finally { _loading = false; }
    }

    private static DateTimeOffset? ParseUtc(DateTime? value) => value is null
        ? null
        : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc));
    private static string CategoryLabel(AuditCategory category) => category switch
    {
        AuditCategory.Ledger => "EXTRATO", AuditCategory.Iris => "IRIS", AuditCategory.Farm => "FARM",
        AuditCategory.Economics => "ECONOMIA", AuditCategory.Reward => "RECOMPENSA",
        AuditCategory.Security => "SEGURANÇA", _ => category.ToString().ToUpperInvariant()
    };
    private static string IntegrityLabel(AuditIntegrityStatus status) => status switch
    {
        AuditIntegrityStatus.Valid => "CONFERE", AuditIntegrityStatus.Invalid => "FALHA", _ => "N/A"
    };
    private static string IntegrityClass(AuditIntegrityStatus status) => status switch
    {
        AuditIntegrityStatus.Valid => "valid", AuditIntegrityStatus.Invalid => "invalid", _ => "neutral"
    };
    private static string FormatAmount(AuditEventSnapshot item) => item.AmountMinor is null ? "—" : item.Category switch
    {
        AuditCategory.Farm => $"{item.AmountMinor.Value / 1_000m:N3} CP",
        AuditCategory.Ledger or AuditCategory.Iris => Aic.Format(item.AmountMinor.Value),
        _ => item.AmountMinor.Value.ToString("N0")
    };
    private static string ShortHash(string value) => value.Length <= 16 ? value : $"{value[..10]}...{value[^4..]}";
}
