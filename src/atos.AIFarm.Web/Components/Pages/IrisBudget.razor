@page "/iris/budget"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAiUsageBudgetService Budget

<PageTitle>Limites de uso // atos AI Farm</PageTitle>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
@if (_notice is not null)
{
    <p class="budget-notice" role="status">@_notice</p>
}

@if (_snapshot is null)
{
    <p class="muted">Carregando limites…</p>
}
else
{
    <div class="kpi-grid cols-5 budget-kpis">
        <section class="kpi @(_snapshot.Policy.IsEnabled ? "kpi-green" : "kpi-amber")">
            <span>Proteção</span>
            <strong>@(_snapshot.Policy.IsEnabled ? "ATIVA" : "DESLIGADA")</strong>
            <small>atualizada @_snapshot.UpdatedAtUtc.ToString("dd/MM HH:mm") UTC</small>
        </section>
        <section class="kpi kpi-purple">
            <span>Usado hoje</span>
            <strong>@Aic.Format(_snapshot.UsedTodayMinor)</strong>
            <small>desde @_snapshot.DayStartedAtUtc.ToString("dd/MM 00:00") UTC</small>
        </section>
        <section class="kpi">
            <span>Usado no mês</span>
            <strong>@Aic.Format(_snapshot.UsedThisMonthMinor)</strong>
            <small>desde @_snapshot.MonthStartedAtUtc.ToString("dd/MM 00:00") UTC</small>
        </section>
        <section class="kpi kpi-amber">
            <span>Em andamento</span>
            <strong>@Aic.Format(_snapshot.ReservedMinor)</strong>
            <small>valores separados agora</small>
        </section>
        <section class="kpi kpi-green">
            <span>Restante do dia</span>
            <strong>@FormatRemaining(_snapshot.DailyRemainingMinor)</strong>
            <small>mês: @FormatRemaining(_snapshot.MonthlyRemainingMinor)</small>
        </section>
    </div>

    <section class="panel budget-panel">
        <div class="panel-head">
            <h2>Limites desta conta</h2>
            <label class="budget-switch">
                <input type="checkbox" @bind="_enabled" />
                <span>@(_enabled ? "Proteção ativa" : "Proteção desligada")</span>
            </label>
        </div>

        <div class="budget-form">
            <label>
                MÁXIMO POR RESPOSTA // @_perRequestAic AIC
                <input type="range" min="1" max="200" step="1" @bind="_perRequestAic" @bind:event="oninput" disabled="@_saving" />
                <small>Bloqueia a resposta antes de qualquer gasto.</small>
            </label>
            <label>
                LIMITE POR DIA // @_dailyAic AIC
                <input type="range" min="1" max="1000" step="1" @bind="_dailyAic" @bind:event="oninput" disabled="@_saving" />
                <small>Conta o que foi gasto + o que está separado no dia (UTC).</small>
            </label>
            <label>
                LIMITE POR MÊS // @_monthlyAic AIC
                <input type="range" min="1" max="10000" step="10" @bind="_monthlyAic" @bind:event="oninput" disabled="@_saving" />
                <small>Conta o que foi gasto + o que está separado no mês (UTC).</small>
            </label>
        </div>

        <div style="display: flex; align-items: center; gap: 12px; padding: 0 16px 14px">
            <small class="muted" style="margin-right: auto">Desligar a proteção não apaga o histórico. O limite geral de segurança continua valendo.</small>
            <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync" disabled="@_saving">Atualizar consumo</button>
            <button type="button" style="box-shadow: 2px 2px 0 #111111" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Salvando..." : "Salvar limites")
            </button>
        </div>
    </section>
}

@code {
    private AiUsageBudgetSnapshot? _snapshot;
    private bool _enabled;
    private long _perRequestAic = 20;
    private long _dailyAic = 100;
    private long _monthlyAic = 1_000;
    private bool _saving;
    private string? _error;
    private string? _notice;

    protected override Task OnInitializedAsync() => LoadAsync(true);

    private Task LoadAsync() => LoadAsync(false);

    private async Task LoadAsync(bool copyPolicy)
    {
        _error = null;
        try
        {
            _snapshot = await Budget.GetSnapshotAsync();
            if (copyPolicy)
            {
                _enabled = _snapshot.Policy.IsEnabled;
                if (_snapshot.Policy.MaximumPerRequestMinor > 0) _perRequestAic = ToAic(_snapshot.Policy.MaximumPerRequestMinor);
                if (_snapshot.Policy.DailyLimitMinor > 0) _dailyAic = ToAic(_snapshot.Policy.DailyLimitMinor);
                if (_snapshot.Policy.MonthlyLimitMinor > 0) _monthlyAic = ToAic(_snapshot.Policy.MonthlyLimitMinor);
            }
        }
        catch (Exception)
        {
            _error = "Não foi possível carregar os limites de uso.";
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _notice = null;
        try
        {
            var policy = new AiUsageBudgetPolicy(
                _enabled,
                Aic.FromAic(_perRequestAic),
                Aic.FromAic(_dailyAic),
                Aic.FromAic(_monthlyAic));
            _snapshot = await Budget.UpdatePolicyAsync(policy);
            _notice = _enabled
                ? "Proteção ativa — novas respostas serão bloqueadas antes de passar do limite."
                : "Proteção desligada — o histórico foi preservado.";
        }
        catch (Exception exception) when (exception is ArgumentException or OverflowException)
        {
            _error = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static long ToAic(long minor) => (long)Math.Ceiling(minor / (decimal)Aic.MinorUnitsPerAic);
    private static string FormatRemaining(long? value) => value is null ? "SEM LIMITE" : Aic.Format(value.Value);
}
