@page "/farm/rewards"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab
@inject IFarmEconomicsScenarioStore ScenarioStore
@inject IFarmRewardProposalStore ProposalStore
@inject IFarmRewardSettlementService SettlementService

<PageTitle>Propostas de Reward // atos AI Farm</PageTitle>

<div class="page-heading">
    <p class="eyebrow amber">atos:/FARM/REWARDS</p>
    <h1>Antes do pagamento</h1>
    <p>Transforme evidência técnica e cenário econômico em uma proposta auditável, pronta para liquidação financiada.</p>
</div>

<section class="reward-guardrail @(_pool?.Policy.IsEnabled == true ? "funded" : null)" role="note">
    @if (_pool?.Policy.IsEnabled == true)
    {
        <strong>Reward Pool financiado</strong>
        <span>Política @_pool.Policy.Version: @Aic.Format(_pool.Policy.AicMinorPerThousandCp) por 1.000 CP, com orçamento mensal rígido e liquidação auditável.</span>
    }
    else
    {
        <strong>Liquidação bloqueada</strong>
        <span>Nenhum AIC será emitido até uma política CP → AIC versionada e um orçamento mensal serem habilitados pela operação.</span>
    }
</section>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}
@if (_notice is not null)
{
    <div class="reward-notice" role="status">@_notice</div>
}

@if (_loading)
{
    <section class="terminal placeholder">
        <div class="terminal-title"><span>Validando fontes</span></div>
    </section>
}
else if (_pool is not null)
{
    <section class="terminal reward-pool">
        <div class="terminal-title"><span>Reward Pool</span><small>@_pool!.PeriodStartUtc.ToString("MM/yyyy") · compartilhado</small></div>
        <div class="reward-pool-grid">
            <article><span>ORÇAMENTO</span><strong>@Aic.Format(_pool.BudgetMinor)</strong></article>
            <article><span>LIQUIDADO</span><strong>@Aic.Format(_pool.SpentMinor)</strong></article>
            <article><span>DISPONÍVEL</span><strong>@Aic.Format(_pool.RemainingMinor)</strong></article>
            <article><span>LIMITE / REWARD</span><strong>@Aic.Format(_pool.Policy.MaximumPerSettlementMinor)</strong></article>
        </div>
        <div class="reward-pool-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@PoolUsagePercent">
            <span style="width: @PoolUsagePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
        </div>
    </section>

    <section class="terminal reward-sources">
        <div class="terminal-title"><span>Fontes elegíveis</span><small>cenário medido + evidência válida</small></div>
        @if (EligibleSources.Count == 0)
        {
            <div class="reward-empty">
                <strong>NENHUMA FONTE ELEGÍVEL</strong>
                <p>Execute um benchmark com evidência válida, use sua medição no simulador econômico e salve a fotografia.</p>
                <a class="text-link" href="/farm/economy">ABRIR SIMULADOR →</a>
            </div>
        }
        else
        {
            @foreach (var source in EligibleSources)
            {
                <article>
                    <header>
                        <div>
                            <strong>@source.Scenario.Name</strong>
                            <small>JOB @ShortId(source.Job.Id) // CENÁRIO @ShortId(source.Scenario.Id)</small>
                        </div>
                        <span class="green">Fontes válidas</span>
                    </header>
                    <dl>
                        <div><dt>PROCESSAMENTO</dt><dd>@FormatCp(source.Job.ComputeUnitsMilli)</dd></div>
                        <div><dt>TETO / 1.000 CP</dt><dd>@Money(source.Scenario.Result.MaximumRewardPerThousandCu, 6)</dd></div>
                        <div><dt>REWARD PROPOSTO</dt><dd>@Money(RecommendedReward(source), 6)</dd></div>
                        <div><dt>EVIDÊNCIA</dt><dd title="@source.Scenario.SourceEvidenceDigest">@ShortHash(source.Scenario.SourceEvidenceDigest!)</dd></div>
                    </dl>
                    <button type="button"
                            @onclick="() => CreateProposalAsync(source)"
                            disabled="@(_working || HasProposal(source.Scenario.Id))">
                        @(HasProposal(source.Scenario.Id) ? "Proposta registrada" : "Registrar proposta")
                    </button>
                </article>
            }
        }
    </section>

    <section class="terminal reward-history">
        <div class="terminal-title"><span>Propostas imutáveis</span><small>últimas 20</small></div>
        @if (_proposals.Count == 0)
        {
            <p class="muted">Nenhuma proposta registrada nesta conta.</p>
        }
        else
        {
            @foreach (var proposal in _proposals)
            {
                <article>
                    <header>
                        <div>
                            <strong>PROPOSTA // @ShortId(proposal.Id)</strong>
                            <small>@proposal.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") // @proposal.Version</small>
                        </div>
                        <span class="@(proposal.IsIntegrityValid ? "amber" : "error-text")">
                            @(proposal.IsIntegrityValid ? "AGUARDANDO POLÍTICA + FUNDING" : "INTEGRIDADE INVÁLIDA")
                        </span>
                    </header>
                    <dl>
                        <div><dt>JOB</dt><dd>@ShortId(proposal.JobId)</dd></div>
                        <div><dt>CENÁRIO</dt><dd>@ShortId(proposal.ScenarioId)</dd></div>
                        <div><dt>PROCESSAMENTO</dt><dd>@FormatCp(proposal.ProcessingPointsMilli)</dd></div>
                        <div><dt>VALOR RECOMENDADO</dt><dd>@Money(proposal.RecommendedRewardBrl, 6)</dd></div>
                        <div><dt>DIGEST</dt><dd title="@proposal.Digest">@ShortHash(proposal.Digest)</dd></div>
                    </dl>
                    @if (SettlementFor(proposal.Id) is { } settlement)
                    {
                        <div class="reward-settled">
                            <strong>@Aic.Format(settlement.RewardAmountMinor) creditado em Earned</strong>
                            <span>@settlement.PolicyVersion · Ledger @ShortId(settlement.LedgerTransactionId)</span>
                            <small class="@(settlement.IsIntegrityValid ? "green" : "error-text")">@(settlement.IsIntegrityValid ? "Settlement íntegro" : "Integridade inválida")</small>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="primary"
                                @onclick="() => SettleProposalAsync(proposal)"
                                disabled="@(_working || _pool?.Policy.IsEnabled != true || !proposal.IsIntegrityValid || proposal.RecommendedRewardBrl <= 0)">
                            Resgatar reward em AIC
                        </button>
                    }
                </article>
            }
        }
    </section>
}

<div class="reward-links">
    <a class="text-link" href="/farm">← COMPUTE LAB</a>
    <a class="text-link" href="/saldo-farm">SALDO DA FARM →</a>
</div>

@code {
    private FarmDashboard? _dashboard;
    private IReadOnlyList<FarmEconomicsScenarioSnapshot> _scenarios = [];
    private IReadOnlyList<FarmRewardProposalSnapshot> _proposals = [];
    private FarmRewardPoolSnapshot? _pool;
    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string? _notice;

    private IReadOnlyList<RewardSource> EligibleSources
    {
        get
        {
            if (_dashboard is null) return [];
            var jobs = _dashboard.RecentJobs
                .Where(x => x.Status == FarmJobStatus.Completed && x.Evidence?.IsValid == true)
                .ToDictionary(x => x.Id);
            return _scenarios
                .Where(x => x.IsIntegrityValid &&
                            x.SourceJobId is not null &&
                            x.SourceEvidenceDigest is not null &&
                            jobs.ContainsKey(x.SourceJobId.Value) &&
                            jobs[x.SourceJobId.Value].Evidence?.Digest == x.SourceEvidenceDigest)
                .Select(x => new RewardSource(jobs[x.SourceJobId!.Value], x))
                .ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateProposalAsync(RewardSource source)
    {
        if (_working || HasProposal(source.Scenario.Id)) return;
        _working = true;
        _error = null;
        _notice = null;
        try
        {
            var proposal = await ProposalStore.CreateAsync(source.Job.Id, source.Scenario.Id);
            await ReloadAsync();
            _notice = $"PROPOSTA {ShortId(proposal.Id)} REGISTRADA // NENHUM AIC EMITIDO";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task SettleProposalAsync(FarmRewardProposalSnapshot proposal)
    {
        if (_working || SettlementFor(proposal.Id) is not null) return;

        _working = true;
        _error = null;
        _notice = null;
        try
        {
            var settlement = await SettlementService.SettleAsync(proposal.Id);
            await ReloadAsync();
            _notice = $"REWARD {Aic.Format(settlement.RewardAmountMinor)} LIQUIDADO // EARNED // LEDGER {ShortId(settlement.LedgerTransactionId)}";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ReloadAsync()
    {
        _dashboard = await FarmLab.GetDashboardAsync();
        _scenarios = await ScenarioStore.ListAsync(50);
        _proposals = await ProposalStore.ListAsync();
        _pool = await SettlementService.GetPoolAsync(100);
    }

    private bool HasProposal(Guid scenarioId) => _proposals.Any(x => x.ScenarioId == scenarioId);
    private FarmRewardSettlementSnapshot? SettlementFor(Guid proposalId) =>
        _pool?.Settlements.SingleOrDefault(x => x.ProposalId == proposalId);
    private decimal PoolUsagePercent => _pool is null || _pool.BudgetMinor <= 0
        ? 0
        : decimal.Round(
            decimal.Min(100m, _pool.SpentMinor * 100m / _pool.BudgetMinor), 1);
    private static decimal RecommendedReward(RewardSource source) => decimal.Round(
        source.Job.ComputeUnitsMilli * source.Scenario.Result.MaximumRewardPerThousandCu / 1_000_000m,
        6,
        MidpointRounding.AwayFromZero);
    private static string FormatCp(long milli) => $"{milli / 1_000m:N3} CP";
    private static string Money(decimal value, int decimals = 2) => $"R$ {value.ToString($"N{decimals}")}";
    private static string ShortId(Guid id) => id.ToString("N")[..8];
    private static string ShortHash(string value) => value.Length <= 16 ? value : $"{value[..12]}...{value[^4..]}";

    private sealed record RewardSource(FarmJobSnapshot Job, FarmEconomicsScenarioSnapshot Scenario);
}
