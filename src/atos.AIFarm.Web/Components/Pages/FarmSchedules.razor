@page "/farm/schedules"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmScheduleService Schedules

<PageTitle>Agendamentos // atos AI Farm</PageTitle>

@if (_message is not null)
{
    <p class="@(_isError ? "error" : "schedule-success")" role="status">@_message</p>
}

<section class="panel schedule-create">
    <div class="panel-head"><h2>Novo agendamento</h2></div>
    <div class="schedule-form">
        <label>Nome
            <input @bind="_name" maxlength="80" placeholder="ex.: teste diário da máquina" disabled="@_working" />
        </label>
        <label>Tipo de tarefa
            <select @bind="_workloadId" disabled="@_working">
                @foreach (var workload in FarmWorkloadCatalog.Definitions.Where(x => x.InputSchema is null))
                {
                    <option value="@workload.Id">@workload.DisplayName · @workload.Version</option>
                }
            </select>
        </label>
        <label>Repetir a cada
            <select @bind="_intervalMinutes" disabled="@_working">
                <option value="5">5 minutos</option>
                <option value="15">15 minutos</option>
                <option value="30">30 minutos</option>
                <option value="60">1 hora</option>
                <option value="360">6 horas</option>
                <option value="1440">1 dia</option>
                <option value="10080">7 dias</option>
            </select>
        </label>
    </div>
    <div style="display: flex; align-items: center; gap: 12px; padding: 0 16px 14px">
        <small class="muted" style="margin-right: auto">A primeira execução acontece na hora. Pausas e falhas nunca geram pontos nem créditos por engano.</small>
        <button type="button" @onclick="CreateAsync" disabled="@_working">
            @(_working ? "Salvando..." : "Criar e ativar")
        </button>
    </div>
</section>

@if (_dashboard is null)
{
    <p class="muted">Carregando agendamentos…</p>
}
else
{
    <div class="jobs-kpis">
        <section class="kpi"><span>Total</span><strong>@_dashboard.Schedules.Count</strong></section>
        <section class="kpi kpi-green"><span>Ativos</span><strong>@_dashboard.ActiveCount</strong></section>
        <section class="kpi kpi-amber"><span>Pausados</span><strong>@_dashboard.PausedCount</strong></section>
        <section class="kpi @(_dashboard.FailureCount == 0 ? "kpi-green" : "kpi-red")"><span>Adiados / falhos</span><strong>@_dashboard.FailureCount</strong></section>
    </div>

    <section class="panel">
        <div class="panel-head"><h2>Agendamentos</h2></div>
        @if (_dashboard.Schedules.Count == 0)
        {
            <p class="schedule-empty">Nenhum agendamento configurado.</p>
        }
        <div class="schedule-grid">
            @foreach (var schedule in _dashboard.Schedules)
            {
                <article style="padding: 0; border: 1.5px solid #111111; background: #FFFFFF; box-shadow: 3px 3px 0 #111111; display: flex; flex-direction: column">
                    <header style="display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-bottom: 1.5px solid #111111; background: #F4F1EA">
                        <strong style="font-size: 13px">@schedule.Name</strong>
                        <small class="muted">@schedule.WorkloadVersion</small>
                        <span class="@(schedule.Status == FarmScheduleStatus.Active ? "green" : "amber")" style="margin-left: auto; font-size: 12px; font-weight: 600">@(schedule.Status == FarmScheduleStatus.Active ? "ATIVO" : "PAUSADO")</span>
                    </header>
                    <dl style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 12px 16px; border: 1.5px solid #111111">
                        <div style="padding: 8px 10px; border-right: 1.5px solid #111111; border-bottom: 1.5px solid #111111"><dt>Repete a cada</dt><dd>@FormatInterval(schedule.IntervalMinutes)</dd></div>
                        <div style="padding: 8px 10px; border-bottom: 1.5px solid #111111"><dt>Próxima (UTC)</dt><dd>@(schedule.Status == FarmScheduleStatus.Active ? schedule.NextRunAtUtc.ToString("dd/MM HH:mm:ss") : "—")</dd></div>
                        <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><dt>Última (UTC)</dt><dd>@(schedule.LastTriggeredAtUtc?.ToString("dd/MM HH:mm:ss") ?? "—")</dd></div>
                        <div style="padding: 8px 10px"><dt>Código</dt><dd>@schedule.Id.ToString("N")[..8]</dd></div>
                    </dl>
                    <footer style="display: flex; justify-content: flex-end; gap: 10px; padding: 0 16px 14px; margin-top: auto">
                        <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="() => TriggerAsync(schedule.Id)" disabled="@_working">Executar agora</button>
                        <button type="button" class="btn primary" style="box-shadow: 2px 2px 0 #111111" @onclick="() => ToggleAsync(schedule)" disabled="@_working">
                            @(schedule.Status == FarmScheduleStatus.Active ? "Pausar" : "Retomar")
                        </button>
                    </footer>
                </article>
            }
        </div>
        <footer style="display: flex; justify-content: flex-end; padding: 12px 16px; border-top: 1px solid var(--line)">
            <button class="btn primary" type="button" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync" disabled="@_working">Atualizar</button>
        </footer>
    </section>

    <section class="panel schedule-triggers">
        <div class="panel-head"><h2>Disparos recentes</h2></div>
        @if (_dashboard.RecentTriggers.Count == 0)
        {
            <p class="schedule-empty">Nenhum disparo registrado.</p>
        }
        @foreach (var trigger in _dashboard.RecentTriggers)
        {
            var schedule = _dashboard.Schedules.SingleOrDefault(x => x.Id == trigger.ScheduleId);
            <article>
                <time>@trigger.ScheduledForUtc.ToString("dd/MM HH:mm:ss") UTC</time>
                <div><strong>@(schedule?.Name ?? "Agendamento removido")</strong><small>@(trigger.Detail ?? "Processando ocorrência.")</small></div>
                @if (trigger.JobId is Guid jobId)
                {
                    <a href="/farm/jobs?jobId=@jobId">TAREFA @jobId.ToString("N")[..8]</a>
                }
                <span class="@TriggerClass(trigger.Status)">@TriggerLabel(trigger.Status)</span>
            </article>
        }
    </section>
}

@code {
    private FarmScheduleDashboard? _dashboard;
    private string _name = string.Empty;
    private string _workloadId = FarmWorkloadCatalog.DefaultId;
    private int _intervalMinutes = 60;
    private bool _working;
    private bool _isError;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _dashboard = await Schedules.GetDashboardAsync(); }
        catch (Exception) { Show("Não foi possível carregar os agendamentos.", true); }
    }

    private async Task CreateAsync()
    {
        await ExecuteAsync(async () =>
        {
            var created = await Schedules.CreateAsync(new(
                _name, _workloadId, _intervalMinutes));
            _name = string.Empty;
            Show($"Agendamento {created.Name} criado e ativado.", false);
        });
    }

    private Task ToggleAsync(FarmScheduleSnapshot schedule) => ExecuteAsync(async () =>
    {
        var next = schedule.Status == FarmScheduleStatus.Active
            ? FarmScheduleStatus.Paused : FarmScheduleStatus.Active;
        await Schedules.SetStatusAsync(schedule.Id, next);
        Show($"Agendamento {schedule.Name}: {(next == FarmScheduleStatus.Active ? "ATIVO" : "PAUSADO")}.", false);
    });

    private Task TriggerAsync(Guid scheduleId) => ExecuteAsync(async () =>
    {
        var trigger = await Schedules.TriggerNowAsync(scheduleId);
        Show(trigger.Status == FarmScheduleTriggerStatus.Submitted
            ? "Tarefa enviada para a fila de trabalho."
            : trigger.Detail ?? "O disparo não pôde ser enviado.",
            trigger.Status != FarmScheduleTriggerStatus.Submitted);
    });

    private async Task ExecuteAsync(Func<Task> action)
    {
        _working = true;
        _message = null;
        try { await action(); await LoadAsync(); }
        catch (ArgumentException exception) { Show(exception.Message, true); }
        catch (InvalidOperationException exception) { Show(exception.Message, true); }
        catch (Exception) { Show("A operação de agendamento falhou.", true); }
        finally { _working = false; }
    }

    private void Show(string value, bool error) { _message = value; _isError = error; }
    private static string FormatInterval(int minutes) => minutes switch
    {
        10080 => "7 DIAS", 1440 => "1 DIA", 60 => "1 HORA",
        _ when minutes % 60 == 0 => $"{minutes / 60} HORAS",
        _ => $"{minutes} MINUTOS"
    };
    private static string TriggerLabel(FarmScheduleTriggerStatus status) => status switch
    {
        FarmScheduleTriggerStatus.Submitted => "ENVIADO",
        FarmScheduleTriggerStatus.Deferred => "ADIADO",
        FarmScheduleTriggerStatus.Failed => "FALHOU",
        _ => "DESPACHANDO"
    };
    private static string TriggerClass(FarmScheduleTriggerStatus status) =>
        status == FarmScheduleTriggerStatus.Submitted ? "green" :
        status == FarmScheduleTriggerStatus.Dispatching ? "amber" : "error-text";
}
