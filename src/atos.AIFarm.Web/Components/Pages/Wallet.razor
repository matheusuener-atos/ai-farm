@page "/wallet"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWalletService WalletService

<PageTitle>Wallet // atos AI Farm</PageTitle>

<div class="page-head">
    <p class="eyebrow">atos:/WALLET</p>
    <h1>AI wallet</h1>
    <p>LEDGER IMUTÁVEL // VALORES EM mAIC</p>
</div>

@if (_snapshot is null)
{
    <p>CARREGANDO...</p>
}
else
{
    <div class="kpi-grid cols-3">
        <section class="kpi kpi-purple">
            <span>DISPONÍVEL</span>
            <strong>@Aic.Format(_snapshot.Balance.AvailableMinor)</strong>
        </section>
        <section class="kpi kpi-amber">
            <span>RESERVADO</span>
            <strong>@Aic.Format(_snapshot.Balance.ReservedMinor)</strong>
        </section>
        <section class="kpi">
            <span>PROMOTIONAL</span>
            <strong>@Aic.Format(_snapshot.Balance.AvailableByBucket[CreditBucket.Promotional])</strong>
        </section>
    </div>

    <section class="panel ledger">
        <header class="panel-head"><h2>Atividade do ledger</h2><span class="tag">IMUTÁVEL</span></header>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>UTC</th><th>OPERAÇÃO</th><th>VALOR</th><th>CORRELAÇÃO</th><th>DESCRIÇÃO</th></tr>
                </thead>
                <tbody>
                    @foreach (var transaction in _snapshot.Transactions.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <tr>
                            <td>@transaction.CreatedAtUtc.ToString("HH:mm:ss")</td>
                            <td class="@TypeClass(transaction.Type)">@transaction.Type.ToString().ToUpperInvariant()</td>
                            <td>@Aic.Format(transaction.Entries.Max(x => x.AmountMinor))</td>
                            <td><code>@transaction.CorrelationId.ToString()[..8]</code></td>
                            <td>@transaction.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private WalletSnapshot? _snapshot;

    protected override async Task OnInitializedAsync() =>
        _snapshot = await WalletService.GetSnapshotAsync();

    private static string TypeClass(LedgerTransactionType type) => type switch
    {
        LedgerTransactionType.Grant => "green",
        LedgerTransactionType.Capture => "purple",
        LedgerTransactionType.Reserve or LedgerTransactionType.Release => "amber",
        _ => string.Empty
    };
}
