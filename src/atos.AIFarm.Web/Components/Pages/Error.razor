@page "/Error"
@using System.Diagnostics

<PageTitle>Erro // atos AI Farm</PageTitle>

<section class="error-state">
    <p class="eyebrow">atos:/SYSTEM_ERROR</p>
    <strong>ERR</strong>
    <h1>Falha na operação</h1>
    <p>A solicitação não pôde ser concluída. Tente novamente ou volte ao início.</p>
    @if (ShowRequestId)
    {
        <code>REQUEST_ID // @RequestId</code>
    }
    <a href="/">Voltar ao início</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
