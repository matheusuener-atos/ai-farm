@page "/saldo-farm"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmBalanceQuery FarmBalanceQuery

<PageTitle>Saldo da Farm // atos AI Farm</PageTitle>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}
else if (_snapshot is null)
{
    <section class="terminal placeholder">
        <div class="terminal-title"><span>Carregando os números</span></div>
    </section>
}
else
{
    <section class="farm-value-equation" aria-label="Fluxo de valor da Farm">
        <article style="background: #FFFFFF; border: 1.5px solid #111111; box-shadow: 3px 3px 0 #111111">
            <span>01 · TRABALHO FEITO</span>
            <strong>@FormatCp(_snapshot.VerifiedComputeUnitsMilli)</strong>
            <small>@_snapshot.CompletedJobs tarefas concluídas</small>
        </article>
        <span aria-hidden="true">→</span>
        <article style="background: #FFFFFF; border: 1.5px solid #111111; box-shadow: 3px 3px 0 #111111">
            <span>02 · CRÉDITOS GANHOS</span>
            <strong>@Aic.Format(_snapshot.GeneratedEarnedAicMinor)</strong>
            <small>recompensas registradas no extrato</small>
        </article>
        <span aria-hidden="true">→</span>
        <article style="background: #FFFFFF; border: 1.5px solid #111111; box-shadow: 3px 3px 0 #111111">
            <span>03 · CRÉDITOS GASTOS EM IA</span>
            <strong>@Aic.Format(_snapshot.ConsumedAicMinor)</strong>
            <small>respostas já pagas</small>
        </article>
    </section>

    @if (!_snapshot.HasFundedRewards)
    {
        <section class="farm-no-reward" role="note">
            <strong>Nenhuma recompensa paga ainda</strong>
            <p>Seu trabalho foi medido, mas ainda não virou créditos. Isso é esperado enquanto a política de recompensas não estiver ativa e financiada.</p>
        </section>
    }

    <div class="jobs-kpis" style="grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1.5px solid #111111; background: #FFFFFF; box-shadow: 3px 3px 0 #111111">
        <section class="kpi kpi-amber" style="border-bottom: 1.5px solid #111111"><span>Ganhos disponíveis</span><strong>@Aic.Format(_snapshot.EarnedAvailableAicMinor)</strong><small>Só recompensas já registradas.</small></section>
        <section class="kpi" style="border-bottom: 1.5px solid #111111"><span>Comprados disponíveis</span><strong>@Aic.Format(_snapshot.PurchasedAvailableAicMinor)</strong><small>Compras ainda não fazem parte desta versão.</small></section>
        <section class="kpi" style="border-right: 0; border-bottom: 1.5px solid #111111"><span>Bônus disponível</span><strong>@Aic.Format(_snapshot.PromotionalAvailableAicMinor)</strong><small>Créditos de boas-vindas.</small></section>
        <section class="kpi kpi-green"><span>Total disponível</span><strong>@Aic.Format(_snapshot.TotalAvailableAicMinor)</strong><small>Soma de todos os tipos.</small></section>
        <section class="kpi"><span>Separado agora</span><strong>@Aic.Format(_snapshot.ReservedAicMinor)</strong><small>Respostas ainda em andamento.</small></section>
        <section class="kpi" style="border-right: 0; background: #111111" aria-hidden="true"></section>
    </div>

    <section class="terminal farm-balance-audit">
        <div class="terminal-title"><span>De onde vêm estes números</span></div>
        <dl>
            <div><dt>Trabalho</dt><dd>Tarefas concluídas desta conta</dd></div>
            <div><dt>Créditos ganhos</dt><dd>Recompensas registradas no extrato</dd></div>
            <div><dt>Créditos gastos</dt><dd>Respostas de IA já pagas</dd></div>
            <div><dt>Período</dt><dd>@FarmPeriod(_snapshot)</dd></div>
        </dl>
        <p>CP mede trabalho do computador. AIC mede o que você pode gastar. Esta tela mostra os dois lado a lado, sem converter um no outro.</p>
    </section>
}

@code {
    private FarmBalanceSnapshot? _snapshot;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _snapshot = await FarmBalanceQuery.GetAsync(); }
        catch (InvalidOperationException exception) { _error = exception.Message; }
    }

    private static string FormatCp(long milli) => $"{milli / 1_000m:N3} CP";

    private static string FarmPeriod(FarmBalanceSnapshot snapshot) =>
        snapshot.FirstCompletedJobAtUtc is null || snapshot.LastCompletedJobAtUtc is null
            ? "Sem tarefas concluídas"
            : $"{snapshot.FirstCompletedJobAtUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm} → {snapshot.LastCompletedJobAtUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}";
}
