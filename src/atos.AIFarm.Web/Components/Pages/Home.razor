@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWalletService Wallet
@inject IAiUsageQuery Usage
@inject IFarmLabService FarmLab
@inject IInterfaceModeService InterfaceMode
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>atos AI Farm</PageTitle>

<h1 class="sr-only">Início</h1>

@if (IsLite)
{
    <div class="home-lite">
        <section class="win" aria-label="Seus créditos">
            <div class="win-title"><span>Seus créditos</span></div>
            <div class="win-body home-balance">
                <div class="home-balance-head">
                    <div>
                        <span class="label">Créditos disponíveis</span>
                        <strong class="home-balance-value">@BalanceValue</strong>
                        <span class="muted">Você começa com 1.000 créditos de boas-vindas. Cada conversa usa um pouco — e mostra o valor antes de gastar.</span>
                    </div>
                    <div class="page-actions">
                        <a class="btn primary" href="/chat">Conversar com a Iris</a>
                        <a class="btn" href="/wallet">Ver meus créditos</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="win" aria-label="Seu computador">
            <div class="win-title"><span>Seu computador</span></div>
            <div class="win-body home-node">
                @if (_farm is null)
                {
                    <p class="muted">Verificando…</p>
                }
                else
                {
                    <div class="home-node-head">
                        <span class="dot @(_farm.Node.Status == FarmNodeStatus.Online ? "orange blink" : "hollow")" aria-hidden="true"></span>
                        <b>@(_farm.Node.Status == FarmNodeStatus.Online ? "Pronto para trabalhar" : "Parado agora")</b>
                        <span class="muted">· @_farm.Node.Name</span>
                        <a class="btn" href="/meu-computador">Abrir</a>
                    </div>
                    <p class="muted">
                        Seu computador pode fazer tarefas seguras e acumular pontos de
                        trabalho enquanto você não o usa. Tudo é conferido pelo sistema.
                    </p>
                }
            </div>
        </section>

        <section class="win inactive" aria-label="Como funciona">
            <div class="win-title"><span>Como funciona</span></div>
            <div class="win-body">
                <ol class="lite-steps">
                    <li><b>Converse com a Iris.</b> Cada resposta usa um pouco dos seus créditos, e você sempre confirma o valor antes.</li>
                    <li><b>Ligue seu computador.</b> Ele recebe tarefas seguras, o sistema confere o resultado e registra pontos de trabalho.</li>
                    <li><b>Tudo fica anotado.</b> Cada crédito e cada tarefa têm registro permanente — nada se perde nem muda sozinho.</li>
                </ol>
                <p class="muted lite-footnote">
                    Quer ver os detalhes técnicos? Ative o modo completo no menu Conta.
                </p>
            </div>
        </section>
    </div>
}
else
{
<div class="home-modular" data-account="@_accountKey">
    <div class="home-fixed">
        <section class="win home-card-credits" aria-label="Seus créditos">
            <div class="win-title"><span>Seus créditos</span></div>
            <div class="win-body home-balance">
                <div class="home-balance-head">
                    <div>
                        <span class="label">Créditos disponíveis</span>
                        <strong class="home-balance-value">@BalanceValue</strong>
                        <span class="muted">Separado @Format(_snapshot?.Balance.ReservedMinor) · Já gasto @Format(ConsumedMinor) · @(_usage?.Totals.ExecutionCount.ToString() ?? "—") respostas nesta conta</span>
                    </div>
                    <div class="page-actions">
                        <a class="btn" href="/farm">Testar meu computador</a>
                        <a class="btn primary" href="/chat">Nova conversa</a>
                    </div>
                </div>
                <div class="home-month">
                    <b>Movimento deste mês</b>
                    <div class="cycle-row"><span>Bônus recebido</span><div class="cycle-bar cycle-green"><i style="width: @MonthPct(GrantMinor)%"></i></div><span class="num">@Format(GrantMinor)</span></div>
                    <div class="cycle-row"><span>Ganhos da farm</span><div class="cycle-bar cycle-green"><i style="width: @MonthPct(EarnedMinor)%"></i></div><span class="num">@Format(EarnedMinor)</span></div>
                    <div class="cycle-row"><span>Gasto com respostas</span><div class="cycle-bar cycle-purple"><i style="width: @MonthPct(ConsumedMinor)%"></i></div><span class="num">@Format(ConsumedMinor)</span></div>
                    <div class="cycle-row"><span>Devolvido ao saldo</span><div class="cycle-bar cycle-amber"><i style="width: @MonthPct(ReleasedMinor)%"></i></div><span class="num">@Format(ReleasedMinor)</span></div>
                </div>
            </div>
        </section>

        <section class="win home-card-extract" aria-label="Extrato">
            <div class="win-title"><span>Extrato</span></div>
            <div class="home-ledger">
                @if (_snapshot is null)
                {
                    <p class="muted">Carregando…</p>
                }
                else if (_snapshot.Transactions.Count == 0)
                {
                    <p class="muted">Nenhuma movimentação ainda.</p>
                }
                else
                {
                    @foreach (var transaction in _snapshot.Transactions.OrderByDescending(x => x.CreatedAtUtc).Take(8))
                    {
                        <div class="home-ledger-row">
                            <span class="mono muted">@transaction.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            <span class="tag @TypeClass(transaction.Type)">@TypeLabel(transaction.Type)</span>
                            <span class="mono num">@Aic.Format(transaction.Entries.Max(x => x.AmountMinor))</span>
                        </div>
                    }
                }
                <div class="home-ledger-foot">
                    <span class="muted">Partidas dobradas · imutável</span>
                    <a class="btn" href="/wallet">Ver créditos</a>
                </div>
            </div>
        </section>

        <section class="win home-card-machines" aria-label="Suas máquinas">
            <div class="win-title"><span>Suas máquinas</span></div>
            <div class="win-body">
                @if (_farm is null)
                {
                    <p class="muted">Conectando…</p>
                }
                else
                {
                    <div class="home-machines-grid">
                        @foreach (var node in _farm.Nodes.Take(4))
                        {
                            <article class="home-machine @(node.Status == FarmNodeStatus.Online ? "online" : "offline")">
                                <header>
                                    <span class="dot @(node.Status == FarmNodeStatus.Online ? "orange blink" : "hollow")" aria-hidden="true"></span>
                                    <b>@node.Name</b>
                                </header>
                                <p class="home-machine-state @(node.Status == FarmNodeStatus.Online ? "on" : null)">
                                    @(node.Status == FarmNodeStatus.Online ? "Pronto para trabalhar" : "Desligada")
                                </p>
                                <dl class="pool-facts">
                                    <div><dt>CPU</dt><dd>@node.LogicalProcessors núcleos</dd></div>
                                    <div><dt>CP total</dt><dd>@((node.LifetimeComputeUnitsMilli / 1000d).ToString("N0"))</dd></div>
                                </dl>
                            </article>
                        }
                        <a class="home-machine home-machine-add" href="/meu-computador">
                            <span class="home-machine-plus">+</span>
                            Adicionar máquina
                        </a>
                    </div>
                    <div class="home-machines-foot">
                        <span class="muted">@_farm.Nodes.Count máquina(s) nesta conta</span>
                        <a class="btn primary" href="/meu-computador">Abrir pool</a>
                    </div>
                }
            </div>
        </section>
    </div>

    <nav class="desk-icons" aria-label="Módulos">
        <button type="button" class="desk-icon" data-open="chat"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h14v9H8l-4 3v-3H3z" /></svg></span><span>Chat</span></button>
        <button type="button" class="desk-icon" data-open="credits"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="15" height="11" /><path d="M13 10.5h3.5M2.5 8h12" /></svg></span><span>Créditos</span></button>
        <button type="button" class="desk-icon" data-open="usage"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 15l4-6 3 4 3-7 4 9" /></svg></span><span>Uso da IA</span></button>
        <button type="button" class="desk-icon" data-open="lab"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="14" height="14" /><rect x="7" y="7" width="6" height="6" /></svg></span><span>Laboratório</span></button>
        <button type="button" class="desk-icon" data-open="earnings"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16h14M5 13v-4M9 13V5M13 13V8M17 13V3" /></svg></span><span>Ganhos</span></button>
        <button type="button" class="desk-icon" data-open="records"><span class="img"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2l6 3v5c0 4-2.5 7-6 8-3.5-1-6-4-6-8V5z" /></svg></span><span>Registros</span></button>
    </nav>

    <div class="home-modules">
        <section class="home-module" data-module="chat">
            <div class="home-module-bar"><span>Chat com Iris</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                <p><span class="purple">IRIS&gt;</span> Escreva sua pergunta — você confirma o custo antes de enviar.</p>
                <a class="btn primary" href="/chat">Abrir chat completo</a>
            </div>
        </section>
        <section class="home-module" data-module="credits">
            <div class="home-module-bar"><span>Créditos</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                <div class="kv-list">
                    <div><span>Total disponível</span><span class="mono num">@BalanceValue</span></div>
                    <div><span>Separado agora</span><span class="mono num">@Format(_snapshot?.Balance.ReservedMinor)</span></div>
                </div>
                <a class="btn" href="/wallet">Ver extrato completo</a>
            </div>
        </section>
        <section class="home-module" data-module="usage">
            <div class="home-module-bar"><span>Uso da IA</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                <div class="kv-list">
                    <div><span>Respostas</span><span class="mono num">@(_usage?.Totals.ExecutionCount.ToString() ?? "—")</span></div>
                    <div><span>Conversas</span><span class="mono num">@(_usage?.Totals.ConversationCount.ToString() ?? "—")</span></div>
                </div>
                <a class="btn" href="/iris/analytics">Abrir uso da IA</a>
            </div>
        </section>
        <section class="home-module" data-module="lab">
            <div class="home-module-bar"><span>Laboratório</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                <p class="muted">Última tarefa</p>
                <p class="mono">@LastJobLabel</p>
                <a class="btn" href="/farm">Testar agora</a>
            </div>
        </section>
        <section class="home-module" data-module="earnings">
            <div class="home-module-bar"><span>Ganhos</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                <div class="kv-list">
                    <div><span>Trabalho feito</span><span class="mono num">@(_farm is null ? "—" : FormatCp(_farm.VerifiedComputeUnitsMilli))</span></div>
                    <div><span>Créditos ganhos</span><span class="mono num">@Format(EarnedMinor)</span></div>
                </div>
                <a class="btn" href="/farm/rewards">Abrir recompensas</a>
            </div>
        </section>
        <section class="home-module" data-module="records">
            <div class="home-module-bar"><span>Registros</span><span class="home-module-btns"><button type="button" data-act="min" aria-label="Minimizar">▢</button><button type="button" data-act="close" aria-label="Fechar">×</button></span></div>
            <div class="home-module-body">
                @if (_snapshot is { Transactions.Count: > 0 })
                {
                    @foreach (var transaction in _snapshot.Transactions.OrderByDescending(x => x.CreatedAtUtc).Take(3))
                    {
                        <div class="home-ledger-row">
                            <span class="mono muted">@transaction.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            <span class="tag @TypeClass(transaction.Type)">@TypeLabel(transaction.Type)</span>
                        </div>
                    }
                }
                else
                {
                    <p class="muted">Sem registros ainda.</p>
                }
                <a class="btn" href="/audit">Abrir registros</a>
            </div>
        </section>
    </div>
</div>
}

@code {
    private AIFarmInterfaceMode Mode { get; set; } = AIFarmInterfaceMode.Pro;

    private bool IsLite => Mode == AIFarmInterfaceMode.Lite;

    private WalletSnapshot? _snapshot;
    private AiUsageDashboard? _usage;
    private FarmDashboard? _farm;
    private string _accountKey = "conta";

    protected override async Task OnInitializedAsync()
    {
        Mode = await InterfaceMode.GetAsync();
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var name = state.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
            _accountKey = name;
        _snapshot = await Wallet.GetSnapshotAsync();

        try { _usage = await Usage.GetDashboardAsync(recentLimit: 1); }
        catch (Exception) { _usage = null; }

        try { _farm = await FarmLab.GetDashboardAsync(); }
        catch (Exception) { _farm = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsLite)
        {
            try { await JS.InvokeVoidAsync("atosDesk.init"); }
            catch (Exception) { /* interop indisponível no pré-render */ }
        }
    }

    private string BalanceValue => _snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableMinor);

    private long ConsumedMinor =>
        _snapshot?.Transactions
            .Where(x => x.Type == LedgerTransactionType.Capture)
            .Sum(x => x.Entries.Max(e => e.AmountMinor)) ?? 0;

    private long GrantMinor =>
        _snapshot?.Transactions
            .Where(x => x.Type == LedgerTransactionType.Grant)
            .Sum(x => x.Entries.Max(e => e.AmountMinor)) ?? 0;

    private long ReleasedMinor =>
        _snapshot?.Transactions
            .Where(x => x.Type == LedgerTransactionType.Release)
            .Sum(x => x.Entries.Max(e => e.AmountMinor)) ?? 0;

    private long EarnedMinor =>
        _snapshot is not null && _snapshot.Balance.AvailableByBucket.TryGetValue(CreditBucket.Earned, out var earned)
            ? earned
            : 0;

    private int MonthPct(long value)
    {
        var max = Math.Max(1, new[] { GrantMinor, EarnedMinor, ConsumedMinor, ReleasedMinor }.Max());
        return (int)Math.Clamp(value * 100d / max, 0, 100);
    }

    private string LastJobLabel =>
        _farm is { RecentJobs.Count: > 0 } farm
            ? $"{farm.RecentJobs[0].Workload} · {(farm.RecentJobs[0].DurationMilliseconds is long ms ? $"{ms} ms" : "—")} · {JobStatusLabel(farm.RecentJobs[0].Status)}"
            : "nenhum job ainda";

    private static string Format(long? minor) => minor is long value ? Aic.Format(value) : "—";
    private static string FormatCp(long milli) => $"{milli / 1000d:0.000} CP";

    private static string JobStatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Completed => "verificado",
        FarmJobStatus.Running => "executando",
        FarmJobStatus.Failed => "falhou",
        FarmJobStatus.Cancelled => "cancelado",
        FarmJobStatus.TimedOut => "timeout",
        _ => status.ToString().ToLowerInvariant()
    };

    private static string TypeLabel(LedgerTransactionType type) => type switch
    {
        LedgerTransactionType.Grant => "Bônus",
        LedgerTransactionType.Reserve => "Reserva",
        LedgerTransactionType.Capture => "Uso",
        LedgerTransactionType.Release => "Devolução",
        _ => type.ToString()
    };

    private static string TypeClass(LedgerTransactionType type) => type switch
    {
        LedgerTransactionType.Grant => "green",
        LedgerTransactionType.Capture => "purple",
        LedgerTransactionType.Reserve => "amber",
        _ => string.Empty
    };
}
