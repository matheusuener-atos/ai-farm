@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWalletService Wallet

<PageTitle>atos AI Farm</PageTitle>

<header class="page-head dashboard-head">
    <div>
        <p class="eyebrow">atos:/COMMAND_CENTER</p>
        <h1>VISÃO GERAL</h1>
        <p>CONTROLE TÉCNICO E FINANCEIRO DA SUA INFRAESTRUTURA DE IA</p>
    </div>
    <span class="tag tag-online"><i aria-hidden="true"></i>SISTEMA ONLINE</span>
</header>

<section class="kpi-grid cols-3" aria-live="polite">
    <article class="kpi kpi-purple">
        <span>SALDO DISPONÍVEL</span>
        <strong>@(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableMinor))</strong>
        <small>CRÉDITOS PARA USO IMEDIATO</small>
    </article>
    <article class="kpi kpi-amber">
        <span>SALDO RESERVADO</span>
        <strong>@(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.ReservedMinor))</strong>
        <small>OPERAÇÕES EM PROCESSAMENTO</small>
    </article>
    <article class="kpi">
        <span>CRÉDITO PROMOCIONAL</span>
        <strong>@(_snapshot is null ? "---" : Aic.Format(_snapshot.Balance.AvailableByBucket[CreditBucket.Promotional]))</strong>
        <small>AMBIENTE OPERACIONAL</small>
    </article>
</section>

<section class="dashboard-grid">
    <a class="command-card command-ai" href="/chat">
        <span class="command-index">01 // IRIS</span>
        <div><strong>CONVERSAR</strong><p>Use seus créditos para executar tarefas com inteligência artificial.</p></div>
        <span class="command-arrow">→</span>
    </a>
    <a class="command-card command-farm" href="/farm">
        <span class="command-index">02 // COMPUTE</span>
        <div><strong>FARMAR</strong><p>Valide capacidade computacional em um ambiente controlado e auditável.</p></div>
        <span class="command-arrow">→</span>
    </a>
</section>

<section class="panel system-panel">
    <header class="panel-head"><h2>ESTADO DA PLATAFORMA</h2><span class="tag">OPERATIONAL</span></header>
    <div class="check-list">
        <span><i></i>LEDGER COM PARTIDAS DOBRADAS</span>
        <span><i></i>PERSISTÊNCIA ISOLADA POR CONTA</span>
        <span><i></i>EXECUÇÕES E EVIDÊNCIAS AUDITÁVEIS</span>
    </div>
</section>

@code {
    private WalletSnapshot? _snapshot;

    protected override async Task OnInitializedAsync() =>
        _snapshot = await Wallet.GetSnapshotAsync();
}
