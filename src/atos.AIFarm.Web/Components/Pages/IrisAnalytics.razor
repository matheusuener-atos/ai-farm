@page "/iris/analytics"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAiUsageQuery Usage

<PageTitle>Resumo de uso // atos AI Farm</PageTitle>

<div style="display: flex; justify-content: flex-end">
    <label class="analytics-period">Período (UTC)
        <select value="@_days" @onchange="ChangePeriodAsync" disabled="@_loading">
            <option value="7">7 dias</option>
            <option value="30">30 dias</option>
            <option value="90">90 dias</option>
        </select>
    </label>
</div>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_analytics is null)
{
    <p class="muted">Calculando…</p>
}
else
{
    <div class="analytics-kpis" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr))">
        <section class="kpi kpi-purple">
            <span>Respostas</span>
            <strong>@_analytics.Totals.ExecutionCount</strong>
            <small>@_analytics.Totals.ConversationCount conversa(s)</small>
        </section>
        <section class="kpi kpi-green">
            <span>Deram certo</span>
            <strong>@_analytics.SuccessRatePercent.ToString("0.0")%</strong>
            <small>@SuccessfulCount concluída(s)</small>
        </section>
        <section class="kpi kpi-amber">
            <span>Custo real</span>
            <strong>@Aic.Format(_analytics.Totals.ActualCostMinor)</strong>
            <small>estimado antes: @Aic.Format(_analytics.Totals.EstimatedCostMinor)</small>
        </section>
        <section class="kpi kpi-green">
            <span>Devolvido ao saldo</span>
            <strong>@Aic.Format(_analytics.Totals.ReleasedCostMinor)</strong>
            <small>estimativa não usada</small>
        </section>
        <section class="kpi">
            <span>Tempo médio de resposta</span>
            <strong>@FormatDuration(_analytics.AverageDurationMilliseconds)</strong>
            <small>respostas finalizadas</small>
        </section>
        <section class="kpi @CostTrendClass">
            <span>Variação de custo</span>
            <strong>@FormatChange(_analytics.ActualCostChangePercent)</strong>
            <small>período anterior: @Aic.Format(_analytics.PreviousPeriodActualCostMinor)</small>
        </section>
    </div>

    <section class="panel analytics-timeline">
        <div class="panel-head">
            <h2>Gasto por dia</h2>
        </div>
        <div class="analytics-bars" role="img" aria-label="Gasto real diário com a Iris">
            @foreach (var day in _analytics.Daily)
            {
                <div class="analytics-bar-row">
                    <time datetime="@day.DateUtc.ToString("yyyy-MM-dd")">@day.DateUtc.ToString("dd/MM")</time>
                    <div class="analytics-bar-track">
                        <span style="width: @BarWidth(day.ActualCostMinor)"></span>
                    </div>
                    <strong>@Aic.Format(day.ActualCostMinor)</strong>
                    <small>@day.ExecutionCount resposta(s) · @day.FailureCount falha(s)</small>
                </div>
            }
        </div>
        <footer class="home-ledger-foot" style="border-top: 1.5px solid #111111">
            <span class="muted">@_analytics.FromUtc.ToString("dd/MM/yyyy") — @_analytics.ToUtc.ToString("dd/MM/yyyy") UTC</span>
            <button type="button" class="btn primary" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Atualizando..." : "Atualizar")
            </button>
        </footer>
    </section>

    <div class="analytics-detail-grid">
        <section class="panel">
            <div class="panel-head"><h2>Serviços e modelos</h2></div>
            @if (_analytics.Routes.Count == 0)
            {
                <p class="analytics-empty muted">Sem respostas no período.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Rota</th><th>Respostas</th><th>Texto</th><th>Custo</th><th>Tempo</th></tr></thead>
                        <tbody>
                            @foreach (var route in _analytics.Routes)
                            {
                                <tr>
                                    <td><span class="purple">@route.Provider</span><br /><small>@route.Model</small></td>
                                    <td>@route.ExecutionCount<br /><small class="green">@route.SuccessCount ok</small> · <small class="amber">@route.FailureCount falha(s)</small></td>
                                    <td>@route.InputUnits.ToString("N0") enviado<br />@route.OutputUnits.ToString("N0") recebido</td>
                                    <td>@Aic.Format(route.ActualCostMinor)<br /><small>est. @Aic.Format(route.EstimatedCostMinor)</small></td>
                                    <td>@FormatDuration(route.AverageDurationMilliseconds)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel analytics-statuses">
            <div class="panel-head"><h2>Resultados</h2></div>
            @if (_analytics.Statuses.Count == 0)
            {
                <p class="analytics-empty muted">Sem resultados no período.</p>
            }
            else
            {
                @foreach (var status in _analytics.Statuses)
                {
                    <div>
                        <span class="@StatusClass(status.Status)">@StatusLabel(status.Status)</span>
                        <strong>@status.ExecutionCount</strong>
                        <small>@status.Percentage.ToString("0.0")%</small>
                    </div>
                }
            }
        </section>
    </div>
}

@code {
    private AiUsageAnalytics? _analytics;
    private int _days = 30;
    private bool _loading;
    private string? _error;

    private int SuccessfulCount => _analytics?.Statuses
        .FirstOrDefault(x => x.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
        ?.ExecutionCount ?? 0;
    private long MaximumDailyCost => Math.Max(1, _analytics?.Daily.Max(x => x.ActualCostMinor) ?? 0);
    private string CostTrendClass => _analytics?.ActualCostChangePercent switch
    {
        <= 0 => "kpi-green",
        > 0 => "kpi-amber",
        _ => string.Empty
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangePeriodAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var days))
            _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _analytics = await Usage.GetAnalyticsAsync(_days); }
        catch (Exception) { _error = "Não foi possível calcular o resumo de uso."; }
        finally { _loading = false; }
    }

    private string BarWidth(long value) => $"{value * 100m / MaximumDailyCost:0.##}%";
    private static string FormatChange(decimal? value) => value is null ? "SEM BASE" : $"{value:+0.0;-0.0;0.0}%";
    private static string FormatDuration(decimal? milliseconds) => milliseconds switch
    {
        null => "—",
        < 1_000 => $"{milliseconds:0} ms",
        _ => $"{milliseconds / 1_000:0.00} s"
    };
    private static string StatusLabel(string status) => status switch
    {
        "Completed" => "CONCLUÍDA",
        "Running" => "EM CURSO",
        "Failed" => "FALHOU",
        "Cancelled" => "CANCELADA",
        "TimedOut" => "TEMPO ESGOTADO",
        _ => status.ToUpperInvariant()
    };
    private static string StatusClass(string status) =>
        status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "green" : "amber";
}
