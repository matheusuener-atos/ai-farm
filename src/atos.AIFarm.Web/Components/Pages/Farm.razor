@page "/farm"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab

<PageTitle>Compute Lab // atos AI Farm</PageTitle>

<div class="page-heading">
    <p class="eyebrow amber">atos:/FARM/COMPUTE_LAB</p>
    <h1>COMPUTE CONTROLADO</h1>
    <p>Benchmark determinístico em host conhecido. CU técnico experimental, sem emissão de AIC.</p>
</div>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

@if (_dashboard is null)
{
    <section class="terminal placeholder">
        <div class="terminal-title">[ CONECTANDO AO NODE ]</div>
    </section>
}
else
{
    <section class="farm-node-panel">
        <header class="farm-node-header">
            <div>
                <span class="label">NODE</span>
                <strong>@_dashboard.Node.Name</strong>
            </div>
            <span class="status @(IsOnline ? null : "amber")">
                <span aria-hidden="true">●</span> @NodeStatusLabel(_dashboard.Node.Status)
            </span>
        </header>

        <div class="farm-metrics">
            <article>
                <span>VERIFICAÇÃO</span>
                <strong>@VerificationLabel(_dashboard.Node.VerificationLevel)</strong>
            </article>
            <article>
                <span>CPU LÓGICA</span>
                <strong>@_dashboard.Node.LogicalProcessors</strong>
            </article>
            <article>
                <span>MEMÓRIA DISPONÍVEL</span>
                <strong>@FormatBytes(_dashboard.Node.MemoryBytes)</strong>
            </article>
            <article>
                <span>CU VERIFICADO</span>
                <strong>@FormatCu(_dashboard.VerifiedComputeUnitsMilli)</strong>
            </article>
        </div>

        <p class="farm-runtime">@_dashboard.Node.Runtime</p>

        <div class="farm-controls">
            @if (IsOnline)
            {
                <button type="button" class="button-secondary" @onclick="PauseAsync" disabled="@_working">[ PAUSAR NODE ]</button>
                <button type="button" @onclick="RunBenchmarkAsync" disabled="@_working">
                    @(_working ? "[ EXECUTANDO... ]" : "[ EXECUTAR BENCHMARK ]")
                </button>
            }
            else
            {
                <button type="button" @onclick="ResumeAsync" disabled="@_working">[ RETOMAR NODE ]</button>
            }
        </div>
        <small class="classification-note">ALLOWLIST // SHA256_CHAIN V1 // SEM SHELL // SEM REDE // SEM AIC</small>
    </section>

    <section class="terminal farm-jobs">
        <div class="terminal-title">JOBS RECENTES // ÚLTIMOS 10</div>
        @if (_dashboard.RecentJobs.Count == 0)
        {
            <p class="muted">Nenhum Job executado neste laboratório.</p>
        }
        else
        {
            @foreach (var job in _dashboard.RecentJobs)
            {
                <article class="farm-job">
                    <header>
                        <strong>@job.Workload // @ShortId(job.Id)</strong>
                        <span class="@JobStatusClass(job.Status)">[ @JobStatusLabel(job.Status) ]</span>
                    </header>
                    <dl>
                        <div><dt>VERSÃO</dt><dd>@job.WorkloadVersion</dd></div>
                        <div><dt>VERIFICAÇÃO</dt><dd>@job.VerificationPolicy</dd></div>
                        <div><dt>CU</dt><dd>@FormatCu(job.ComputeUnitsMilli)</dd></div>
                        <div><dt>DIGEST</dt><dd>@(job.ResultDigest is null ? "---" : job.ResultDigest[..12])</dd></div>
                    </dl>
                    <ol class="farm-job-events">
                        @foreach (var entry in job.Events)
                        {
                            <li>
                                <time>@entry.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                                <strong>@JobStatusLabel(entry.Status)</strong>
                                <span>@entry.Detail</span>
                            </li>
                        }
                    </ol>
                </article>
            }
        }
    </section>
}

@code {
    private FarmDashboard? _dashboard;
    private bool _working;
    private string? _error;
    private bool IsOnline => _dashboard?.Node.Status == FarmNodeStatus.Online;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task PauseAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Paused);

    private async Task ResumeAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Online);

    private async Task ChangeStatusAsync(FarmNodeStatus status)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _dashboard = await FarmLab.SetNodeStatusAsync(status); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task RunBenchmarkAsync()
    {
        if (_working || !IsOnline) return;
        _working = true;
        _error = null;
        try
        {
            await FarmLab.RunBenchmarkAsync();
            _dashboard = await FarmLab.GetDashboardAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task ReloadAsync()
    {
        try { _dashboard = await FarmLab.GetDashboardAsync(); }
        catch (Exception exception) when (exception is InvalidOperationException)
        { _error = exception.Message; }
    }

    private static string NodeStatusLabel(FarmNodeStatus status) =>
        status == FarmNodeStatus.Online ? "ONLINE" : "PAUSADO";

    private static string VerificationLabel(FarmVerificationLevel level) =>
        level == FarmVerificationLevel.Verified ? "VERIFICADO" : "DETECTADO";

    private static string JobStatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Queued => "NA FILA",
        FarmJobStatus.Running => "EXECUTANDO",
        FarmJobStatus.Verifying => "VERIFICANDO",
        FarmJobStatus.Completed => "CONCLUÍDO",
        FarmJobStatus.Failed => "FALHOU",
        _ => status.ToString().ToUpperInvariant()
    };

    private static string JobStatusClass(FarmJobStatus status) =>
        status == FarmJobStatus.Completed ? "green" :
        status == FarmJobStatus.Failed ? "error-text" : "amber";

    private static string FormatCu(long milli) => $"{milli / 1000d:0.000} CU";
    private static string ShortId(Guid id) => id.ToString("N")[..8];
    private static string FormatBytes(long bytes) =>
        bytes <= 0 ? "---" : $"{bytes / 1024d / 1024d / 1024d:0.0} GB";
}
