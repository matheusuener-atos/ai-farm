@page "/farm"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject IFarmLabService FarmLab
@inject IFarmAgentService FarmAgent
@inject NavigationManager Navigation

<PageTitle>Compute Lab // atos AI Farm</PageTitle>

<div class="page-head">
    <p class="eyebrow amber">atos:/FARM/COMPUTE_LAB</p>
    <h1>Compute controlado</h1>
    <p>Workloads determinísticos em host conhecido. CP verificado vira AIC pelo resgate de recompensas (ADRs 0022/0033).</p>
    <a class="farm-economics-link" href="/farm/jobs">Abrir centro de jobs →</a>
    <a class="farm-economics-link" href="/farm/demands">Enviar demanda útil →</a>
    <a class="farm-economics-link" href="/farm/schedules">Automatizar workloads →</a>
    <a class="farm-economics-link" href="/farm/economy">Simular economia →</a>
    <a class="farm-economics-link" href="/saldo-farm">Ver saldo da farm →</a>
</div>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

@if (_dashboard is null)
{
    <section class="terminal placeholder">
        <div class="terminal-title"><span>Conectando ao node</span></div>
    </section>
}
else
{
    <section class="terminal farm-workload-catalog">
        <div class="terminal-title"><span>Catálogo de workloads</span><small>@FarmWorkloadCatalog.Version</small></div>
        <div class="farm-workload-grid">
            @foreach (var workload in FarmWorkloadCatalog.Definitions.Where(x => x.InputSchema is null))
            {
                <label class="farm-workload-card @(workload.Id == _selectedWorkloadId ? "selected" : null)">
                    <input type="radio" name="farm-workload" value="@workload.Id"
                           checked="@(workload.Id == _selectedWorkloadId)"
                           @onchange="() => _selectedWorkloadId = workload.Id"
                           disabled="@_working" />
                    <span>@workload.DisplayName</span>
                    <strong>@workload.Version</strong>
                    <small>@workload.Description</small>
                    <small>@workload.Iterations.ToString("N0") UNIDADES // @FormatCp(workload.ProcessingPointsMilli) // @workload.NetworkPolicy</small>
                </label>
            }
        </div>
    </section>

    <section class="terminal farm-pool">
        <div class="terminal-title"><span>Compute pool</span><small>@_dashboard.AvailableNodeCount DISPONÍVEIS // @_dashboard.Nodes.Count TOTAL</small></div>
        <div class="farm-pool-grid">
            @foreach (var poolNode in _dashboard.Nodes)
            {
                <article>
                    <header><strong>@poolNode.Name</strong><span class="@(poolNode.AcceptJobs ? "green" : "amber")">@NodeStatusLabel(poolNode.Status)</span></header>
                    <small>@ConnectionLabel(poolNode.ConnectionKind) // @(poolNode.AgentVersion ?? "HOST WEB")</small>
                    <dl>
                        <div><dt>CPU</dt><dd>@poolNode.AuthorizedLogicalProcessors / @poolNode.LogicalProcessors</dd></div>
                        <div><dt>MEMÓRIA</dt><dd>@FormatBytes(poolNode.AuthorizedMemoryBytes)</dd></div>
                        <div><dt>HEARTBEAT</dt><dd>@(poolNode.IsHeartbeatFresh ? "ATUAL" : "EXPIRADO")</dd></div>
                        <div><dt>PERFIL</dt><dd>@VerificationLabel(poolNode.VerificationLevel)</dd></div>
                    </dl>
                    <button type="button" class="button-secondary"
                            @onclick="() => ToggleNodeAsync(poolNode)" disabled="@_working">
                        @(poolNode.Status == FarmNodeStatus.Paused ? "RETOMAR" : "PAUSAR")
                    </button>
                    @if (poolNode.ConnectionKind == FarmNodeConnectionKind.Agent)
                    {
                        <button type="button" class="button-secondary"
                                @onclick="() => ToggleSharingAsync(poolNode)" disabled="@_working">
                            @(poolNode.SharePlatformWork ? "SAIR DO POOL DA PLATAFORMA" : "COMPARTILHAR COM A PLATAFORMA")
                        </button>
                    }
                </article>
            }
        </div>
    </section>

    <section class="farm-node-panel">
        <header class="farm-node-header">
            <div>
                <span class="label">NODE</span>
                <strong>@_dashboard.Node.Name</strong>
            </div>
            <span class="status @(IsOnline ? null : "amber")">
                <span aria-hidden="true">●</span> @NodeStatusLabel(_dashboard.Node.Status)
            </span>
        </header>

        <div class="farm-metrics">
            <article>
                <span>VERIFICAÇÃO</span>
                <strong>@VerificationLabel(_dashboard.Node.VerificationLevel)</strong>
            </article>
            <article>
                <span>CPU LÓGICA</span>
                <strong>@_dashboard.Node.LogicalProcessors</strong>
            </article>
            <article>
                <span>MEMÓRIA DISPONÍVEL</span>
                <strong>@FormatBytes(_dashboard.Node.MemoryBytes)</strong>
            </article>
            <article>
                <span>CP VERIFICADO</span>
                <strong>@FormatCp(_dashboard.VerifiedComputeUnitsMilli)</strong>
            </article>
            <article>
                <span>CONEXÃO</span>
                <strong>@ConnectionLabel(_dashboard.Node.ConnectionKind)</strong>
            </article>
            <article>
                <span>POLÍTICA LOCAL</span>
                <strong class="@(CanAcceptJobs ? null : "amber")">@(CanAcceptJobs ? "ACEITANDO JOBS" : "PAUSADA")</strong>
            </article>
            <article>
                <span>CPU AUTORIZADA</span>
                <strong>@_dashboard.Node.AuthorizedLogicalProcessors</strong>
            </article>
            <article>
                <span>MEMÓRIA AUTORIZADA</span>
                <strong>@FormatBytes(_dashboard.Node.AuthorizedMemoryBytes)</strong>
            </article>
        </div>

        <p class="farm-runtime">
            @_dashboard.Node.Runtime
            @if (_dashboard.Node.ProfileVerifiedAtUtc is not null &&
                 _dashboard.Node.VerifiedProfileHash is not null)
            {
                <text> // PERFIL @_dashboard.Node.VerifiedProfileHash[..12] // VERIFICADO @_dashboard.Node.ProfileVerifiedAtUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")</text>
            }
            else
            {
                <text> // PERFIL AGUARDANDO EXECUÇÃO VERIFICADA</text>
            }
        </p>

        <div class="farm-controls">
            @if (IsOnline && IsEmbedded)
            {
                <button type="button" class="button-secondary" @onclick="PauseAsync" disabled="@_working">Pausar node</button>
                <button type="button" @onclick="RunWorkloadAsync" disabled="@_working">
                    @(_working ? "Executando..." : $"Executar {SelectedWorkload.DisplayName}")
                </button>
            }
            else if (IsOnline)
            {
                <button type="button" class="button-secondary" @onclick="PauseAsync" disabled="@_working">Pausar agent</button>
                <button type="button" @onclick="RunWorkloadAsync" disabled="@(_working || !CanAcceptJobs)">
                    @(!CanAcceptJobs ? "Política local pausada" : _working ? "Despachando..." : $"Despachar {SelectedWorkload.DisplayName}")
                </button>
            }
            else if (_dashboard.Node.Status == FarmNodeStatus.Paused)
            {
                <button type="button" @onclick="ResumeAsync" disabled="@_working">Retomar node</button>
            }
            else
            {
                <button type="button" disabled>Aguardando heartbeat</button>
            }
        </div>
        <small class="classification-note">ALLOWLIST // @SelectedWorkload.Workload // @SelectedWorkload.VerificationPolicy // SEM SHELL // SEM REDE // SEM AIC</small>
    </section>

    <section class="terminal farm-agent-panel">
        <div class="terminal-title"><span>Compute agent</span><small>vínculo da máquina</small></div>
        <div class="farm-agent-download">
            <div>
                <strong>Windows x64</strong>
                <small>Executável autônomo // não exige .NET nem acesso ao repositório</small>
            </div>
            <a class="button-primary" href="/downloads/atos-compute-agent-win-x64.exe" download="atos-compute-agent-win-x64.exe">
                Baixar Agent
            </a>
        </div>
        <p>
            @if (IsEmbedded)
            {
                <text>Modo EMBEDDED: o workload roda no mesmo host da aplicação. Gere um código para vincular um Agent separado.</text>
            }
            else
            {
                <text>Agent @_dashboard.Node.AgentVersion // último heartbeat @_dashboard.Node.LastSeenAtUtc.ToLocalTime().ToString("HH:mm:ss")</text>
            }
        </p>
        <button type="button" class="button-secondary" @onclick="CreateEnrollmentAsync" disabled="@_working">
            Gerar código para novo/re-vínculo
        </button>
        <ol class="farm-agent-steps">
            <li>O vínculo é um handshake de mão dupla (ADR 0038): o caminho recomendado é o card-assento em <a href="/meu-computador">Meu computador</a> — código gerado no assento, e-mail + código na janela do programa, chave de confirmação de volta no card.</li>
            <li>Por terminal: <code>.\atos-compute-agent-win-x64.exe enroll @FarmUrl</code> pede o e-mail da conta e o código, e imprime a chave de confirmação (exibida uma única vez) para digitar no card.</li>
            <li><code>run</code> mantém o modo headless; sem argumentos, o programa abre o painel.</li>
        </ol>
        @if (_enrollment is not null)
        {
            <div class="farm-enrollment-secret" role="status">
                <strong>CÓDIGO ÚNICO // EXPIRES @_enrollment.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</strong>
                <code>@_enrollment.Token</code>
                <small>Copie agora. O código não será exibido novamente e o anterior foi invalidado.</small>
            </div>
        }
    </section>

    <section class="terminal farm-jobs">
        <div class="terminal-title"><span>Jobs recentes</span><small>últimos 10</small></div>
        @if (_dashboard.RecentJobs.Count == 0)
        {
            <p class="muted">Nenhum Job executado neste laboratório.</p>
        }
        else
        {
            @foreach (var job in _dashboard.RecentJobs)
            {
                <article class="farm-job">
                    <header>
                        <strong>@job.Workload // @ShortId(job.Id)</strong>
                        <div class="farm-job-actions">
                            <span class="@JobStatusClass(job.Status)">@JobStatusLabel(job.Status)</span>
                            @if (job.Evidence?.IsValid == true)
                            {
                                <a class="farm-evidence-download"
                                   href="@EvidenceUrl(job.Id)"
                                   download="@EvidenceFileName(job.Id)">
                                    Baixar evidência
                                </a>
                            }
                            @if (!IsEmbedded && CanCancel(job))
                            {
                                <button type="button"
                                        class="button-secondary"
                                        @onclick="() => CancelJobAsync(job.Id)"
                                        disabled="@_working">
                                    Cancelar
                                </button>
                            }
                            else if (job.CancellationRequestedAtUtc is not null && CanCancelStatus(job.Status))
                            {
                                <span class="amber">Cancelamento solicitado</span>
                            }
                        </div>
                    </header>
                    <dl>
                        <div><dt>VERSÃO</dt><dd>@job.WorkloadVersion</dd></div>
                        <div><dt>VERIFICAÇÃO</dt><dd>@job.VerificationPolicy</dd></div>
                        <div><dt>CP</dt><dd>@FormatCp(job.ComputeUnitsMilli)</dd></div>
                        <div><dt>DURAÇÃO</dt><dd>@(job.DurationMilliseconds is null ? "---" : $"{job.DurationMilliseconds} MS")</dd></div>
                        <div><dt>DIGEST</dt><dd>@(job.ResultDigest is null ? "---" : job.ResultDigest[..12])</dd></div>
                        <div><dt>PICO DE MEMÓRIA</dt><dd>@(job.WorkerPeakMemoryBytes is null ? "---" : FormatBytes(job.WorkerPeakMemoryBytes.Value))</dd></div>
                        <div><dt>CPU DO WORKER</dt><dd>@(job.WorkerProcessorTimeMilliseconds is null ? "---" : $"{job.WorkerProcessorTimeMilliseconds} MS")</dd></div>
                        <div><dt>CONTENÇÃO</dt><dd>@(job.WorkerEnforcement ?? "---")</dd></div>
                    </dl>
                    @if (job.AgentLeaseExpiresAtUtc is not null && CanCancelStatus(job.Status))
                    {
                        <p class="farm-manifest-legacy">
                            LEASE // RENOVADO ATÉ @job.AgentLeaseExpiresAtUtc.Value.ToLocalTime().ToString("HH:mm:ss")
                        </p>
                    }
                    @if (job.Manifest is null)
                    {
                        <p class="farm-manifest-legacy">MANIFESTO // JOB LEGADO SEM ASSINATURA</p>
                    }
                    else
                    {
                        <details class="farm-manifest">
                            <summary>
                                [ MANIFESTO @job.Manifest.Version //
                                <span class="@(job.Manifest.IsSignatureValid ? "green" : "error-text")">
                                    @(job.Manifest.IsSignatureValid ? "ASSINATURA VÁLIDA" : "ASSINATURA INVÁLIDA")
                                </span> ]
                            </summary>
                            <dl>
                                <div><dt>ATTEMPT</dt><dd>@ShortId(job.Manifest.AttemptId)</dd></div>
                                <div><dt>VALIDADE</dt><dd>@job.Manifest.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</dd></div>
                                <div><dt>TIMEOUT</dt><dd>@job.Manifest.TimeoutSeconds S</dd></div>
                                <div><dt>ITERATIONS</dt><dd>@job.Manifest.Iterations.ToString("N0")</dd></div>
                                <div><dt>CPU MÁX.</dt><dd>@job.Manifest.MaxLogicalProcessors</dd></div>
                                <div><dt>MEMÓRIA MÁX.</dt><dd>@FormatBytes(job.Manifest.MaxMemoryBytes)</dd></div>
                                <div><dt>REDE</dt><dd>@job.Manifest.NetworkPolicy</dd></div>
                                <div><dt>DADOS</dt><dd>@job.Manifest.DataClassification</dd></div>
                                <div><dt>PERFIL DO NODE</dt><dd title="@job.Manifest.NodeProfileHash">@(job.Manifest.NodeProfileHash is null ? "---" : ShortHash(job.Manifest.NodeProfileHash))</dd></div>
                                <div><dt>MANIFEST DIGEST</dt><dd title="@job.Manifest.Digest">@ShortHash(job.Manifest.Digest)</dd></div>
                                <div><dt>HMAC-SHA256</dt><dd title="@job.Manifest.Signature">@ShortHash(job.Manifest.Signature)</dd></div>
                            </dl>
                        </details>
                    }
                    @if (job.Status == FarmJobStatus.Completed && job.Evidence is null)
                    {
                        <p class="farm-manifest-legacy">EVIDÊNCIA // JOB LEGADO SEM BUNDLE</p>
                    }
                    else if (job.Evidence is not null)
                    {
                        <details class="farm-evidence">
                            <summary>
                                [ BUNDLE @job.Evidence.Version //
                                <span class="@(job.Evidence.IsValid ? "green" : "error-text")">
                                    @(job.Evidence.IsValid ? "INTEGRIDADE VÁLIDA" : "INTEGRIDADE INVÁLIDA")
                                </span> ]
                            </summary>
                            <dl>
                                <div><dt>ALGORITMO</dt><dd>@job.Evidence.Algorithm</dd></div>
                                <div><dt>KEY ID</dt><dd>@job.Evidence.KeyId</dd></div>
                                <div><dt>EMITIDO</dt><dd>@job.Evidence.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")</dd></div>
                                <div><dt>PAYLOAD DIGEST</dt><dd title="@job.Evidence.Digest">@ShortHash(job.Evidence.Digest)</dd></div>
                                <div><dt>ASSINATURA</dt><dd title="@job.Evidence.Signature">@ShortHash(job.Evidence.Signature)</dd></div>
                                <div><dt>HMAC DO BUNDLE</dt><dd class="@IntegrityClass(job.Evidence.Verification.SignatureValid)">@IntegrityLabel(job.Evidence.Verification.SignatureValid)</dd></div>
                                <div><dt>MANIFESTO</dt><dd class="@IntegrityClass(job.Evidence.Verification.ManifestValid)">@IntegrityLabel(job.Evidence.Verification.ManifestValid)</dd></div>
                                <div><dt>VÍNCULO DO JOB</dt><dd class="@IntegrityClass(job.Evidence.Verification.JobBindingValid)">@IntegrityLabel(job.Evidence.Verification.JobBindingValid)</dd></div>
                                <div><dt>LIFECYCLE</dt><dd class="@IntegrityClass(job.Evidence.Verification.LifecycleValid)">@IntegrityLabel(job.Evidence.Verification.LifecycleValid)</dd></div>
                            </dl>
                        </details>
                    }
                    <ol class="farm-job-events">
                        @foreach (var entry in job.Events)
                        {
                            <li>
                                <time>@entry.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                                <strong>@JobStatusLabel(entry.Status)</strong>
                                <span>@DisplayEventDetail(entry.Detail)</span>
                            </li>
                        }
                    </ol>
                </article>
            }
        }
    </section>
}

@code {
    private FarmDashboard? _dashboard;
    private bool _working;
    private string? _error;
    private FarmAgentEnrollment? _enrollment;
    private string _selectedWorkloadId = FarmWorkloadCatalog.DefaultId;
    private readonly CancellationTokenSource _pollCancellation = new();
    private Task? _pollTask;
    private bool IsOnline => _dashboard?.Node.Status == FarmNodeStatus.Online;
    private bool IsEmbedded => _dashboard?.Node.ConnectionKind == FarmNodeConnectionKind.Embedded;
    private bool CanAcceptJobs => _dashboard?.Node.AcceptJobs == true;
    private FarmWorkloadDefinition SelectedWorkload => FarmWorkloadCatalog.GetRequired(_selectedWorkloadId);

    private string FarmUrl => Navigation.BaseUri.TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _pollTask = PollDashboardAsync(_pollCancellation.Token);
    }

    private async Task PauseAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Paused);

    private async Task ResumeAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Online);

    private async Task ChangeStatusAsync(FarmNodeStatus status)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _dashboard = await FarmLab.SetNodeStatusAsync(status); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task ToggleNodeAsync(FarmNodeSnapshot node)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            var status = node.Status == FarmNodeStatus.Paused
                ? FarmNodeStatus.Online : FarmNodeStatus.Paused;
            _dashboard = await FarmLab.SetNodeStatusAsync(node.Id, status);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task ToggleSharingAsync(FarmNodeSnapshot node)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            _dashboard = await FarmLab.SetNodeSharingAsync(node.Id, !node.SharePlatformWork);
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task RunWorkloadAsync()
    {
        if (_working || !IsOnline) return;
        _working = true;
        _error = null;
        try
        {
            await FarmLab.RunWorkloadAsync(_selectedWorkloadId);
            _dashboard = await FarmLab.GetDashboardAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task CreateEnrollmentAsync()
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _enrollment = await FarmAgent.CreateEnrollmentAsync(); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task CancelJobAsync(Guid jobId)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _dashboard = await FarmLab.CancelJobAsync(jobId); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task ReloadAsync()
    {
        try { _dashboard = await FarmLab.GetDashboardAsync(); }
        catch (Exception exception) when (exception is InvalidOperationException)
        { _error = exception.Message; }
    }

    private async Task PollDashboardAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (_working) continue;
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _pollCancellation.CancelAsync();
        if (_pollTask is not null)
        {
            try { await _pollTask; }
            catch (OperationCanceledException) { }
        }
        _pollCancellation.Dispose();
    }

    private static string NodeStatusLabel(FarmNodeStatus status) => status switch
    {
        FarmNodeStatus.Online => "ONLINE",
        FarmNodeStatus.Paused => "PAUSADO",
        FarmNodeStatus.Offline => "OFFLINE",
        _ => status.ToString().ToUpperInvariant()
    };

    private static string ConnectionLabel(FarmNodeConnectionKind kind) =>
        kind == FarmNodeConnectionKind.Agent ? "AGENT" : "EMBEDDED";

    private static string VerificationLabel(FarmVerificationLevel level) =>
        level == FarmVerificationLevel.Verified ? "VERIFICADO" : "DETECTADO";

    private static string JobStatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Queued => "NA FILA",
        FarmJobStatus.Offered => "OFERECIDO",
        FarmJobStatus.Accepted => "ACEITO",
        FarmJobStatus.Running => "EXECUTANDO",
        FarmJobStatus.Uploading => "ENVIANDO",
        FarmJobStatus.Verifying => "VERIFICANDO",
        FarmJobStatus.Completed => "CONCLUÍDO",
        FarmJobStatus.Failed => "FALHOU",
        FarmJobStatus.Cancelled => "CANCELADO",
        FarmJobStatus.TimedOut => "TIMEOUT",
        FarmJobStatus.Rejected => "REJEITADO",
        _ => status.ToString().ToUpperInvariant()
    };

    private static string JobStatusClass(FarmJobStatus status) =>
        status == FarmJobStatus.Completed ? "green" :
        status is FarmJobStatus.Failed or FarmJobStatus.TimedOut ? "error-text" : "amber";

    private static string IntegrityLabel(bool valid) => valid ? "VÁLIDO" : "INVÁLIDO";
    private static string IntegrityClass(bool valid) => valid ? "green" : "error-text";

    private static bool CanCancel(FarmJobSnapshot job) =>
        job.CancellationRequestedAtUtc is null && CanCancelStatus(job.Status);

    private static bool CanCancelStatus(FarmJobStatus status) =>
        status is FarmJobStatus.Offered or FarmJobStatus.Accepted or FarmJobStatus.Running;

    private static string FormatCp(long milli) => $"{milli / 1000d:0.000} CP";
    private static string DisplayEventDetail(string detail) => detail
        .Replace(" CU ", " CP ", StringComparison.Ordinal)
        .Replace(" CU.", " CP.", StringComparison.Ordinal)
        .Replace(" CU,", " CP,", StringComparison.Ordinal);
    private static string ShortId(Guid id) => id.ToString("N")[..8];
    private static string EvidenceUrl(Guid jobId) => $"/api/farm/jobs/{jobId}/evidence";
    private static string EvidenceFileName(Guid jobId) => $"atos-farm-evidence-{jobId:N}.json";
    private static string ShortHash(string value) =>
        value.Length <= 16 ? value : $"{value[..12]}...{value[^4..]}";
    private static string FormatBytes(long bytes) =>
        bytes <= 0 ? "---" :
        bytes < 1024L * 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{bytes / 1024d / 1024d / 1024d:0.0} GB";
}
