@page "/farm"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab
@inject IFarmAgentService FarmAgent

<PageTitle>Compute Lab // atos AI Farm</PageTitle>

<div class="page-heading">
    <p class="eyebrow amber">atos:/FARM/COMPUTE_LAB</p>
    <h1>COMPUTE CONTROLADO</h1>
    <p>Benchmark determinístico em host conhecido. CU técnico experimental, sem emissão de AIC.</p>
</div>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}

@if (_dashboard is null)
{
    <section class="terminal placeholder">
        <div class="terminal-title">[ CONECTANDO AO NODE ]</div>
    </section>
}
else
{
    <section class="farm-node-panel">
        <header class="farm-node-header">
            <div>
                <span class="label">NODE</span>
                <strong>@_dashboard.Node.Name</strong>
            </div>
            <span class="status @(IsOnline ? null : "amber")">
                <span aria-hidden="true">●</span> @NodeStatusLabel(_dashboard.Node.Status)
            </span>
        </header>

        <div class="farm-metrics">
            <article>
                <span>VERIFICAÇÃO</span>
                <strong>@VerificationLabel(_dashboard.Node.VerificationLevel)</strong>
            </article>
            <article>
                <span>CPU LÓGICA</span>
                <strong>@_dashboard.Node.LogicalProcessors</strong>
            </article>
            <article>
                <span>MEMÓRIA DISPONÍVEL</span>
                <strong>@FormatBytes(_dashboard.Node.MemoryBytes)</strong>
            </article>
            <article>
                <span>CU VERIFICADO</span>
                <strong>@FormatCu(_dashboard.VerifiedComputeUnitsMilli)</strong>
            </article>
            <article>
                <span>CONEXÃO</span>
                <strong>@ConnectionLabel(_dashboard.Node.ConnectionKind)</strong>
            </article>
            <article>
                <span>POLÍTICA LOCAL</span>
                <strong class="@(CanAcceptJobs ? null : "amber")">@(CanAcceptJobs ? "ACEITANDO JOBS" : "PAUSADA")</strong>
            </article>
            <article>
                <span>CPU AUTORIZADA</span>
                <strong>@_dashboard.Node.AuthorizedLogicalProcessors</strong>
            </article>
            <article>
                <span>MEMÓRIA AUTORIZADA</span>
                <strong>@FormatBytes(_dashboard.Node.AuthorizedMemoryBytes)</strong>
            </article>
        </div>

        <p class="farm-runtime">
            @_dashboard.Node.Runtime
            @if (_dashboard.Node.ProfileVerifiedAtUtc is not null &&
                 _dashboard.Node.VerifiedProfileHash is not null)
            {
                <text> // PERFIL @_dashboard.Node.VerifiedProfileHash[..12] // VERIFICADO @_dashboard.Node.ProfileVerifiedAtUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")</text>
            }
            else
            {
                <text> // PERFIL AGUARDANDO BENCHMARK</text>
            }
        </p>

        <div class="farm-controls">
            @if (IsOnline && IsEmbedded)
            {
                <button type="button" class="button-secondary" @onclick="PauseAsync" disabled="@_working">[ PAUSAR NODE ]</button>
                <button type="button" @onclick="RunBenchmarkAsync" disabled="@_working">
                    @(_working ? "[ EXECUTANDO... ]" : "[ EXECUTAR BENCHMARK ]")
                </button>
            }
            else if (IsOnline)
            {
                <button type="button" class="button-secondary" @onclick="PauseAsync" disabled="@_working">[ PAUSAR AGENT ]</button>
                <button type="button" @onclick="RunBenchmarkAsync" disabled="@(_working || !CanAcceptJobs)">
                    @(!CanAcceptJobs ? "[ POLÍTICA LOCAL PAUSADA ]" : _working ? "[ DESPACHANDO... ]" : "[ DESPACHAR BENCHMARK ]")
                </button>
            }
            else if (_dashboard.Node.Status == FarmNodeStatus.Paused)
            {
                <button type="button" @onclick="ResumeAsync" disabled="@_working">[ RETOMAR NODE ]</button>
            }
            else
            {
                <button type="button" disabled>[ AGUARDANDO HEARTBEAT ]</button>
            }
        </div>
        <small class="classification-note">ALLOWLIST // SHA256_CHAIN V1 // LIMITES LOCAIS // SEM SHELL // SEM REDE // SEM AIC</small>
    </section>

    <section class="terminal farm-agent-panel">
        <div class="terminal-title">COMPUTE AGENT // VÍNCULO DA MÁQUINA</div>
        <p>
            @if (IsEmbedded)
            {
                <text>Modo EMBEDDED: o benchmark roda no mesmo host da aplicação. Gere um código para vincular um Agent separado.</text>
            }
            else
            {
                <text>Agent @_dashboard.Node.AgentVersion // último heartbeat @_dashboard.Node.LastSeenAtUtc.ToLocalTime().ToString("HH:mm:ss")</text>
            }
        </p>
        <button type="button" class="button-secondary" @onclick="CreateEnrollmentAsync" disabled="@_working">
            [ @(IsEmbedded ? "GERAR CÓDIGO DE VÍNCULO" : "ROTACIONAR CREDENCIAL") ]
        </button>
        @if (_enrollment is not null)
        {
            <div class="farm-enrollment-secret" role="status">
                <strong>CÓDIGO ÚNICO // EXPIRES @_enrollment.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</strong>
                <code>@_enrollment.Token</code>
                <small>Copie agora. O código não será exibido novamente e o anterior foi invalidado.</small>
            </div>
        }
    </section>

    <section class="terminal farm-jobs">
        <div class="terminal-title">JOBS RECENTES // ÚLTIMOS 10</div>
        @if (_dashboard.RecentJobs.Count == 0)
        {
            <p class="muted">Nenhum Job executado neste laboratório.</p>
        }
        else
        {
            @foreach (var job in _dashboard.RecentJobs)
            {
                <article class="farm-job">
                    <header>
                        <strong>@job.Workload // @ShortId(job.Id)</strong>
                        <div class="farm-job-actions">
                            <span class="@JobStatusClass(job.Status)">[ @JobStatusLabel(job.Status) ]</span>
                            @if (!IsEmbedded && CanCancel(job.Status))
                            {
                                <button type="button"
                                        class="button-secondary"
                                        @onclick="() => CancelJobAsync(job.Id)"
                                        disabled="@_working">
                                    [ CANCELAR ]
                                </button>
                            }
                        </div>
                    </header>
                    <dl>
                        <div><dt>VERSÃO</dt><dd>@job.WorkloadVersion</dd></div>
                        <div><dt>VERIFICAÇÃO</dt><dd>@job.VerificationPolicy</dd></div>
                        <div><dt>CU</dt><dd>@FormatCu(job.ComputeUnitsMilli)</dd></div>
                        <div><dt>DIGEST</dt><dd>@(job.ResultDigest is null ? "---" : job.ResultDigest[..12])</dd></div>
                    </dl>
                    @if (job.Manifest is null)
                    {
                        <p class="farm-manifest-legacy">MANIFESTO // JOB LEGADO SEM ASSINATURA</p>
                    }
                    else
                    {
                        <details class="farm-manifest">
                            <summary>
                                [ MANIFESTO @job.Manifest.Version //
                                <span class="@(job.Manifest.IsSignatureValid ? "green" : "error-text")">
                                    @(job.Manifest.IsSignatureValid ? "ASSINATURA VÁLIDA" : "ASSINATURA INVÁLIDA")
                                </span> ]
                            </summary>
                            <dl>
                                <div><dt>ATTEMPT</dt><dd>@ShortId(job.Manifest.AttemptId)</dd></div>
                                <div><dt>VALIDADE</dt><dd>@job.Manifest.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</dd></div>
                                <div><dt>TIMEOUT</dt><dd>@job.Manifest.TimeoutSeconds S</dd></div>
                                <div><dt>ITERATIONS</dt><dd>@job.Manifest.Iterations.ToString("N0")</dd></div>
                                <div><dt>CPU MÁX.</dt><dd>@job.Manifest.MaxLogicalProcessors</dd></div>
                                <div><dt>MEMÓRIA MÁX.</dt><dd>@FormatBytes(job.Manifest.MaxMemoryBytes)</dd></div>
                                <div><dt>REDE</dt><dd>@job.Manifest.NetworkPolicy</dd></div>
                                <div><dt>DADOS</dt><dd>@job.Manifest.DataClassification</dd></div>
                                <div><dt>PERFIL DO NODE</dt><dd title="@job.Manifest.NodeProfileHash">@(job.Manifest.NodeProfileHash is null ? "---" : ShortHash(job.Manifest.NodeProfileHash))</dd></div>
                                <div><dt>MANIFEST DIGEST</dt><dd title="@job.Manifest.Digest">@ShortHash(job.Manifest.Digest)</dd></div>
                                <div><dt>HMAC-SHA256</dt><dd title="@job.Manifest.Signature">@ShortHash(job.Manifest.Signature)</dd></div>
                            </dl>
                        </details>
                    }
                    <ol class="farm-job-events">
                        @foreach (var entry in job.Events)
                        {
                            <li>
                                <time>@entry.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</time>
                                <strong>@JobStatusLabel(entry.Status)</strong>
                                <span>@entry.Detail</span>
                            </li>
                        }
                    </ol>
                </article>
            }
        }
    </section>
}

@code {
    private FarmDashboard? _dashboard;
    private bool _working;
    private string? _error;
    private FarmAgentEnrollment? _enrollment;
    private bool IsOnline => _dashboard?.Node.Status == FarmNodeStatus.Online;
    private bool IsEmbedded => _dashboard?.Node.ConnectionKind == FarmNodeConnectionKind.Embedded;
    private bool CanAcceptJobs => _dashboard?.Node.AcceptJobs == true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task PauseAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Paused);

    private async Task ResumeAsync() =>
        await ChangeStatusAsync(FarmNodeStatus.Online);

    private async Task ChangeStatusAsync(FarmNodeStatus status)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _dashboard = await FarmLab.SetNodeStatusAsync(status); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task RunBenchmarkAsync()
    {
        if (_working || !IsOnline) return;
        _working = true;
        _error = null;
        try
        {
            await FarmLab.RunBenchmarkAsync();
            _dashboard = await FarmLab.GetDashboardAsync();
        }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task CreateEnrollmentAsync()
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _enrollment = await FarmAgent.CreateEnrollmentAsync(); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task CancelJobAsync(Guid jobId)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try { _dashboard = await FarmLab.CancelJobAsync(jobId); }
        catch (Exception exception) when (exception is InvalidOperationException or ArgumentException)
        { _error = exception.Message; }
        finally { _working = false; }
    }

    private async Task ReloadAsync()
    {
        try { _dashboard = await FarmLab.GetDashboardAsync(); }
        catch (Exception exception) when (exception is InvalidOperationException)
        { _error = exception.Message; }
    }

    private static string NodeStatusLabel(FarmNodeStatus status) => status switch
    {
        FarmNodeStatus.Online => "ONLINE",
        FarmNodeStatus.Paused => "PAUSADO",
        FarmNodeStatus.Offline => "OFFLINE",
        _ => status.ToString().ToUpperInvariant()
    };

    private static string ConnectionLabel(FarmNodeConnectionKind kind) =>
        kind == FarmNodeConnectionKind.Agent ? "AGENT" : "EMBEDDED";

    private static string VerificationLabel(FarmVerificationLevel level) =>
        level == FarmVerificationLevel.Verified ? "VERIFICADO" : "DETECTADO";

    private static string JobStatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Queued => "NA FILA",
        FarmJobStatus.Offered => "OFERECIDO",
        FarmJobStatus.Accepted => "ACEITO",
        FarmJobStatus.Running => "EXECUTANDO",
        FarmJobStatus.Uploading => "ENVIANDO",
        FarmJobStatus.Verifying => "VERIFICANDO",
        FarmJobStatus.Completed => "CONCLUÍDO",
        FarmJobStatus.Failed => "FALHOU",
        FarmJobStatus.Cancelled => "CANCELADO",
        FarmJobStatus.TimedOut => "TIMEOUT",
        FarmJobStatus.Rejected => "REJEITADO",
        _ => status.ToString().ToUpperInvariant()
    };

    private static string JobStatusClass(FarmJobStatus status) =>
        status == FarmJobStatus.Completed ? "green" :
        status is FarmJobStatus.Failed or FarmJobStatus.TimedOut ? "error-text" : "amber";

    private static bool CanCancel(FarmJobStatus status) =>
        status is FarmJobStatus.Offered or FarmJobStatus.Accepted or FarmJobStatus.Running;

    private static string FormatCu(long milli) => $"{milli / 1000d:0.000} CU";
    private static string ShortId(Guid id) => id.ToString("N")[..8];
    private static string ShortHash(string value) =>
        value.Length <= 16 ? value : $"{value[..12]}...{value[^4..]}";
    private static string FormatBytes(long bytes) =>
        bytes <= 0 ? "---" : $"{bytes / 1024d / 1024d / 1024d:0.0} GB";
}
