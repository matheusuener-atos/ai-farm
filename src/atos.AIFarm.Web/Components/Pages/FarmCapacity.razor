@page "/farm/capacity"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject IFarmCapacityQuery Capacity

<PageTitle>Capacidade // atos AI Farm</PageTitle>

<div class="page-head">
    <p class="eyebrow amber">atos:/FARM/CAPACITY_MATRIX</p>
    <h1>Capacidade do pool</h1>
    <p>Admissão real por CPU, memória, política local, heartbeat, versão do Agent e ocupação atual.</p>
    <a class="text-link" href="/farm/demands">Abrir fila de demandas →</a>
</div>

@if (_dashboard is null)
{
    <p>CALCULANDO CAPACIDADE...</p>
}
else
{
    <section class="capacity-summary">
        <div><small>NODES</small><strong>@_dashboard.Nodes.Count</strong></div>
        <div><small>ACEITANDO</small><strong>@_dashboard.Nodes.Count(x => x.EligibleWorkloadCount > 0)</strong></div>
        <div><small>EM USO</small><strong>@_dashboard.Nodes.Count(x => x.Busy)</strong></div>
        <div><small>QUARENTENA</small><strong>@_dashboard.Nodes.Count(x => x.Reliability?.IsQuarantined == true)</strong></div>
        <div><small>NA FILA</small><strong>@_dashboard.QueuedDemandCount</strong></div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Admissão por workload</h2><span>@_dashboard.CalculatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span></div>
        <div class="workload-grid">
            @foreach (var workload in _dashboard.Workloads)
            {
                <article class="workload-card">
                    <div><strong>@workload.DisplayName</strong><small>@workload.WorkloadVersion</small></div>
                    <span class="@(workload.EligibleNodeCount > 0 ? "green" : "error")">@workload.EligibleNodeCount NODE(S) ELEGÍVEL(IS)</span>
                    <small>REQUER @workload.RequiredLogicalProcessors CPU // @FormatBytes(workload.RequiredMemoryBytes)</small>
                    @if (workload.BlockedNodes.Count > 0)
                    {
                        <small>BLOQUEIOS // @string.Join(" // ", workload.BlockedNodes.Select(x => $"{Blocker(x.Key)} {x.Value}"))</small>
                    }
                </article>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Matriz dos nodes</h2><button class="button-secondary" @onclick="LoadAsync">Atualizar</button></div>
        @foreach (var item in _dashboard.Nodes)
        {
            <article class="node-capacity">
                <header>
                    <div><strong>@item.Node.Name</strong><small>@item.Node.ConnectionKind // @item.Node.AgentVersion</small></div>
                    <span class="@(item.Reliability?.IsQuarantined == true ? "error" : item.EligibleWorkloadCount > 0 ? "green" : item.Busy ? "amber" : "error")">@(item.Reliability?.IsQuarantined == true ? "QUARENTENA" : item.EligibleWorkloadCount > 0 ? "ACEITANDO" : item.Busy ? "SATURADO" : "BLOQUEADO")</span>
                </header>
                <div class="resource-bars">
                    <div><small>CPU AUTORIZADA</small><strong>@item.AvailableLogicalProcessors / @item.Node.AuthorizedLogicalProcessors</strong></div>
                    <div><small>MEMÓRIA AUTORIZADA</small><strong>@FormatBytes(item.AvailableMemoryBytes) / @FormatBytes(item.Node.AuthorizedMemoryBytes)</strong></div>
                    <div><small>JOBS ATIVOS</small><strong>@item.ActiveJobCount</strong></div>
                    <div><small>HEARTBEAT</small><strong>@(item.Node.IsHeartbeatFresh ? "ATUAL" : "EXPIRADO")</strong></div>
                    <div><small>CONFIABILIDADE</small><strong>@(item.Reliability?.Score ?? 80) / 100</strong></div>
                </div>
                @if (item.Reliability is { } reliability)
                {
                    <div class="reliability-strip @(reliability.IsQuarantined ? "quarantined" : null)">
                        <span>FAIXA <strong>@ReliabilityBand(reliability.Band)</strong></span>
                        <span>AMOSTRA <strong>@reliability.SampleSize</strong></span>
                        <span>APROVADOS <strong>@reliability.SuccessfulJobs</strong></span>
                        <span>FALHAS <strong>@reliability.FailedJobs</strong></span>
                        <span>SEQUÊNCIA DE FALHAS <strong>@reliability.ConsecutiveFailures</strong></span>
                        @if (reliability.IsQuarantined)
                        {
                            <span>RETORNO <strong>@reliability.QuarantinedUntilUtc?.ToLocalTime().ToString("dd/MM HH:mm")</strong></span>
                        }
                    </div>
                }
                <div class="compatibility-row">
                    @foreach (var workload in item.Workloads)
                    {
                        <span class="@(workload.Eligible ? "eligible" : "blocked")">@workload.WorkloadId // @(workload.Eligible ? "OK" : Blocker(workload.Blocker))</span>
                    }
                </div>
            </article>
        }
    </section>
}

@code {
    private FarmCapacityDashboard? _dashboard;
    private readonly CancellationTokenSource _pollCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task LoadAsync() => _dashboard = await Capacity.GetAsync();

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    public ValueTask DisposeAsync() { _pollCancellation.Cancel(); _pollCancellation.Dispose(); return ValueTask.CompletedTask; }
    private static string FormatBytes(long bytes) => bytes <= 0 ? "0" : $"{bytes / 1024d / 1024d:N0} MiB";
    private static string Blocker(FarmCapacityBlocker value) => value switch
    {
        FarmCapacityBlocker.EmbeddedSuppressed => "EMBEDDED SUPRIMIDO",
        FarmCapacityBlocker.Paused => "PAUSADO",
        FarmCapacityBlocker.Offline => "OFFLINE",
        FarmCapacityBlocker.StaleHeartbeat => "HEARTBEAT",
        FarmCapacityBlocker.JobsDisabled => "POLÍTICA LOCAL",
        FarmCapacityBlocker.Quarantined => "QUARENTENA",
        FarmCapacityBlocker.AgentVersionMismatch => "VERSÃO",
        FarmCapacityBlocker.InsufficientProcessors => "CPU",
        FarmCapacityBlocker.InsufficientMemory => "MEMÓRIA",
        FarmCapacityBlocker.Busy => "OCUPADO",
        _ => "OK"
    };

    private static string ReliabilityBand(FarmNodeReliabilityBand value) => value switch
    {
        FarmNodeReliabilityBand.Unproven => "SEM HISTÓRICO",
        FarmNodeReliabilityBand.Watch => "OBSERVAÇÃO",
        FarmNodeReliabilityBand.Stable => "ESTÁVEL",
        FarmNodeReliabilityBand.Trusted => "CONFIÁVEL",
        FarmNodeReliabilityBand.Quarantined => "QUARENTENA",
        _ => value.ToString().ToUpperInvariant()
    };
}
