@page "/farm/capacity"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IAsyncDisposable
@inject IFarmCapacityQuery Capacity

<PageTitle>Capacidade // atos AI Farm</PageTitle>

@if (_dashboard is null)
{
    <p class="muted">Calculando capacidade…</p>
}
else
{
    <div style="display: flex; justify-content: flex-end">
        <a class="text-link" href="/farm/demands" style="margin: 0">Abrir fila de trabalho →</a>
    </div>
    <div class="jobs-kpis" style="grid-template-columns: repeat(5, minmax(0, 1fr))">
        <section class="kpi"><span>Máquinas</span><strong>@_dashboard.Nodes.Count</strong></section>
        <section class="kpi kpi-green"><span>Aceitando</span><strong>@_dashboard.Nodes.Count(x => x.EligibleWorkloadCount > 0)</strong></section>
        <section class="kpi kpi-amber"><span>Em uso</span><strong>@_dashboard.Nodes.Count(x => x.Busy)</strong></section>
        <section class="kpi"><span>Em pausa forçada</span><strong>@_dashboard.Nodes.Count(x => x.Reliability?.IsQuarantined == true)</strong></section>
        <section class="kpi"><span>Na fila</span><strong>@_dashboard.QueuedDemandCount</strong></section>
    </div>

    <section class="panel">
        <div class="panel-head"><h2>Quem pode fazer cada tipo de tarefa</h2></div>
        <div class="pool-grid" style="padding: 14px 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))">
            @foreach (var workload in _dashboard.Workloads)
            {
                <article class="pool-card" style="min-height: 0; color: #111111; font-size: 13px; font-weight: 400; text-transform: none; letter-spacing: 0">
                    <header><b>@workload.DisplayName</b></header>
                    <p class="pool-state">@workload.WorkloadVersion</p>
                    <p class="pool-state @(workload.EligibleNodeCount > 0 ? "on" : null)" style="margin: 0">@workload.EligibleNodeCount MÁQUINA(S) @(workload.EligibleNodeCount == 1 ? "PODE" : "PODEM")</p>
                    <footer>
                        <span class="muted" style="font-size: 11px">Precisa de @workload.RequiredLogicalProcessors CPU · @FormatBytes(workload.RequiredMemoryBytes)</span>
                        @if (workload.BlockedNodes.Count > 0)
                        {
                            <span class="amber" style="font-size: 11px; font-weight: 600">Impedimentos · @string.Join(" · ", workload.BlockedNodes.Select(x => $"{Blocker(x.Key)} {x.Value}"))</span>
                        }
                    </footer>
                </article>
            }
        </div>
        <p class="muted" style="margin: 0 16px 12px; font-size: 11.5px; text-align: right">calculado às @_dashboard.CalculatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</p>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Situação de cada máquina</h2></div>
        @foreach (var item in _dashboard.Nodes)
        {
            <article class="node-capacity" style="margin: 14px 16px; padding: 0; border: 1.5px solid #111111; background: #FFFFFF; box-shadow: 3px 3px 0 #111111">
                <header style="display: flex; align-items: center; gap: 12px; margin: 0; padding: 10px 16px; border-bottom: 1.5px solid #111111; background: #F4F1EA">
                    <strong style="font-size: 13px">@item.Node.Name</strong>
                    <small class="muted">@item.Node.ConnectionKind · @item.Node.AgentVersion</small>
                    <span class="@(item.Reliability?.IsQuarantined == true ? "error-text" : item.EligibleWorkloadCount > 0 ? "green" : item.Busy ? "amber" : "error-text")" style="margin-left: auto; font-size: 12px; font-weight: 600">@(item.Reliability?.IsQuarantined == true ? "PAUSA FORÇADA" : item.EligibleWorkloadCount > 0 ? "ACEITANDO" : item.Busy ? "SATURADO" : "BLOQUEADO")</span>
                </header>
                <div style="display: flex; flex-direction: column; gap: 12px; padding: 12px 16px">
                    <div class="resource-bars">
                        <div><small>CPU LIVRE</small><strong>@item.AvailableLogicalProcessors / @item.Node.AuthorizedLogicalProcessors</strong></div>
                        <div><small>MEMÓRIA LIVRE</small><strong>@FormatBytes(item.AvailableMemoryBytes) / @FormatBytes(item.Node.AuthorizedMemoryBytes)</strong></div>
                        <div><small>TAREFAS AGORA</small><strong>@item.ActiveJobCount</strong></div>
                        <div><small>SINAL DE VIDA</small><strong>@(item.Node.IsHeartbeatFresh ? "ATUAL" : "EXPIRADO")</strong></div>
                        <div><small>CONFIANÇA</small><strong>@(item.Reliability?.Score ?? 80) / 100</strong></div>
                    </div>
                    @if (item.Reliability is { } reliability)
                    {
                        <div class="reliability-strip @(reliability.IsQuarantined ? "quarantined" : null)">
                            <span>FAIXA <strong>@ReliabilityBand(reliability.Band)</strong></span>
                            <span>ÚLTIMAS TAREFAS <strong>@reliability.SampleSize</strong></span>
                            <span>DERAM CERTO <strong>@reliability.SuccessfulJobs</strong></span>
                            <span>FALHARAM <strong>@reliability.FailedJobs</strong></span>
                            <span>FALHAS SEGUIDAS <strong>@reliability.ConsecutiveFailures</strong></span>
                            @if (reliability.IsQuarantined)
                            {
                                <span>RETORNO <strong>@reliability.QuarantinedUntilUtc?.ToLocalTime().ToString("dd/MM HH:mm")</strong></span>
                            }
                        </div>
                    }
                    <div class="compatibility-row">
                        @foreach (var workload in item.Workloads)
                        {
                            <span class="@(workload.Eligible ? "eligible" : "blocked")">@workload.WorkloadId · @(workload.Eligible ? "OK" : Blocker(workload.Blocker))</span>
                        }
                    </div>
                </div>
            </article>
        }
        <footer style="display: flex; justify-content: flex-end; padding: 12px 16px; border-top: 1px solid var(--line)">
            <button class="btn primary" type="button" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync">Atualizar</button>
        </footer>
    </section>
}

@code {
    private FarmCapacityDashboard? _dashboard;
    private readonly CancellationTokenSource _pollCancellation = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollAsync(_pollCancellation.Token);
    }

    private async Task LoadAsync() => _dashboard = await Capacity.GetAsync();

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    public ValueTask DisposeAsync() { _pollCancellation.Cancel(); _pollCancellation.Dispose(); return ValueTask.CompletedTask; }
    private static string FormatBytes(long bytes) => bytes <= 0 ? "0" : $"{bytes / 1024d / 1024d:N0} MiB";
    private static string Blocker(FarmCapacityBlocker value) => value switch
    {
        FarmCapacityBlocker.EmbeddedSuppressed => "MODO EMBUTIDO",
        FarmCapacityBlocker.Paused => "PAUSADO",
        FarmCapacityBlocker.Offline => "DESLIGADA",
        FarmCapacityBlocker.StaleHeartbeat => "SEM SINAL",
        FarmCapacityBlocker.JobsDisabled => "POLÍTICA LOCAL",
        FarmCapacityBlocker.Quarantined => "PAUSA FORÇADA",
        FarmCapacityBlocker.AgentVersionMismatch => "VERSÃO",
        FarmCapacityBlocker.InsufficientProcessors => "CPU",
        FarmCapacityBlocker.InsufficientMemory => "MEMÓRIA",
        FarmCapacityBlocker.Busy => "OCUPADO",
        _ => "OK"
    };

    private static string ReliabilityBand(FarmNodeReliabilityBand value) => value switch
    {
        FarmNodeReliabilityBand.Unproven => "SEM HISTÓRICO",
        FarmNodeReliabilityBand.Watch => "OBSERVAÇÃO",
        FarmNodeReliabilityBand.Stable => "ESTÁVEL",
        FarmNodeReliabilityBand.Trusted => "CONFIÁVEL",
        FarmNodeReliabilityBand.Quarantined => "PAUSA FORÇADA",
        _ => value.ToString().ToUpperInvariant()
    };
}
