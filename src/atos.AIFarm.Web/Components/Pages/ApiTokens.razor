@page "/account/api-tokens"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IApiTokenService Tokens
@inject IJSRuntime JavaScript

<PageTitle>Chaves de acesso // atos AI Farm</PageTitle>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_createdSecret is not null)
{
    <section class="token-secret" role="status">
        <strong>Copie agora — a chave não será mostrada de novo</strong>
        <div style="display: flex; align-items: center; gap: 12px">
            <code style="margin-right: auto">@_createdSecret</code>
            <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="DismissSecret">Já guardei</button>
            <button type="button" class="btn primary" style="box-shadow: 2px 2px 0 #111111" @onclick="CopySecretAsync">Copiar chave</button>
        </div>
    </section>
}

<section class="panel token-create">
    <div class="panel-head"><h2>Criar chave</h2></div>
    <div class="token-form">
        <label>Nome
            <input maxlength="80" @bind="_name" placeholder="ex.: painel interno da equipe" disabled="@_working" />
        </label>
        <label>Validade
            <select @bind="_validityDays" disabled="@_working">
                <option value="30">30 dias</option>
                <option value="90">90 dias</option>
                <option value="180">180 dias</option>
                <option value="365">365 dias</option>
            </select>
        </label>
    </div>
    <fieldset class="token-scopes">
        <legend>O que a chave pode LER</legend>
        <label><input type="checkbox" @bind="_profileRead" /> PERFIL <small>dados da conta</small></label>
        <label><input type="checkbox" @bind="_usageRead" /> USO <small>respostas e custos</small></label>
        <label><input type="checkbox" @bind="_incidentsRead" /> ALERTAS <small>ocorrências da conta</small></label>
        <label><input type="checkbox" @bind="_auditRead" /> REGISTROS <small>trilha de auditoria</small></label>
        <label><input type="checkbox" @bind="_conversationsRead" /> CONVERSAS <small>histórico do chat</small></label>
        <label><input type="checkbox" @bind="_farmRead" /> FARM <small>tarefas e capacidade</small></label>
    </fieldset>
    <fieldset class="token-scopes">
        <legend>O que a chave pode FAZER</legend>
        <label><input type="checkbox" @bind="_irisExecute" /> USAR A IRIS <small>pode gastar créditos</small></label>
        <label><input type="checkbox" @bind="_farmExecute" /> USAR A FARM <small>enviar e cancelar tarefas</small></label>
        <label><input type="checkbox" @bind="_walletCredit" /> CREDITAR CARTEIRA <small>administrativo</small></label>
        <p class="muted">Atenção: "usar a Iris" pode gastar créditos da conta. "Usar a farm" ocupa suas máquinas; pontos só viram créditos quando a política de recompensas está ativa.</p>
    </fieldset>
    <div style="display: flex; align-items: center; gap: 12px; padding: 0 16px 14px">
        <small class="muted" style="margin-right: auto">Marque só as permissões que a integração realmente precisa.</small>
        <button type="button" @onclick="CreateAsync" disabled="@_working">
            @(_working ? "Criando..." : "Criar chave")
        </button>
    </div>
</section>

<section class="panel token-list">
    <div class="panel-head">
        <h2>Chaves da conta</h2>
    </div>
    @if (_loading)
    {
        <p class="muted" style="padding: 14px 16px; margin: 0">Carregando…</p>
    }
    else if (_tokens.Count == 0)
    {
        <p class="muted" style="padding: 14px 16px; margin: 0">Nenhuma chave criada.</p>
    }
    else
    {
        @foreach (var token in _tokens)
        {
            <article style="margin: 14px 16px 0; padding: 0; border: 1.5px solid #111111; background: #FFFFFF; box-shadow: 3px 3px 0 #111111">
                <header style="display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-bottom: 1.5px solid #111111; background: #F4F1EA">
                    <strong style="font-size: 13px; white-space: nowrap; flex-shrink: 0">@token.Name</strong>
                    <code>@token.Prefix…</code>
                    <span class="@StatusClass(token)" style="margin-left: auto; font-size: 12px; font-weight: 600">@Status(token)</span>
                </header>
                <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 12px 16px; border: 1.5px solid #111111">
                    <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">Permissões</span><br /><strong>@FormatScopes(token.Scopes)</strong></div>
                    <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">Criada</span><br /><strong>@token.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</strong></div>
                    <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">Expira</span><br /><strong>@token.ExpiresAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</strong></div>
                    <div style="padding: 8px 10px"><span class="label" style="font-size: 9px">Último uso</span><br /><strong>@(token.LastUsedAtUtc?.ToString("dd/MM/yyyy HH:mm 'UTC'") ?? "NUNCA")</strong></div>
                </div>
                @if (!token.IsRevoked && !token.IsExpired(DateTimeOffset.UtcNow))
                {
                    <footer style="display: flex; justify-content: flex-end; padding: 0 16px 14px">
                        <button type="button" class="danger-button" style="box-shadow: 2px 2px 0 #111111" @onclick="() => RevokeAsync(token.Id)" disabled="@_working">Cortar acesso</button>
                    </footer>
                }
            </article>
        }
    }
    <footer style="display: flex; justify-content: flex-end; padding: 12px 16px; border-top: 1px solid var(--line); margin-top: 14px">
        <button type="button" class="btn primary" style="box-shadow: 2px 2px 0 #111111" @onclick="LoadAsync" disabled="@_working">Atualizar</button>
    </footer>
</section>

@code {
    private IReadOnlyList<ApiTokenSnapshot> _tokens = [];
    private string _name = string.Empty;
    private int _validityDays = 90;
    private bool _profileRead = true;
    private bool _usageRead = true;
    private bool _incidentsRead;
    private bool _auditRead;
    private bool _conversationsRead;
    private bool _farmRead;
    private bool _farmExecute;
    private bool _irisExecute;
    private bool _walletCredit;
    private bool _loading = true;
    private bool _working;
    private string? _createdSecret;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _tokens = await Tokens.ListAsync(); }
        catch (Exception) { _error = "Não foi possível carregar as chaves da conta."; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        _working = true;
        _error = null;
        try
        {
            var created = await Tokens.CreateAsync(new ApiTokenCreateRequest(
                _name, SelectedScopes(), DateTimeOffset.UtcNow.AddDays(_validityDays)));
            _createdSecret = created.Secret;
            _name = string.Empty;
            await LoadAsync();
        }
        catch (ArgumentException exception) { _error = exception.Message; }
        catch (Exception) { _error = "Não foi possível criar a chave."; }
        finally { _working = false; }
    }

    private async Task RevokeAsync(Guid id)
    {
        _working = true;
        _error = null;
        try { await Tokens.RevokeAsync(id); await LoadAsync(); }
        catch (Exception) { _error = "Não foi possível cortar o acesso desta chave."; }
        finally { _working = false; }
    }

    private ApiTokenScope SelectedScopes() =>
        (_profileRead ? ApiTokenScope.ProfileRead : 0) |
        (_usageRead ? ApiTokenScope.UsageRead : 0) |
        (_incidentsRead ? ApiTokenScope.IncidentsRead : 0) |
        (_auditRead ? ApiTokenScope.AuditRead : 0) |
        (_conversationsRead ? ApiTokenScope.ConversationsRead : 0) |
        (_farmRead ? ApiTokenScope.FarmRead : 0) |
        (_farmExecute ? ApiTokenScope.FarmExecute : 0) |
        (_irisExecute ? ApiTokenScope.IrisExecute : 0) |
        (_walletCredit ? ApiTokenScope.WalletCredit : 0);

    private async Task CopySecretAsync()
    {
        if (_createdSecret is not null)
            await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", _createdSecret);
    }
    private void DismissSecret() => _createdSecret = null;
    private static string Status(ApiTokenSnapshot token) => token.IsRevoked ? "CORTADA" : token.IsExpired(DateTimeOffset.UtcNow) ? "EXPIRADA" : "ATIVA";
    private static string StatusClass(ApiTokenSnapshot token) => token.IsRevoked || token.IsExpired(DateTimeOffset.UtcNow) ? "muted" : "green";
    private static string ScopeLabel(ApiTokenScope scope) => scope switch
    {
        ApiTokenScope.ProfileRead => "PERFIL",
        ApiTokenScope.UsageRead => "USO",
        ApiTokenScope.IncidentsRead => "ALERTAS",
        ApiTokenScope.AuditRead => "REGISTROS",
        ApiTokenScope.ConversationsRead => "CONVERSAS",
        ApiTokenScope.FarmRead => "FARM",
        ApiTokenScope.FarmExecute => "USAR FARM",
        ApiTokenScope.IrisExecute => "USAR IRIS",
        ApiTokenScope.WalletCredit => "CREDITAR",
        _ => scope.ToString().ToUpperInvariant()
    };
    private static string FormatScopes(ApiTokenScope scopes) => string.Join(" · ", Enum.GetValues<ApiTokenScope>()
        .Where(x => x is not ApiTokenScope.None and not ApiTokenScope.AllRead and not ApiTokenScope.All && scopes.HasFlag(x))
        .Select(ScopeLabel));
}
