@page "/pool/{NodeId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab

<PageTitle>Computador da pool // atos AI Farm</PageTitle>

@if (_node is null)
{
    <div>
        <h1 style="margin: 0; font-size: 18px">@(_loaded ? "Computador não encontrado" : "Carregando…")</h1>
        @if (_loaded)
        {
            <p class="muted">Este assento não existe mais nesta conta. <a href="/meu-computador">Voltar à pool</a></p>
        }
    </div>
}
else
{
    <div style="display: flex; align-items: center; gap: 12px; border: 1.5px solid #111111; background: #F4F1EA; box-shadow: 3px 3px 0 #111111; padding: 10px 16px">
        <strong style="font-size: 13px">@_node.Name</strong>
        <small class="muted">@(_node.ConnectionKind == FarmNodeConnectionKind.Agent ? "programa instalado" : "embutida no servidor")</small>
        <span class="@(_node.Status == FarmNodeStatus.Online ? "green" : "amber")" style="margin-left: auto; font-size: 12px; font-weight: 600">
            @(_node.PendingConfirmation
                ? "AGUARDANDO CONFIRMAÇÃO"
                : _node.Status == FarmNodeStatus.Online ? "ENTREGANDO PODER" : _node.Status == FarmNodeStatus.Paused ? "PAUSADA" : "DESLIGADA")
        </span>
    </div>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <section class="win">
        <div class="win-title"><span>Identidade técnica</span></div>
        <div class="win-body">
            <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1.5px solid #111111">
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111; border-bottom: 1.5px solid #111111"><span class="label" style="font-size: 9px">CPU</span><br /><strong>@_node.LogicalProcessors núcleos</strong> <small class="muted">(@_node.AuthorizedLogicalProcessors liberados)</small></div>
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111; border-bottom: 1.5px solid #111111"><span class="label" style="font-size: 9px">MEMÓRIA</span><br /><strong>@((_node.MemoryBytes / 1024d / 1024 / 1024).ToString("0.0")) GB</strong> <small class="muted">(@((_node.AuthorizedMemoryBytes / 1024d / 1024).ToString("N0")) MB liberados)</small></div>
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111; border-bottom: 1.5px solid #111111"><span class="label" style="font-size: 9px">USO AGORA</span><br /><strong>@(_node.LiveWorkerCpuPercent is double cpu ? $"{cpu:0}% · {(_node.LiveWorkerMemoryBytes ?? 0) / 1024d / 1024:0.0} MB" : "—")</strong></div>
                <div style="padding: 8px 10px; border-bottom: 1.5px solid #111111"><span class="label" style="font-size: 9px">CP TOTAL</span><br /><strong>@((_node.LifetimeComputeUnitsMilli / 1000d).ToString("N0")) CP</strong></div>
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">VERSÃO</span><br /><strong>@(_node.AgentVersion ?? "—")</strong></div>
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">PERFIL</span><br /><strong>@(_node.VerificationLevel == FarmVerificationLevel.Verified ? "VERIFICADO" : "DETECTADO")</strong></div>
                <div style="padding: 8px 10px; border-right: 1.5px solid #111111"><span class="label" style="font-size: 9px">VISTO POR ÚLTIMO</span><br /><strong>@_node.LastSeenAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong></div>
                <div style="padding: 8px 10px"><span class="label" style="font-size: 9px">PLATAFORMA</span><br /><strong>@(_node.SharePlatformWork ? "ajudando quando ociosa" : "só esta conta")</strong></div>
            </div>
            <p class="muted" style="margin: 10px 0 0">Sistema: @_node.Runtime</p>
        </div>
    </section>

    <section class="win">
        <div class="win-title"><span>Últimos trabalhos desta máquina</span></div>
        <div class="win-body">
            @if (_jobs.Count == 0)
            {
                <p class="muted">Nenhum trabalho registrado ainda.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr><th>QUANDO</th><th>WORKLOAD</th><th>STATUS</th><th>CP</th><th>DURAÇÃO</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _jobs)
                            {
                                <tr>
                                    <td>@job.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                                    <td>@job.WorkloadVersion</td>
                                    <td>@StatusLabel(job.Status)</td>
                                    <td>@((job.ComputeUnitsMilli / 1000d).ToString("0.###"))</td>
                                    <td>@(job.DurationMilliseconds is long duration ? $"{duration} ms" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; margin-top: 10px">
                <a class="btn" href="/meu-computador" style="box-shadow: 2px 2px 0 #111111">← Voltar à pool</a>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid NodeId { get; set; }

    private FarmNodeSnapshot? _node;
    private IReadOnlyList<FarmJobSnapshot> _jobs = [];
    private bool _loaded;
    private string? _error;

    private static string StatusLabel(FarmJobStatus status) => status switch
    {
        FarmJobStatus.Queued => "NA FILA",
        FarmJobStatus.Running => "EXECUTANDO",
        FarmJobStatus.Verifying => "VERIFICANDO",
        FarmJobStatus.Completed => "CONCLUÍDA",
        FarmJobStatus.Failed => "FALHOU",
        FarmJobStatus.Cancelled => "CANCELADA",
        FarmJobStatus.TimedOut => "TEMPO ESGOTADO",
        _ => status.ToString().ToUpperInvariant()
    };

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var dashboard = await FarmLab.GetDashboardAsync();
            _node = dashboard.Nodes.FirstOrDefault(x => x.Id == NodeId);
            _jobs = _node is null ? [] : await FarmLab.GetNodeJobsAsync(NodeId);
            _error = null;
        }
        catch (Exception)
        {
            _error = "Não foi possível carregar este computador agora.";
        }
        finally
        {
            _loaded = true;
        }
    }
}
