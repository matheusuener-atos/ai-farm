@page "/farm/economy"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab
@inject IFarmEconomicsScenarioStore ScenarioStore

<PageTitle>Economia da Farm // atos AI Farm</PageTitle>

<div class="page-heading">
    <p class="eyebrow amber">atos:/FARM/ECONOMIA</p>
    <h1>ECONOMIA SOB TESTE</h1>
    <p>Simule se o valor de um workload pode financiar energia, operação, risco, margem e recompensa.</p>
</div>

<section class="economics-warning" role="note">
    <strong>[ SIMULAÇÃO // NÃO FINANCEIRO ]</strong>
    <span>Nenhum cenário cria AIC, altera a Wallet ou define uma conversão CU → AIC.</span>
</section>

@if (_benchmark is null)
{
    <section class="benchmark-source unavailable">
        <strong>[ MEDIÇÃO INDISPONÍVEL ]</strong>
        <span>Execute um benchmark concluído no Compute Lab para substituir a capacidade informada manualmente.</span>
    </section>
}
else
{
    <section class="benchmark-source">
        <div>
            <strong>[ ÚLTIMO BENCHMARK // @ShortId(_benchmark.JobId) ]</strong>
            <span>@Number(_benchmark.ComputeUnitsPerHour) CU/H // @_benchmark.DurationMilliseconds MS // @_benchmark.FinishedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
            <small>EVIDÊNCIA @(_benchmark.HasValidEvidence ? "VÁLIDA" : "LEGADA OU INDISPONÍVEL") // NODE @_benchmark.NodeName</small>
        </div>
        <button type="button" class="button-secondary" @onclick="UseLatestBenchmark">[ USAR MEDIÇÃO ]</button>
    </section>
}

<section class="terminal economics-inputs">
    <div class="terminal-title">PARÂMETROS DO CENÁRIO</div>
    <div class="economics-form">
        <label>HORAS DISPONÍVEIS / MÊS<InputNumber @bind-Value="_scenario.MonthlyAvailableHours" min="0.01" step="1" /></label>
        <label>POTÊNCIA MÉDIA / W<InputNumber @bind-Value="_scenario.PowerWatts" min="0.01" step="1" /></label>
        <label>ENERGIA / R$ POR KWH<InputNumber @bind-Value="_scenario.ElectricityCostPerKwh" min="0" step="0.01" /></label>
        <label>CAPACIDADE / CU POR HORA<InputNumber @bind-Value="_scenario.ComputeUnitsPerHour" min="0.01" step="1" /></label>
        <label>UTILIZAÇÃO / %<InputNumber @bind-Value="_scenario.UtilizationPercent" min="0" max="100" step="1" /></label>
        <label>SUCESSO DOS JOBS / %<InputNumber @bind-Value="_scenario.SuccessPercent" min="0" max="100" step="1" /></label>
        <label>VALOR BRUTO / R$ POR 1.000 CU<InputNumber @bind-Value="_scenario.GrossValuePerThousandCu" min="0" step="0.01" /></label>
        <label>VERIFICAÇÃO / % DA RECEITA<InputNumber @bind-Value="_scenario.VerificationCostPercent" min="0" max="100" step="1" /></label>
        <label>PLATAFORMA / % DA RECEITA<InputNumber @bind-Value="_scenario.PlatformCostPercent" min="0" max="100" step="1" /></label>
        <label>IMPOSTOS E TAXAS / %<InputNumber @bind-Value="_scenario.TaxesAndFeesPercent" min="0" max="100" step="1" /></label>
        <label>MARGEM NECESSÁRIA / %<InputNumber @bind-Value="_scenario.MarginPercent" min="0" max="100" step="1" /></label>
        <label>RESERVA DE RISCO / %<InputNumber @bind-Value="_scenario.RiskReservePercent" min="0" max="100" step="1" /></label>
    </div>
    <div class="economics-actions">
        <button type="button" @onclick="Calculate">[ CALCULAR CENÁRIO ]</button>
        <button type="button" class="button-secondary" @onclick="Reset">[ RESTAURAR EXEMPLO ]</button>
    </div>
    <div class="economics-save">
        <label>
            NOME DA FOTOGRAFIA
            <input @bind="_scenarioName" maxlength="80" placeholder="ex.: BASE GPU DOMÉSTICA" />
        </label>
        <button type="button" @onclick="SaveScenarioAsync" disabled="@(_saving || _result is null)">
            @(_saving ? "[ SALVANDO... ]" : "[ SALVAR FOTOGRAFIA ]")
        </button>
        @if (_notice is not null)
        {
            <span role="status">@_notice</span>
        }
    </div>
</section>

@if (_error is not null)
{
    <div class="error" role="alert">@_error</div>
}
else if (_result is not null)
{
    <section class="economics-result @(_result.IsEconomicallyViable ? "viable" : "unviable")" aria-live="polite">
        <header>
            <div>
                <span>RESULTADO DO CENÁRIO</span>
                <strong>@(_result.IsEconomicallyViable ? "ECONOMICAMENTE POSSÍVEL" : "NÃO FINANCIA REWARD")</strong>
            </div>
            <span class="@(_result.IsEconomicallyViable ? "green" : "error-text")">
                [ @(_result.IsEconomicallyViable ? "VIÁVEL" : "DÉFICIT") ]
            </span>
        </header>
        <div class="economics-summary">
            <article><span>CU TENTADO</span><strong>@Number(_result.AttemptedComputeUnits)</strong></article>
            <article><span>CU VERIFICADO</span><strong>@Number(_result.VerifiedComputeUnits)</strong></article>
            <article><span>VALOR ECONÔMICO BRUTO</span><strong>@Money(_result.GrossEconomicValue)</strong></article>
            <article><span>REWARD MÁXIMO FINANCIADO</span><strong>@Money(_result.MaximumFundedReward)</strong></article>
            <article><span>TETO / 1.000 CU</span><strong>@Money(_result.MaximumRewardPerThousandCu)</strong></article>
            <article><span>DÉFICIT</span><strong>@Money(_result.FundingGap)</strong></article>
            <article><span>PONTO DE EQUILÍBRIO / 1.000 CU</span><strong>@BreakEven(_result.BreakEvenGrossValuePerThousandCu)</strong></article>
        </div>
    </section>

    <section class="terminal economics-breakdown">
        <div class="terminal-title">COMPOSIÇÃO // RASTREÁVEL</div>
        <dl>
            <div><dt>HORAS EFETIVAS</dt><dd>@Number(_result.EffectiveHours) H</dd></div>
            <div><dt>ENERGIA</dt><dd>@Number(_result.EnergyKwh) KWH // @Money(_result.EnergyCost)</dd></div>
            <div><dt>PERDA POR FALHAS</dt><dd>@Money(_result.FailureLoss)</dd></div>
            <div><dt>VERIFICAÇÃO</dt><dd>@Money(_result.VerificationCost)</dd></div>
            <div><dt>PLATAFORMA</dt><dd>@Money(_result.PlatformCost)</dd></div>
            <div><dt>IMPOSTOS E TAXAS</dt><dd>@Money(_result.TaxesAndFees)</dd></div>
            <div><dt>MARGEM</dt><dd>@Money(_result.RequiredMargin)</dd></div>
            <div><dt>RESERVA DE RISCO</dt><dd>@Money(_result.RiskReserve)</dd></div>
        </dl>
        <p>REWARD MÁXIMO = VALOR VERIFICADO − ENERGIA − VERIFICAÇÃO − PLATAFORMA − TAXAS − MARGEM − RISCO</p>
    </section>

    <section class="terminal economics-sensitivity">
        <div class="terminal-title">SENSIBILIDADE // NÃO É PREVISÃO</div>
        <div class="sensitivity-notice">
            STRESS: energia +20%, valor −20%, utilização ×0,75 e sucesso −10 p.p. //
            FAVORÁVEL: energia −10%, valor +10%, utilização ×1,15 e sucesso +3 p.p.
        </div>
        <div class="sensitivity-grid">
            @foreach (var projection in _projections)
            {
                <article>
                    <header>
                        <strong>@ProjectionLabel(projection.Kind)</strong>
                        <span class="@(projection.Result.IsEconomicallyViable ? "green" : "error-text")">
                            @(projection.Result.IsEconomicallyViable ? "VIÁVEL" : "DÉFICIT")
                        </span>
                    </header>
                    <dl>
                        <div><dt>UTILIZAÇÃO</dt><dd>@Number(projection.Scenario.UtilizationPercent)%</dd></div>
                        <div><dt>SUCESSO</dt><dd>@Number(projection.Scenario.SuccessPercent)%</dd></div>
                        <div><dt>VALOR / 1K CU</dt><dd>@Money(projection.Scenario.GrossValuePerThousandCu)</dd></div>
                        <div><dt>REWARD MÁX.</dt><dd>@Money(projection.Result.MaximumFundedReward)</dd></div>
                        <div><dt>DÉFICIT</dt><dd>@Money(projection.Result.FundingGap)</dd></div>
                    </dl>
                </article>
            }
        </div>
    </section>
}

<section class="terminal economics-history">
    <div class="terminal-title">HISTÓRICO IMUTÁVEL // ÚLTIMOS 10</div>
    @if (_savedScenarios.Count == 0)
    {
        <p class="muted">Nenhuma fotografia econômica salva nesta conta.</p>
    }
    else
    {
        @foreach (var saved in _savedScenarios)
        {
            <article>
                <header>
                    <div>
                        <strong>@saved.Name</strong>
                        <small>@saved.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") // @saved.Version</small>
                    </div>
                    <span class="@(saved.IsIntegrityValid ? "green" : "error-text")">
                        [ @(saved.IsIntegrityValid ? "ÍNTEGRO" : "INVÁLIDO") ]
                    </span>
                </header>
                <dl>
                    <div><dt>CU/H</dt><dd>@Number(saved.Scenario.ComputeUnitsPerHour)</dd></div>
                    <div><dt>VALOR / 1K CU</dt><dd>@Money(saved.Scenario.GrossValuePerThousandCu)</dd></div>
                    <div><dt>REWARD MÁX.</dt><dd>@Money(saved.Result.MaximumFundedReward)</dd></div>
                    <div><dt>DÉFICIT</dt><dd>@Money(saved.Result.FundingGap)</dd></div>
                    <div><dt>BENCHMARK</dt><dd>@(saved.SourceJobId is null ? "MANUAL" : ShortId(saved.SourceJobId.Value))</dd></div>
                    <div><dt>DIGEST</dt><dd title="@saved.Digest">@ShortHash(saved.Digest)</dd></div>
                </dl>
                <button type="button" class="button-secondary" @onclick="() => LoadScenario(saved)" disabled="@(!saved.IsIntegrityValid)">
                    [ CARREGAR CENÁRIO ]
                </button>
            </article>
        }
    }
</section>

<a class="text-link" href="/farm">← VOLTAR AO COMPUTE LAB</a>

@code {
    private FarmEconomicsInput _scenario = FarmEconomicsInput.Example();
    private FarmEconomicsResult? _result;
    private IReadOnlyList<FarmEconomicsProjection> _projections = [];
    private IReadOnlyList<FarmEconomicsScenarioSnapshot> _savedScenarios = [];
    private BenchmarkMeasurement? _benchmark;
    private string? _error;
    private string? _notice;
    private string _scenarioName = "CENÁRIO BASE";
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        Calculate();
        try
        {
            var dashboard = await FarmLab.GetDashboardAsync();
            var job = dashboard.RecentJobs
                .Where(job => job.Status == FarmJobStatus.Completed &&
                              job.DurationMilliseconds > 0 &&
                              job.ComputeUnitsMilli > 0)
                .OrderByDescending(job => job.FinishedAtUtc)
                .FirstOrDefault();
            if (job is not null)
            {
                var cuPerHour = job.ComputeUnitsMilli / 1_000m * 3_600_000m / job.DurationMilliseconds!.Value;
                _benchmark = new BenchmarkMeasurement(
                    job.Id, dashboard.Node.Name, cuPerHour,
                    job.DurationMilliseconds.Value, job.FinishedAtUtc ?? job.CreatedAtUtc,
                    job.Evidence?.IsValid == true);
            }
        }
        catch (InvalidOperationException)
        {
            _benchmark = null;
        }

        try { _savedScenarios = await ScenarioStore.ListAsync(); }
        catch (InvalidOperationException exception) { _error = exception.Message; }
    }

    private void Calculate()
    {
        _error = null;
        try
        {
            _projections = FarmEconomicsCalculator.Analyze(_scenario.ToScenario());
            _result = _projections.Single(x => x.Kind == FarmEconomicsProjectionKind.Baseline).Result;
        }
        catch (ArgumentOutOfRangeException exception)
        {
            _result = null;
            _projections = [];
            _error = exception.Message.Split(" (Parameter", StringSplitOptions.None)[0];
        }
    }

    private void Reset()
    {
        _scenario = FarmEconomicsInput.Example();
        Calculate();
    }

    private async Task SaveScenarioAsync()
    {
        if (_saving || _result is null) return;
        _saving = true;
        _error = null;
        _notice = null;
        try
        {
            var sourceJobId = CurrentBenchmarkSourceJobId();
            var saved = await ScenarioStore.SaveAsync(_scenarioName, _scenario.ToScenario(), sourceJobId);
            _savedScenarios = [saved, .. _savedScenarios.Where(x => x.Id != saved.Id).Take(9)];
            _notice = $"FOTOGRAFIA {ShortId(saved.Id)} SALVA // DIGEST {ShortHash(saved.Digest)}";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _error = exception.Message.Split(" (Parameter", StringSplitOptions.None)[0];
        }
        finally { _saving = false; }
    }

    private void LoadScenario(FarmEconomicsScenarioSnapshot saved)
    {
        if (!saved.IsIntegrityValid) return;
        _scenario = FarmEconomicsInput.FromScenario(saved.Scenario);
        _scenarioName = $"{saved.Name} // CÓPIA";
        _notice = $"CENÁRIO {ShortId(saved.Id)} CARREGADO; SALVAR CRIARÁ NOVA FOTOGRAFIA.";
        Calculate();
    }

    private Guid? CurrentBenchmarkSourceJobId()
    {
        if (_benchmark is null) return null;
        var measured = decimal.Round(_benchmark.ComputeUnitsPerHour, 2);
        return _scenario.ComputeUnitsPerHour == measured ? _benchmark.JobId : null;
    }

    private void UseLatestBenchmark()
    {
        if (_benchmark is null) return;
        _scenario.ComputeUnitsPerHour = decimal.Round(_benchmark.ComputeUnitsPerHour, 2);
        Calculate();
    }

    private static string Money(decimal value) => $"R$ {value:N2}";
    private static string Number(decimal value) => value.ToString("N2");
    private static string BreakEven(decimal? value) => value is null ? "INDETERMINADO" : Money(value.Value);
    private static string ShortId(Guid id) => id.ToString("N")[..8];
    private static string ShortHash(string value) => value.Length <= 16 ? value : $"{value[..12]}...{value[^4..]}";
    private static string ProjectionLabel(FarmEconomicsProjectionKind kind) => kind switch
    {
        FarmEconomicsProjectionKind.Stress => "STRESS",
        FarmEconomicsProjectionKind.Baseline => "BASE",
        FarmEconomicsProjectionKind.Favorable => "FAVORÁVEL",
        _ => kind.ToString().ToUpperInvariant()
    };

    private sealed record BenchmarkMeasurement(
        Guid JobId,
        string NodeName,
        decimal ComputeUnitsPerHour,
        long DurationMilliseconds,
        DateTimeOffset FinishedAtUtc,
        bool HasValidEvidence);

    private sealed class FarmEconomicsInput
    {
        public decimal MonthlyAvailableHours { get; set; }
        public decimal PowerWatts { get; set; }
        public decimal ElectricityCostPerKwh { get; set; }
        public decimal ComputeUnitsPerHour { get; set; }
        public decimal UtilizationPercent { get; set; }
        public decimal SuccessPercent { get; set; }
        public decimal GrossValuePerThousandCu { get; set; }
        public decimal VerificationCostPercent { get; set; }
        public decimal PlatformCostPercent { get; set; }
        public decimal TaxesAndFeesPercent { get; set; }
        public decimal MarginPercent { get; set; }
        public decimal RiskReservePercent { get; set; }

        public FarmEconomicsScenario ToScenario() => new(
            MonthlyAvailableHours, PowerWatts, ElectricityCostPerKwh,
            ComputeUnitsPerHour, UtilizationPercent, SuccessPercent,
            GrossValuePerThousandCu, VerificationCostPercent, PlatformCostPercent,
            TaxesAndFeesPercent, MarginPercent, RiskReservePercent);

        public static FarmEconomicsInput Example() => new()
        {
            MonthlyAvailableHours = 100m,
            PowerWatts = 120m,
            ElectricityCostPerKwh = 0.95m,
            ComputeUnitsPerHour = 1_000m,
            UtilizationPercent = 35m,
            SuccessPercent = 95m,
            GrossValuePerThousandCu = 0.50m,
            VerificationCostPercent = 10m,
            PlatformCostPercent = 10m,
            TaxesAndFeesPercent = 8m,
            MarginPercent = 15m,
            RiskReservePercent = 5m
        };

        public static FarmEconomicsInput FromScenario(FarmEconomicsScenario scenario) => new()
        {
            MonthlyAvailableHours = scenario.MonthlyAvailableHours,
            PowerWatts = scenario.PowerWatts,
            ElectricityCostPerKwh = scenario.ElectricityCostPerKwh,
            ComputeUnitsPerHour = scenario.ComputeUnitsPerHour,
            UtilizationPercent = scenario.UtilizationPercent,
            SuccessPercent = scenario.SuccessPercent,
            GrossValuePerThousandCu = scenario.GrossValuePerThousandCu,
            VerificationCostPercent = scenario.VerificationCostPercent,
            PlatformCostPercent = scenario.PlatformCostPercent,
            TaxesAndFeesPercent = scenario.TaxesAndFeesPercent,
            MarginPercent = scenario.MarginPercent,
            RiskReservePercent = scenario.RiskReservePercent
        };
    }
}
