@page "/meu-computador"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IFarmLabService FarmLab
@inject IFarmAgentService FarmAgent
@inject IContinuousFarmModeService ContinuousFarm
@inject NavigationManager Navigation

<PageTitle>Meu computador // atos AI Farm</PageTitle>

<div class="page-head">
    <p class="eyebrow">atos:/MEU_COMPUTADOR</p>
    <h1>Meu computador</h1>
    <p>ELE TRABALHA // O SISTEMA CONFERE // VOCÊ ACOMPANHA</p>
</div>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
@if (_notice is not null)
{
    <p class="muted">@_notice</p>
}

<div class="home-lite">
    <section class="win" aria-label="Situação">
        <div class="win-title"><span>Situação agora</span></div>
        <div class="win-body home-node">
            @if (_farm is null)
            {
                <p class="muted">Verificando…</p>
            }
            else
            {
                <div class="home-node-head">
                    <span class="dot @(_farm.Node.Status == FarmNodeStatus.Online ? "orange blink" : "hollow")" aria-hidden="true"></span>
                    <b>@(_farm.Node.Status == FarmNodeStatus.Online ? "Pronto para trabalhar" : "Parado agora")</b>
                    <span class="muted">· @_farm.Node.Name</span>
                    <button class="btn" type="button" @onclick="RunTaskAsync" disabled="@(_working || _farm.Node.Status != FarmNodeStatus.Online)">
                        @(_working ? "Trabalhando…" : "Fazer uma tarefa agora")
                    </button>
                </div>
                <div class="home-stats">
                    <div>
                        <span class="label">Pontos de trabalho</span>
                        <strong>@($"{_farm.VerifiedComputeUnitsMilli / 1000d:0.###}")</strong>
                        <span class="muted">conferidos um a um pelo sistema</span>
                    </div>
                    <div>
                        <span class="label">Tarefas concluídas</span>
                        <strong>@_farm.RecentJobs.Count(x => x.Status == FarmJobStatus.Completed)</strong>
                        <span class="muted">entre as mais recentes</span>
                    </div>
                    <div>
                        <span class="label">Computadores ligados</span>
                        <strong>@_farm.Nodes.Count</strong>
                        <span class="muted">nesta conta</span>
                    </div>
                </div>
                <p class="muted">
                    Cada tarefa roda isolada, sem acessar seus arquivos nem a internet,
                    e o resultado é conferido antes de valer ponto. Pontos de trabalho
                    viram créditos pela política de recompensas — o resgate fica em
                    Recompensas, no modo completo.
                </p>
                <div class="home-node-head continuous-toggle">
                    <span class="dot @(_continuousEnabled ? "orange" : "hollow")" aria-hidden="true"></span>
                    <b>Farm contínua</b>
                    <span class="muted">· @(_continuousEnabled ? "consumindo o poder autorizado sempre que houver máquina ociosa" : "só trabalha quando alguém pede")</span>
                    <button class="btn @(_continuousEnabled ? null : "primary")" type="button" @onclick="ToggleContinuousAsync" disabled="@_working">
                        @(_continuousEnabled ? "Desativar" : "Ativar consumo contínuo")
                    </button>
                </div>
                <p class="muted">
                    Com a farm contínua, um computador ocioso recebe na hora uma tarefa
                    de consumo (SHA-256 Marathon, 20 pontos) — no ritmo definido pela
                    plataforma — e o gráfico de desempenho da janela do programa mostra
                    o poder sendo entregue.
                </p>
            }
        </div>
    </section>

    <section class="win" aria-label="Pool de computadores">
        <div class="win-title"><span>Pool de computadores</span><span>um assento por máquina</span></div>
        <div class="win-body">
            <div class="pool-grid">
                @if (_farm is not null)
                {
                    @foreach (var node in _farm.Nodes.Where(x => x.ConnectionKind == FarmNodeConnectionKind.Agent))
                    {
                        <article class="pool-card @(node.PendingConfirmation ? "pending" : node.Status == FarmNodeStatus.Online ? "online" : "offline")">
                            <header>
                                <span class="dot @(node.PendingConfirmation ? "hollow" : node.Status == FarmNodeStatus.Online ? "orange blink" : "hollow")" aria-hidden="true"></span>
                                <b>@node.Name</b>
                            </header>
                            @if (node.PendingConfirmation)
                            {
                                <p class="pool-state">AGUARDANDO CONFIRMAÇÃO</p>
                                <p class="muted">Digite a chave exibida na janela do programa daquela máquina.</p>
                                <input class="pool-confirm-input" placeholder="XXXX-XXXX" maxlength="9"
                                       value="@ConfirmDraft(node.Id)"
                                       @oninput="e => _confirmDrafts[node.Id] = e.Value?.ToString() ?? string.Empty"
                                       disabled="@_working" />
                                <button class="btn primary" type="button" @onclick="() => ConfirmAsync(node)" disabled="@_working">Confirmar</button>
                            }
                            else if (node.Status == FarmNodeStatus.Online)
                            {
                                <p class="pool-state on">@(node.LiveWorkerCpuPercent is > 1 ? "ENTREGANDO PODER" : "OCIOSO // PRONTO")</p>
                                <svg class="pool-spark" viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true">
                                    <polyline points="@SparkPoints(node.Id)" />
                                </svg>
                                <dl class="pool-facts">
                                    <div><dt>USO AGORA</dt><dd>@((node.LiveWorkerCpuPercent ?? 0).ToString("0"))%</dd></div>
                                    <div><dt>CP TOTAL</dt><dd>@((node.LifetimeComputeUnitsMilli / 1000d).ToString("N0"))</dd></div>
                                </dl>
                            }
                            else
                            {
                                <p class="pool-state">DESLIGADA</p>
                                <dl class="pool-facts">
                                    <div><dt>CPU</dt><dd>@node.LogicalProcessors núcleos</dd></div>
                                    <div><dt>MEMÓRIA</dt><dd>@((node.MemoryBytes / 1024d / 1024 / 1024).ToString("0.0")) GB</dd></div>
                                    <div><dt>CP TOTAL</dt><dd>@((node.LifetimeComputeUnitsMilli / 1000d).ToString("N0"))</dd></div>
                                    <div><dt>VISTO</dt><dd>@node.LastSeenAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</dd></div>
                                </dl>
                            }
                            <footer>
                                <a class="pool-detail-link" href="/pool/@node.Id">Detalhes →</a>
                                <button class="pool-remove" type="button" @onclick="() => RemoveAsync(node)" disabled="@_working">
                                    @(_removalArmedNodeId == node.Id ? "Confirmar exclusão?" : "Excluir da rede")
                                </button>
                            </footer>
                        </article>
                    }
                }
                <article class="pool-card pool-seat">
                    @if (_enrollment is null)
                    {
                        <button class="pool-seat-add" type="button" @onclick="CreateCodeAsync" disabled="@_working">
                            <span class="pool-seat-plus">+</span>
                            Adicionar um computador
                        </button>
                        <p class="muted">Gera o código deste assento. Cada chave aparece uma única vez.</p>
                    }
                    else
                    {
                        <p class="pool-state">ASSENTO ABERTO // CÓDIGO VALE ATÉ @_enrollment.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</p>
                        <code class="pool-code">@_enrollment.Token</code>
                        <ol class="lite-steps">
                            <li><a href="/downloads/atos-compute-agent-win-x64.exe" download="atos-compute-agent-win-x64.exe">Baixe o programa</a> na máquina nova e dê dois cliques.</li>
                            <li>Na janela: endereço <code>@FarmUrl</code>, o e-mail desta conta e o código acima.</li>
                            <li>A máquina mostra uma <b>chave de confirmação</b> — digite aqui no card dela para liberar o trabalho.</li>
                        </ol>
                    }
                </article>
            </div>
            <p class="muted lite-footnote">
                Chaves nunca são reexibidas: se perder uma, exclua a máquina da rede e
                adicione de novo. Ao ajudar a plataforma, os pontos continuam sendo seus.
            </p>
        </div>
    </section>
</div>

@code {
    private FarmDashboard? _farm;
    private FarmAgentEnrollment? _enrollment;
    private bool _working;
    private bool _continuousEnabled;
    private string? _error;
    private string? _notice;
    private readonly Dictionary<Guid, string> _confirmDrafts = [];
    private Guid? _removalArmedNodeId;

    private string FarmUrl => Navigation.BaseUri.TrimEnd('/');

    private string ConfirmDraft(Guid nodeId) =>
        _confirmDrafts.TryGetValue(nodeId, out var draft) ? draft : string.Empty;

    private string SparkPoints(Guid nodeId)
    {
        if (_farm?.NodeCpSeries is null ||
            !_farm.NodeCpSeries.TryGetValue(nodeId, out var series) ||
            series.Count == 0)
            return "0,33 120,33";
        var peak = Math.Max(1, series.Max());
        return string.Join(" ", series.Select((value, index) =>
            $"{index * 120d / Math.Max(1, series.Count - 1):0.#},{33 - value * 30d / peak:0.#}"));
    }

    private async Task ConfirmAsync(FarmNodeSnapshot node)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            _farm = await FarmLab.ConfirmNodeAsync(node.Id, ConfirmDraft(node.Id));
            _confirmDrafts.Remove(node.Id);
            _notice = $"{node.Name} confirmado! Ele já pode receber trabalho.";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task RemoveAsync(FarmNodeSnapshot node)
    {
        if (_working) return;
        if (_removalArmedNodeId != node.Id)
        {
            _removalArmedNodeId = node.Id;
            return;
        }
        _working = true;
        _error = null;
        _removalArmedNodeId = null;
        try
        {
            _farm = await FarmLab.RemoveNodeAsync(node.Id);
            _notice = $"{node.Name} foi excluído da rede. O assento ficou livre — para voltar, adicione a máquina de novo.";
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _farm = await FarmLab.GetDashboardAsync();
            _continuousEnabled = await ContinuousFarm.GetAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "Não foi possível verificar seu computador agora. Tente de novo em instantes.";
        }
    }

    private async Task ToggleContinuousAsync()
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            await ContinuousFarm.SetAsync(!_continuousEnabled);
            _continuousEnabled = !_continuousEnabled;
        }
        catch (Exception)
        {
            _error = "Não foi possível mudar a farm contínua agora. Tente de novo em instantes.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task RunTaskAsync()
    {
        _working = true;
        _error = null;
        _notice = null;
        try
        {
            var job = await FarmLab.RunBenchmarkAsync();
            _notice = job.Status == FarmJobStatus.Completed
                ? $"Pronto! Seu computador fez uma tarefa e ganhou {job.ComputeUnitsMilli / 1000d:0.###} ponto(s) de trabalho."
                : "A tarefa foi enviada. Acompanhe a situação nesta tela.";
            await ReloadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "A tarefa não pôde ser feita agora. Tente de novo em instantes.";
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ToggleShareAsync(FarmNodeSnapshot node)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            _farm = await FarmLab.SetNodeSharingAsync(node.Id, !node.SharePlatformWork);
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task CreateCodeAsync()
    {
        _working = true;
        _error = null;
        try
        {
            _enrollment = await FarmAgent.CreateEnrollmentAsync();
        }
        catch (Exception)
        {
            _error = "Não foi possível gerar o código agora. Tente de novo em instantes.";
        }
        finally
        {
            _working = false;
        }
    }
}
