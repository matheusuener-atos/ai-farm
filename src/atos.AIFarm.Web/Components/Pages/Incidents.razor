@page "/incidents"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IOperationalIncidentService IncidentService

<PageTitle>Alertas // atos AI Farm</PageTitle>

@if (_error is not null) { <div class="error" role="alert">@_error</div> }
@if (_notice is not null) { <div class="incident-notice" role="status">@_notice</div> }

<section class="panel">
    <header class="panel-head"><h2>Filtros</h2></header>
    <form class="incident-filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <label>Buscar<input type="search" maxlength="120" placeholder="código, título, detalhe ou referência" @bind="_search" /></label>
        <label>Gravidade<select @bind="_severity"><option value="">Todas</option><option value="Critical">Crítico</option><option value="Warning">Alerta</option></select></label>
        <label>Período<select @bind="_windowDays"><option value="1">Últimas 24h</option><option value="7">Últimos 7 dias</option><option value="30">Últimos 30 dias</option></select></label>
        <label class="incident-check"><InputCheckbox @bind-Value="_openOnly" /> Só os ainda não vistos</label>
        <button type="button" class="button-secondary" style="box-shadow: 2px 2px 0 #111111" @onclick="ClearAsync" disabled="@_loading">Limpar</button>
        <button type="submit" style="box-shadow: 2px 2px 0 #111111" disabled="@_loading">Aplicar</button>
    </form>
</section>

@if (_loading && _dashboard is null)
{
    <section class="terminal placeholder"><div class="terminal-title"><span>Juntando os sinais</span></div></section>
}
else if (_dashboard is not null)
{
    <section class="kpi-grid cols-5">
        <article class="kpi"><span>Total no período</span><strong>@_dashboard.Total</strong><small>todas as fontes</small></article>
        <article class="kpi @(_dashboard.Open == 0 ? "kpi-green" : "kpi-red")"><span>Em aberto</span><strong>@_dashboard.Open</strong><small>aguardando você ver</small></article>
        <article class="kpi kpi-red"><span>Críticos</span><strong>@_dashboard.Critical</strong><small>exigem prioridade</small></article>
        <article class="kpi kpi-amber"><span>Alertas</span><strong>@_dashboard.Warning</strong><small>vale conferir</small></article>
        <article class="kpi kpi-purple"><span>Já vistos</span><strong>@_dashboard.Acknowledged</strong><small>ficam registrados</small></article>
    </section>

    <p class="muted">
        Período (UTC) @_dashboard.FromUtc.ToString("dd/MM HH:mm") — @_dashboard.ToUtc.ToString("dd/MM HH:mm") · o estado das máquinas é avaliado agora
    </p>
    @if (_dashboard.IsTruncated)
    {
        <div class="incident-notice" role="status">
            Uma ou mais fontes atingiram o limite desta janela. A lista está cortada — reduza o período para ver tudo.
        </div>
    }

    <section class="incident-list" aria-live="polite">
        @if (_dashboard.Incidents.Count == 0)
        {
            <div class="incident-clear"><strong>Nenhum alerta no filtro</strong><span>Os sinais monitorados não produziram ocorrências.</span></div>
        }
        @foreach (var incident in _dashboard.Incidents)
        {
            <article class="incident-card @SeverityClass(incident.Severity) @(incident.IsAcknowledged ? "acknowledged" : null)">
                <header>
                    <div><span class="incident-severity">@SeverityLabel(incident.Severity)</span><span class="incident-source">@SourceLabel(incident.Source)</span></div>
                    <time datetime="@incident.DetectedAtUtc.ToString("O")">UTC @incident.DetectedAtUtc.ToString("dd/MM/yyyy HH:mm:ss")</time>
                </header>
                <div class="incident-body">
                    <div><small>@incident.Code · ref @incident.Reference</small><h2>@incident.Title</h2><p>@incident.Detail</p></div>
                    @if (incident.IsAcknowledged)
                    {
                        <span class="incident-ack">VISTO · @incident.AcknowledgedAtUtc!.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    }
                    else
                    {
                        <button type="button" style="box-shadow: 2px 2px 0 #111111" @onclick="() => AcknowledgeAsync(incident)" disabled="@_working">Marcar como visto</button>
                    }
                </div>
            </article>
        }
    </section>
    <div style="display: flex; justify-content: flex-end">
        <a class="text-link" href="/audit" style="margin: 0">Abrir registro de tudo →</a>
    </div>
}

@code {
    private IncidentDashboard? _dashboard;
    private string _search = string.Empty;
    private string _severity = string.Empty;
    private int _windowDays = IncidentQuery.DefaultWindowDays;
    private bool _openOnly;
    private bool _loading;
    private bool _working;
    private string? _error;
    private string? _notice;

    protected override Task OnInitializedAsync() => LoadAsync();
    private Task ApplyAsync() => LoadAsync();
    private async Task ClearAsync() { _search = _severity = string.Empty; _openOnly = false; _windowDays = IncidentQuery.DefaultWindowDays; await LoadAsync(); }

    private async Task AcknowledgeAsync(OperationalIncidentSnapshot incident)
    {
        if (_working) return;
        _working = true; _error = null; _notice = null;
        try
        {
            if (!await IncidentService.AcknowledgeAsync(incident.Key)) { _error = "O alerta não está mais disponível."; return; }
            _notice = $"Alerta {incident.Reference} marcado como visto — a evidência original foi preservada.";
            await LoadAsync(clearNotice: false);
        }
        catch (Exception) { _error = "Não foi possível marcar o alerta como visto."; }
        finally { _working = false; }
    }

    private async Task LoadAsync(bool clearNotice = true)
    {
        _loading = true; _error = null; if (clearNotice) _notice = null;
        try
        {
            var severity = Enum.TryParse<IncidentSeverity>(_severity, out var parsed) ? parsed : (IncidentSeverity?)null;
            _dashboard = await IncidentService.SearchAsync(new IncidentQuery(
                _search,
                severity,
                _openOnly,
                DateTimeOffset.UtcNow.AddDays(-_windowDays)));
        }
        catch (ArgumentException exception) { _error = exception.Message; }
        catch (Exception) { _error = "Não foi possível carregar os alertas."; }
        finally { _loading = false; }
    }

    private static string SeverityLabel(IncidentSeverity value) => value == IncidentSeverity.Critical ? "CRÍTICO" : "ALERTA";
    private static string SeverityClass(IncidentSeverity value) => value == IncidentSeverity.Critical ? "critical" : "warning";
    private static string SourceLabel(IncidentSource value) => value switch { IncidentSource.Integrity => "INTEGRIDADE", IncidentSource.Iris => "IRIS", IncidentSource.Farm => "FARM", IncidentSource.Node => "MÁQUINA", _ => value.ToString().ToUpperInvariant() };
}
