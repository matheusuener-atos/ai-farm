{
  "ConnectionStrings": {
    "AIFarm": ""
  },
  "AIFarm": {
    "AI": {
      "Provider": "Fake",
      "OpenAI": {
        // Snapshot ativo da Responses API (lançado em 2026-03-17), conferido em
        // 2026-09-03 contra https://developers.openai.com/api/docs/pricing:
        // US$ 0,75/1M tokens de entrada e US$ 4,50/1M de saída. Com o peg
        // 1 AIC = US$ 0,001 (1 mAIC = US$ 0,000001), isso dá 750.000 e
        // 4.500.000 mAIC por milhão de tokens. Ao trocar o modelo ou o preço,
        // versione PriceCatalogVersion e atualize PriceSource.
        "Model": "gpt-5.4-mini-2026-03-17",
        "PriceCatalogVersion": "openai-gpt-5.4-mini-2026-03-17-aic-v1",
        "InputCostPerMillionMinor": 750000,
        "OutputCostPerMillionMinor": 4500000,
        "MaximumOutputTokens": 512,
        "PriceSource": "https://developers.openai.com/api/docs/pricing (2026-09-03)"
      },
      // Teto de segurança por conta e por dia UTC, em mAIC, aplicado somente
      // quando o Provider real está ativo (50.000 mAIC = 50 AIC ≈ US$ 0,05/dia).
      "DailySafetyCapMinor": 50000
    },
    "Execution": {
      "MaximumPromptCharacters": 12000,
      "MaximumCostPerRequestMinor": 100000,
      "ProviderTimeoutSeconds": 30,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerOpenSeconds": 30
    },
    "Context": {
      "DefaultMessageCount": 16,
      "MaximumMessageCount": 32,
      "MaximumInputTokens": 32000,
      "SummaryTokenBudget": 2000
    },
    "Farm": {
      "Reliability": {
        "SampleSize": 20,
        "PriorSuccesses": 4,
        "PriorFailures": 1,
        "ConsecutiveFailureThreshold": 3,
        "QuarantineMinutes": 30
      },
      "Rewards": {
        "Enabled": false,
        "PolicyVersion": "atos-reward-policy-v1",
        "AicMinorPerThousandCp": 0,
        "MonthlyBudgetMinor": 0,
        "MaximumPerSettlementMinor": 0
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
