{
  "ConnectionStrings": {
    "AIFarm": ""
  },
  "AIFarm": {
    "Execution": {
      "MaximumPromptCharacters": 12000,
      "MaximumCostPerRequestMinor": 100000,
      "ProviderTimeoutSeconds": 30,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerOpenSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
