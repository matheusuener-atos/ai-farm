# Runtime: use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require&channel_binding=require

# Schema changes: use the direct, unpooled Neon connection string.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&channel_binding=require

NEON_BRANCH=development

# Development may omit this value and use the explicit local-only key.
# Production requires a random Base64 value containing at least 32 bytes.
AIFarm__Farm__ManifestSigningKey=replace-with-base64-256-bit-secret

# Retired signing keys from rotations (comma-separated Base64 values).
# Keep every retired key while sealed history still needs revalidation (ADR 0025).
AIFarm__Farm__RetiredManifestSigningKeys=

# Real provider: "OpenAI" (Responses API), "OpenAICompatible" (any
# chat-completions endpoint: OpenRouter/Groq/DeepSeek/GLM/Ollama) or "Fake".
AIFarm__AI__Provider=Fake
OPENAI_API_KEY=replace-with-openai-api-key

# OpenAICompatible example — free Chinese model via OpenRouter (ADR 0032):
# AIFarm__AI__Provider=OpenAICompatible
# AIFarm__AI__Compatible__Endpoint=https://openrouter.ai/api/v1/chat/completions
# AIFarm__AI__Compatible__Model=z-ai/glm-5.2:free
# AIFarm__AI__Compatible__ProviderLabel=OpenRouter
# COMPATIBLE_API_KEY=replace-with-openrouter-key

# Daily per-account safety cap (mAIC) applied only with the real provider.
AIFarm__AI__DailySafetyCapMinor=50000

# Platform compute pool (ADR 0031): the one account whose demands may run on
# opt-in shared agents from other accounts. Empty = pool disabled.
AIFarm__Farm__PlatformAccountId=

# Neon Object Storage (private, branch-scoped bucket chat-attachments).
AWS_ACCESS_KEY_ID=replace-with-branch-credential
AWS_SECRET_ACCESS_KEY=replace-with-branch-secret
AWS_ENDPOINT_URL_S3=https://storage.example.neon.tech
AWS_REGION=us-east-2
