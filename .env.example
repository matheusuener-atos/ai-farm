# Runtime: use the pooled Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require&channel_binding=require

# Schema changes: use the direct, unpooled Neon connection string.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&channel_binding=require

NEON_BRANCH=development

# Development may omit this value and use the explicit local-only key.
# Production requires a random Base64 value containing at least 32 bytes.
AIFarm__Farm__ManifestSigningKey=replace-with-base64-256-bit-secret

# Neon Object Storage (private, branch-scoped bucket chat-attachments).
AWS_ACCESS_KEY_ID=replace-with-branch-credential
AWS_SECRET_ACCESS_KEY=replace-with-branch-secret
AWS_ENDPOINT_URL_S3=https://storage.example.neon.tech
AWS_REGION=us-east-2
